<Window x:Class="SnapZones.App.Overlays.MonitorOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowActivated="False"
        ShowInTaskbar="False"
        Focusable="False"
        IsHitTestVisible="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        Width="1"
        Height="1"
        Title="Sascha’s Zone Manager Overlay">
    <Canvas x:Name="ZonesCanvas" IsHitTestVisible="False" />
</Window>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <AssemblyName>ZoneManager</AssemblyName>
    <AssemblyTitle>Zone Manager</AssemblyTitle>
    <Product>Zone Manager</Product>
    <RootNamespace>SnapZones.App</RootNamespace>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <StartupObject>SnapZones.App.Program</StartupObject>
    <ApplicationIcon>Assets\ZoneManager.ico</ApplicationIcon>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Das Programm ist einsprachig deutsch. Ohne diese Zeile liefert der Self-contained-Publish
         13 Ordner mit uebersetzten .NET-Framework-Meldungen mit, die nie erscheinen. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
    <RootExecutablePath Condition="'$(RootExecutablePath)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..\ZoneManager.exe'))</RootExecutablePath>
    <RootPublishDirectory>$([System.IO.Path]::GetFullPath('$(BaseIntermediateOutputPath)root-publish\$(Configuration)\win-x64\'))</RootPublishDirectory>
    <HelperProjectPath>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\SnapZones.Helper\SnapZones.Helper.csproj'))</HelperProjectPath>
    <RootPublishScript>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..\scripts\install-root-executable.ps1'))</RootPublishScript>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\ZoneManager.ico" />
    <Resource Include="Assets\ZoneManager.Header.png" />
    <None Update="Assets\ZoneManager.svg" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SnapZones.Core\SnapZones.Core.csproj" />
    <ProjectReference Include="..\SnapZones.Windows\SnapZones.Windows.csproj" />
  </ItemGroup>
  <Target Name="PublishRootExecutableAfterBuild"
          AfterTargets="Build"
          Condition="'$(SkipRootExecutablePublish)' != 'true' and '$(DesignTimeBuild)' != 'true'">
    <MSBuild Projects="$(MSBuildProjectFullPath)"
             Targets="Restore;Publish"
             BuildInParallel="false"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=win-x64;SelfContained=true;PublishDir=$(RootPublishDirectory);SkipRootExecutablePublish=true" />
    <!--
      Der Fensterhelfer wird gleich mitveroeffentlicht und neben die Root-EXE gelegt. Nur so findet ihn
      die Installation; ohne ihn bleibt der Weg ueber uiAccess verschlossen.
    -->
    <MSBuild Projects="$(HelperProjectPath)"
             Targets="Restore;Publish"
             BuildInParallel="false"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=win-x64;PublishDir=$(RootPublishDirectory)" />
    <!--
      Das Skript beendet eine laufende Instanz, tauscht Programmdatei und Fensterhelfer aus und startet
      die Instanz danach neu. Der Helfer wird nicht getrennt kopiert: er darf erst ersetzt werden, wenn
      keine Instanz mehr laeuft, die ihn benutzt.
    -->
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(RootPublishScript)&quot; -PublishedExecutablePath &quot;$(RootPublishDirectory)ZoneManager.exe&quot; -RootExecutablePath &quot;$(RootExecutablePath)&quot;" />
  </Target>
</Project>

<Window x:Class="SnapZones.App.Views.GitHubConnectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SnapZones.App.Controls"
        Title="Mit GitHub verbinden"
        Width="580" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontSize="16">
    <Window.Resources>
        <!-- Die Nummer eines Schritts: gefuellter Kreis, solange der Schritt dran ist. -->
        <Style x:Key="StepNumber" TargetType="Border">
            <Setter Property="Width" Value="22" /><Setter Property="Height" Value="22" />
            <Setter Property="CornerRadius" Value="11" /><Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style x:Key="StepNumberText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" /><Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource AccentInkBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" /><Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>
    <Border Background="{DynamicResource CanvasBrush}" Padding="24">
        <StackPanel>
            <TextBlock Text="Mit GitHub verbinden" Style="{StaticResource SectionTitle}" />
            <TextBlock x:Name="IntroText" Style="{StaticResource HelpText}" Margin="0,8,0,0"
                       Text="Die neuen Fassungen liegen in einem privaten Bereich. Melde dich einmal mit deinem GitHub-Konto an: du bestätigst dazu im Browser einen kurzen Code." />

            <Border x:Name="DeviceSteps" Style="{StaticResource SectionCard}" Margin="0,18,0,0" Padding="20,16">
                <StackPanel>
                    <!-- Schritt 1: der Code, gross und in Monospace, mit einem Knopf zum Kopieren. -->
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource StepNumber}"><TextBlock Text="1" Style="{StaticResource StepNumberText}" /></Border>
                        <TextBlock Grid.Column="1" Text="Diesen Code merken" FontSize="15" VerticalAlignment="Center" Margin="12,0,0,0" />
                        <TextBlock x:Name="UserCodeText" Grid.Column="2" Text="————" FontFamily="Cascadia Mono" FontSize="22" FontWeight="Bold"
                                   VerticalAlignment="Center" HorizontalAlignment="Right" Margin="16,0,12,0"
                                   AutomationProperties.Name="Gerätecode" />
                        <Button x:Name="CopyCodeButton" Grid.Column="3" Content="⧉" Style="{StaticResource ListIconButton}" Click="CopyCode_Click"
                                ToolTip="Code in die Zwischenablage kopieren" AutomationProperties.Name="Gerätecode in die Zwischenablage kopieren" />
                    </Grid>

                    <!-- Schritt 2: die Seite im Browser oeffnen, auf der der Code bestaetigt wird. -->
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource StepNumber}"><TextBlock Text="2" Style="{StaticResource StepNumberText}" /></Border>
                        <TextBlock Grid.Column="1" Text="Im Browser bestätigen" FontSize="15" VerticalAlignment="Center" Margin="12,0,0,0" />
                        <Button x:Name="OpenBrowserButton" Grid.Column="2" Content="{Binding Text, ElementName=VerificationUriText, StringFormat={}{0} öffnen ↗}"
                                Click="OpenBrowser_Click" VerticalAlignment="Center"
                                AutomationProperties.Name="Bestätigungsseite im Browser öffnen" />
                        <TextBlock x:Name="VerificationUriText" Visibility="Collapsed" />
                    </Grid>

                    <!-- Schritt 3: warten, mit Restzeit. -->
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource StepNumber}" Background="Transparent" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1">
                            <TextBlock Text="3" Style="{StaticResource StepNumberText}" Foreground="{DynamicResource MutedBrush}" />
                        </Border>
                        <TextBlock x:Name="StatusText" Grid.Column="1" Style="{StaticResource HelpText}" Margin="12,0,0,0" VerticalAlignment="Center"
                                   AutomationProperties.Name="Stand der Anmeldung" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Ausweichweg, und ohne hinterlegte OAuth-Anwendung der einzige Weg. -->
            <Border x:Name="TokenCard" Style="{StaticResource SectionCard}" Padding="20,16">
                <StackPanel>
                    <TextBlock x:Name="TokenTitleText" Text="Zugriffstoken einfügen" Style="{StaticResource GroupTitle}" />
                    <TextBlock Style="{StaticResource HelpText}"
                               Text="Ein fein abgestuftes persönliches Token genügt; es braucht nur Leserecht auf die Inhalte dieses Repositories. Auf github.com unter Einstellungen → Developer settings → Personal access tokens." />
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBox x:Name="TokenText" AutomationProperties.Name="Zugriffstoken" controls:Chrome.Placeholder="github_pat_…" />
                        <Button x:Name="UseTokenButton" Grid.Column="1" Content="Übernehmen" Style="{StaticResource PrimaryButton}" Click="UseToken_Click" Margin="8,0,0,0"
                                AutomationProperties.Name="Zugriffstoken übernehmen" />
                    </Grid>
                    <TextBlock x:Name="TokenStatusText" Style="{StaticResource HelpText}" AutomationProperties.Name="Stand des Zugriffstokens" />
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource HelpText}"
                       Text="Zone Manager speichert den Zugang in den Windows-Anmeldeinformationen. Er gilt nur für dieses Repository und nur zum Lesen – dein Passwort sieht das Programm nie." />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button x:Name="RetryButton" Content="Neuen Code anfordern" Click="Retry_Click" Visibility="Collapsed"
                        AutomationProperties.Name="Neuen Gerätecode anfordern" />
                <Button x:Name="CloseButton" Content="Abbrechen" Click="Close_Click" Margin="8,0,0,0"
                        AutomationProperties.Name="Dialog schliessen" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>

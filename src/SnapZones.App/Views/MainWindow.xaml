<Window x:Class="SnapZones.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SnapZones.App.Controls"
        xmlns:viewModels="clr-namespace:SnapZones.App.ViewModels"
        Title="Sascha Window Zones"
        Icon="/SaschaWindowZones;component/Assets/SaschaWindowZones.ico"
        Width="1480"
        Height="900"
        MinWidth="1120"
        MinHeight="700"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <viewModels:EnumDisplayConverter x:Key="EnumDisplayConverter" />
        <DataTemplate x:Key="EnumItemTemplate">
            <TextBlock Text="{Binding Converter={StaticResource EnumDisplayConverter}}" />
        </DataTemplate>
        <DataTemplate x:Key="MonitorItemTemplate">
            <StackPanel MinWidth="210">
                <TextBlock Text="{Binding FriendlyName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding ResolutionText}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{DynamicResource CanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="76" />
            <RowDefinition Height="*" />
            <RowDefinition Height="36" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="22,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Width="38" Height="38" Source="/SaschaWindowZones;component/Assets/SaschaWindowZones.ico" VerticalAlignment="Center" />
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="SASCHA WINDOW ZONES" FontFamily="Segoe UI Variable Display" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="Flexible window layouts for every screen" Foreground="{DynamicResource MutedBrush}" FontSize="12" />
                </StackPanel>
                <ComboBox Grid.Column="4" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Name" VerticalAlignment="Center" AutomationProperties.Name="Aktives Profil" />
                <Border Grid.Column="6" x:Name="SafetyBadge" Background="{DynamicResource WarningSoftBrush}" CornerRadius="4" Padding="12,7" Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock x:Name="SafetyStatus" Text="Snap-Funktion aus" Foreground="{DynamicResource WarningBrush}" FontWeight="SemiBold" />
                </Border>
                <Button Grid.Column="7" Content="Speichern" Style="{StaticResource PrimaryButton}" Click="Save_Click" VerticalAlignment="Center" Margin="0" AutomationProperties.Name="Änderungen speichern" />
            </Grid>
        </Border>

        <TabControl Grid.Row="1" Margin="18,12,18,8">
            <TabItem Header="Profile">
                <Grid Margin="48,32" MaxWidth="860" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition Width="36" />
                        <ColumnDefinition Width="420" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Profile" FontFamily="Segoe UI Variable Display" FontSize="26" FontWeight="SemiBold" />
                        <TextBlock Text="Ein Profil ist die oberste Ebene und enthält für jeden angeschlossenen Monitor ein eigenes Layout." Style="{StaticResource HelpText}" Margin="0,6,0,20" />
                        <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Name" MinHeight="280" />
                    </StackPanel>
                    <Border Grid.Column="2" Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Text="Ausgewähltes Profil" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Profilname" Style="{StaticResource FieldLabel}" Margin="0,18,0,5" />
                            <TextBox x:Name="ProfileNameText" Text="{Binding SelectedProfile.Name}" />
                            <TextBlock Text="Der Name erscheint im Kopfbereich, im Infobereich und beim schnellen Profilwechsel." Style="{StaticResource HelpText}" />
                            <Button Content="Name speichern" Click="RenameProfile_Click" Style="{StaticResource PrimaryButton}" Margin="0,18,0,8" />
                            <Button Content="Neues Profil" Click="AddProfile_Click" Margin="0,0,0,8" />
                            <Button Content="Profil löschen" Click="DeleteProfile_Click" Margin="0,0,0,8" />
                            <TextBlock Text="Schnellwahl: Ctrl + Alt + 1–9. Der Schnellwahlplatz wird aus der Profilreihenfolge abgeleitet." Style="{StaticResource HelpText}" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Layouts">
                <Grid Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="340" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Row="0" Grid.Column="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                        <DockPanel>
                            <Button Content="+ Neue Zone" Click="AddZone_Click" Style="{StaticResource PrimaryButton}" Margin="0" DockPanel.Dock="Left" AutomationProperties.Name="Neue Zone hinzufügen" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="2 Spalten" Tag="TwoColumns" Click="Template_Click" Margin="0,0,6,0" />
                                <Button Content="3 Spalten" Tag="ThreeColumns" Click="Template_Click" Margin="0,0,6,0" />
                                <Button Content="Haupt + Seite" Tag="MainAndSide" Click="Template_Click" Margin="0,0,6,0" />
                                <Button Content="2 × 2" Tag="Grid2x2" Click="Template_Click" Margin="0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Style="{StaticResource SectionCard}" Margin="0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Monitore" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                            <TextBlock DockPanel.Dock="Top" Text="Das Layout des gewählten Monitors wird bearbeitet. Name und Auflösung stammen aus dem aktiven Windows-Displaypfad." Style="{StaticResource HelpText}" Margin="0,0,0,14" />
                            <ListBox ItemsSource="{Binding Monitors}" SelectedItem="{Binding SelectedMonitor}" ItemTemplate="{StaticResource MonitorItemTemplate}" SelectionChanged="Monitor_SelectionChanged" AutomationProperties.Name="Monitore" />
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="58" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Margin="18,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="MonitorTitle" Text="Monitor" FontFamily="Segoe UI Variable Display" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Ziehen, skalieren oder exakt eingeben · Alt löst Magnetismus" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                            </Grid>
                            <controls:LayoutCanvas Grid.Row="1" x:Name="EditorCanvas" MinHeight="390" ZoneSelected="EditorCanvas_ZoneSelected" ZoneChanged="EditorCanvas_ZoneChanged" AutomationProperties.Name="Layout-Editor" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="4" Style="{StaticResource SectionCard}" Margin="0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Ausgewählte Zone" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Name" Style="{StaticResource FieldLabel}" Margin="0,16,0,5" />
                                <TextBox x:Name="ZoneNameText" AutomationProperties.Name="Zonenname" />

                                <TextBlock Text="Einheit" Style="{StaticResource FieldLabel}" Margin="0,14,0,5" />
                                <ComboBox x:Name="ZoneUnitCombo" SelectionChanged="ZoneInputMode_Changed" SelectedIndex="0">
                                    <ComboBoxItem Content="Prozent" Tag="Percent" />
                                    <ComboBoxItem Content="Pixel" Tag="Pixels" />
                                </ComboBox>
                                <TextBlock Text="Prozent bleibt bei Auflösungswechseln proportional. Pixel bezieht sich auf die aktuell angezeigte Windows-Arbeitsfläche." Style="{StaticResource HelpText}" />

                                <TextBlock Text="Definition" Style="{StaticResource FieldLabel}" Margin="0,14,0,5" />
                                <ComboBox x:Name="ZoneDefinitionCombo" SelectionChanged="ZoneInputMode_Changed" SelectedIndex="0">
                                    <ComboBoxItem Content="Position und Grösse" Tag="PositionAndSize" />
                                    <ComboBoxItem Content="Aussenabstände" Tag="Margins" />
                                </ComboBox>
                                <TextBlock Text="Position und Grösse verwendet Links, Oben, Breite und Höhe. Aussenabstände verwendet Links, Oben, Rechts und Unten." Style="{StaticResource HelpText}" />

                                <UniformGrid Columns="2" Margin="0,14,0,0">
                                    <StackPanel Margin="0,0,6,0">
                                        <TextBlock Text="Links" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="ZoneLeftText" FontFamily="Cascadia Mono" />
                                    </StackPanel>
                                    <StackPanel Margin="6,0,0,0">
                                        <TextBlock Text="Oben" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="ZoneTopText" FontFamily="Cascadia Mono" />
                                    </StackPanel>
                                    <StackPanel Margin="0,12,6,0">
                                        <TextBlock Text="Rechts" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="ZoneRightText" FontFamily="Cascadia Mono" />
                                    </StackPanel>
                                    <StackPanel Margin="6,12,0,0">
                                        <TextBlock Text="Unten" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="ZoneBottomText" FontFamily="Cascadia Mono" />
                                    </StackPanel>
                                    <StackPanel Margin="0,12,6,0">
                                        <TextBlock Text="Breite" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="ZoneWidthText" FontFamily="Cascadia Mono" />
                                    </StackPanel>
                                    <StackPanel Margin="6,12,0,0">
                                        <TextBlock Text="Höhe" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="ZoneHeightText" FontFamily="Cascadia Mono" />
                                    </StackPanel>
                                </UniformGrid>
                                <Button Content="Werte anwenden" Click="ApplyZoneValues_Click" Style="{StaticResource PrimaryButton}" Margin="0,18,0,8" />
                                <Button Content="Zone löschen" Click="DeleteZone_Click" Margin="0,0,0,8" />
                                <Button Content="Entwurf zurücksetzen" Click="ResetLayout_Click" Margin="0,0,0,8" />
                                <TextBlock x:Name="ValidationText" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Windows-Anzeige">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="48,30" MaxWidth="900" HorizontalAlignment="Left">
                        <TextBlock Text="Windows-Anzeige" FontFamily="Segoe UI Variable Display" FontSize="26" FontWeight="SemiBold" />
                        <TextBlock Text="Diese Seite zeigt den gewählten Monitor und führt zu den unterstützten Windows-Einstellungen. Sascha Window Zones verändert keine privaten Explorer- oder DPI-Strukturen." Style="{StaticResource HelpText}" Margin="0,6,0,20" />
                        <TextBlock Text="Monitor" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding Monitors}" SelectedItem="{Binding SelectedMonitor}" ItemTemplate="{StaticResource MonitorItemTemplate}" Margin="0,0,0,16" />

                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="Anzeige skalieren" Style="{StaticResource SectionTitle}" />
                                <TextBlock x:Name="WindowsScaleText" Text="Erkannter Wert" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,0" />
                                <TextBlock Text="Die normale Windows-Skalierung ist monitorbezogen, verwendet aber nur die von Windows und dem Grafiktreiber angebotenen Werte. Die freie benutzerdefinierte Skalierung von 100 bis 500 % gilt dagegen systemweit und kann eine Abmeldung erfordern." Style="{StaticResource HelpText}" />
                                <Button Content="Windows-Anzeigeeinstellungen öffnen" Tag="ms-settings:display" Click="OpenSystemSetting_Click" Margin="0,14,0,0" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="Textgrösse" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Windows bietet 100 bis 225 %, wendet diesen Wert aber global auf alle Monitore an. Eine freie monitorweise Textskalierung kann eine normale Desktopanwendung nicht sicher setzen." Style="{StaticResource HelpText}" />
                                <Button Content="Windows-Textgrösse öffnen" Tag="ms-settings:easeofaccess-textsize" Click="OpenSystemSetting_Click" Margin="0,14,0,0" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="Taskleiste und Symbole" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Windows 11 stellt keine unterstützte freie oder monitorweise Schnittstelle für Taskleistenhöhe und Symbolgrösse bereit. Drittprogramme erreichen dies durch Explorer-Injektion oder private Registry-Werte; diese instabilen Eingriffe werden bewusst nicht verwendet." Style="{StaticResource HelpText}" />
                                <Button Content="Windows-Taskleisteneinstellungen öffnen" Tag="ms-settings:taskbar" Click="OpenSystemSetting_Click" Margin="0,14,0,0" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Einstellungen">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="48,30" MaxWidth="900" HorizontalAlignment="Left">
                        <TextBlock Text="Einstellungen" FontFamily="Segoe UI Variable Display" FontSize="26" FontWeight="SemiBold" />
                        <TextBlock Text="Alle Änderungen werden erst mit «Speichern» dauerhaft und für die Snap-Engine wirksam. Die Theme-Vorschau reagiert sofort." Style="{StaticResource HelpText}" Margin="0,6,0,20" />

                        <Border Background="{DynamicResource WarningSoftBrush}" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1" CornerRadius="6" Padding="18" Margin="0,0,0,14">
                            <StackPanel>
                                <CheckBox Content="Snap-Funktion aktivieren" IsChecked="{Binding Settings.SnappingEnabled}" Checked="SafetySetting_Changed" Unchecked="SafetySetting_Changed" FontWeight="SemiBold" />
                                <TextBlock Text="Nach dem Speichern beobachtet die Anwendung dokumentierte Windows-Verschiebeereignisse. Not-Aus: Ctrl + Alt + Shift + F12; Escape beendet nur den aktuellen Ziehvorgang." Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Margin="24,6,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="Programm" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Theme" Style="{StaticResource FieldLabel}" Margin="0,16,0,5" />
                                <ComboBox ItemsSource="{Binding Settings.ThemeModes}" SelectedItem="{Binding Settings.ThemeMode}" ItemTemplate="{StaticResource EnumItemTemplate}" SelectionChanged="Theme_SelectionChanged" Width="300" HorizontalAlignment="Left" />
                                <TextBlock Text="Windows-System folgt automatisch dem App-Modus von Windows. Hell und Dunkel überschreiben diese Auswahl nur für Sascha Window Zones." Style="{StaticResource HelpText}" />
                                <CheckBox Content="Mit Windows starten" IsChecked="{Binding Settings.StartWithWindows}" Margin="0,18,0,0" />
                                <TextBlock Text="Erstellt nach dem Speichern einen Autostarteintrag für den aktuellen Benutzer. Es werden keine Administratorrechte und kein Windows-Dienst verwendet." Style="{StaticResource HelpText}" Margin="24,5,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="Ziehen und Overlay" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Overlays anzeigen" Style="{StaticResource FieldLabel}" Margin="0,16,0,5" />
                                <ComboBox ItemsSource="{Binding Settings.OverlayScopes}" SelectedItem="{Binding Settings.OverlayScope}" ItemTemplate="{StaticResource EnumItemTemplate}" Width="300" HorizontalAlignment="Left" />
                                <TextBlock Text="«Alle Monitore» zeigt jede aktive Monitorfläche; «Aktiver Monitor» zeigt nur die Fläche unter dem Mauszeiger." Style="{StaticResource HelpText}" />
                                <TextBlock Text="Aktivierung" Style="{StaticResource FieldLabel}" Margin="0,16,0,5" />
                                <ComboBox ItemsSource="{Binding Settings.TriggerModes}" SelectedItem="{Binding Settings.TriggerMode}" ItemTemplate="{StaticResource EnumItemTemplate}" Width="300" HorizontalAlignment="Left" />
                                <TextBlock Text="Sofort zeigt Zonen bei jedem geeigneten Titelleisten-Ziehen. Die Umschalttaste begrenzt die Aktivierung auf bewusst ausgelöste Vorgänge." Style="{StaticResource HelpText}" />
                                <CheckBox Content="Zonennamen im Overlay anzeigen" IsChecked="{Binding Settings.ShowZoneNames}" Margin="0,18,0,0" />
                                <TextBlock Text="Blendet den Namen jeder Zone während des Ziehens ein. Die Zielkontur bleibt auch ohne Namen sichtbar." Style="{StaticResource HelpText}" Margin="24,5,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="Abstände und Andocken" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Äussere Abstände in Pixel" Style="{StaticResource FieldLabel}" Margin="0,16,0,5" />
                                <UniformGrid Columns="4">
                                    <StackPanel Margin="0,0,8,0"><TextBlock Text="Links" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding Settings.OuterMarginLeft, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                    <StackPanel Margin="0,0,8,0"><TextBlock Text="Oben" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding Settings.OuterMarginTop, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                    <StackPanel Margin="0,0,8,0"><TextBlock Text="Rechts" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding Settings.OuterMarginRight, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                    <StackPanel><TextBlock Text="Unten" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding Settings.OuterMarginBottom, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                </UniformGrid>
                                <TextBlock Text="Reserviert getrennt an jeder Seite Platz innerhalb der Windows-Arbeitsfläche. Gültiger Bereich: 0 bis 400 Pixel; die Taskleiste ist bereits aus der Arbeitsfläche ausgeschlossen." Style="{StaticResource HelpText}" />
                                <TextBlock Text="Zonenabstand in Pixel" Style="{StaticResource FieldLabel}" Margin="0,16,0,5" />
                                <Slider Minimum="0" Maximum="80" Value="{Binding Settings.ZoneGap}" TickFrequency="1" IsSnapToTickEnabled="True" />
                                <TextBlock Text="Verteilt den Abstand gleichmässig zwischen benachbarten Zonen. 0 erzeugt ohne Rundungsreserve direkt aneinanderliegende Fenster." Style="{StaticResource HelpText}" />
                                <TextBlock Text="Magnetdistanz in Pixel" Style="{StaticResource FieldLabel}" Margin="0,16,0,5" />
                                <Slider Minimum="0" Maximum="40" Value="{Binding Settings.MagnetThresholdPixels}" TickFrequency="1" IsSnapToTickEnabled="True" />
                                <TextBlock Text="Kanten innerhalb dieser Distanz docken im Editor an Monitor- oder Zonenkanten an. 0 deaktiviert das Andocken; Alt schaltet es während eines Ziehvorgangs vorübergehend aus." Style="{StaticResource HelpText}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="Overlay-Darstellung" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Farbe" Style="{StaticResource FieldLabel}" Margin="0,16,0,5" />
                                <TextBox Text="{Binding Settings.OverlayColor}" Width="180" HorizontalAlignment="Left" FontFamily="Cascadia Mono" />
                                <TextBlock Text="Hexadezimale RGB-Farbe im Format #RRGGBB. Sie bestimmt Füllung, Kontur und aktive Zielzone." Style="{StaticResource HelpText}" />
                                <TextBlock Text="Deckkraft in Prozent" Style="{StaticResource FieldLabel}" Margin="0,16,0,5" />
                                <Slider Minimum="8" Maximum="75" Value="{Binding Settings.OverlayOpacityPercent}" TickFrequency="1" />
                                <TextBlock Text="8 % bleibt sehr fein; 75 % hebt Zonen stark hervor. Die aktive Zielzone wird zusätzlich verstärkt." Style="{StaticResource HelpText}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource MutedBrush}" Margin="22,0" VerticalAlignment="Center" />
        </Border>
    </Grid>
</Window>

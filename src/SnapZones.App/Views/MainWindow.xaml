<Window x:Class="SnapZones.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SnapZones.App.Controls"
        Title="SnapZones"
        Width="1260"
        Height="800"
        MinWidth="980"
        MinHeight="640"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="*" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="22,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="SNAPZONES" FontFamily="Segoe UI Variable Display" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="Fensterflächen für deinen Desktop" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                </StackPanel>
                <ComboBox Grid.Column="2" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Name" VerticalAlignment="Center" AutomationProperties.Name="Aktives Profil" />
                <Border Grid.Column="4" x:Name="SafetyBadge" Background="{StaticResource WarningSoftBrush}" CornerRadius="4" Padding="12,7" Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock x:Name="SafetyStatus" Text="Snap-Funktion aus" Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold" />
                </Border>
                <Button Grid.Column="5" Content="Speichern" Style="{StaticResource PrimaryButton}" Click="Save_Click" VerticalAlignment="Center" Margin="0" AutomationProperties.Name="Änderungen speichern" />
            </Grid>
        </Border>

        <TabControl Grid.Row="1" Margin="18,12,18,8">
            <TabItem Header="Layouts">
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="276" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="14">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
                                <TextBlock Text="Vorlagen" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <UniformGrid Columns="2">
                                    <Button Content="2 Spalten" Tag="TwoColumns" Click="Template_Click" />
                                    <Button Content="3 Spalten" Tag="ThreeColumns" Click="Template_Click" />
                                    <Button Content="Haupt + Seite" Tag="MainAndSide" Click="Template_Click" />
                                    <Button Content="2 × 2" Tag="Grid2x2" Click="Template_Click" />
                                </UniformGrid>
                                <Button Content="+ Zone" Click="AddZone_Click" AutomationProperties.Name="Zone hinzufügen" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Monitore" FontFamily="Segoe UI Variable Display" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <ListBox ItemsSource="{Binding Monitors}" SelectedItem="{Binding SelectedMonitor}" DisplayMemberPath="DisplayName" SelectionChanged="Monitor_SelectionChanged" AutomationProperties.Name="Monitore" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="52" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <DockPanel Margin="16,0" VerticalAlignment="Center">
                                <TextBlock x:Name="MonitorTitle" Text="Monitor" FontFamily="Segoe UI Variable Display" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock Text="Zonen ziehen oder an den Griffen skalieren" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" />
                            </DockPanel>
                            <controls:LayoutCanvas Grid.Row="1" x:Name="EditorCanvas" MinHeight="360" ZoneSelected="EditorCanvas_ZoneSelected" ZoneChanged="EditorCanvas_ZoneChanged" AutomationProperties.Name="Layout-Editor" />
                        </Grid>
                    </Border>

                    <Border Grid.Column="4" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Ausgewählte Zone" FontFamily="Segoe UI Variable Display" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Text="Name" Foreground="{StaticResource MutedBrush}" Margin="0,16,0,5" />
                            <TextBox x:Name="ZoneNameText" AutomationProperties.Name="Zonenname" />
                            <UniformGrid Columns="2" Margin="0,12,0,0">
                                <StackPanel Margin="0,0,6,0">
                                    <TextBlock Text="X in %" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,5" />
                                    <TextBox x:Name="ZoneXText" FontFamily="Cascadia Mono" />
                                </StackPanel>
                                <StackPanel Margin="6,0,0,0">
                                    <TextBlock Text="Y in %" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,5" />
                                    <TextBox x:Name="ZoneYText" FontFamily="Cascadia Mono" />
                                </StackPanel>
                                <StackPanel Margin="0,12,6,0">
                                    <TextBlock Text="Breite in %" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,5" />
                                    <TextBox x:Name="ZoneWidthText" FontFamily="Cascadia Mono" />
                                </StackPanel>
                                <StackPanel Margin="6,12,0,0">
                                    <TextBlock Text="Höhe in %" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,5" />
                                    <TextBox x:Name="ZoneHeightText" FontFamily="Cascadia Mono" />
                                </StackPanel>
                            </UniformGrid>
                            <Button Content="Werte anwenden" Click="ApplyZoneValues_Click" Style="{StaticResource PrimaryButton}" Margin="0,16,0,8" />
                            <Button Content="Zone löschen" Click="DeleteZone_Click" Margin="0,0,0,8" />
                            <Button Content="Entwurf zurücksetzen" Click="ResetLayout_Click" Margin="0,0,0,8" />
                            <TextBlock x:Name="ValidationText" Foreground="#C63636" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Profile">
                <Grid Margin="48,32" MaxWidth="760" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="360" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Profile" FontFamily="Segoe UI Variable Display" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock Text="Ein Profil enthält eigene Zonen für jeden Monitor." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,18" />
                        <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Name" MinHeight="240" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,50,0,0">
                        <TextBlock Text="Profilname" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,5" />
                        <TextBox x:Name="ProfileNameText" Text="{Binding SelectedProfile.Name}" />
                        <Button Content="Name speichern" Click="RenameProfile_Click" Style="{StaticResource PrimaryButton}" Margin="0,12,0,8" />
                        <Button Content="Neues Profil" Click="AddProfile_Click" Margin="0,0,0,8" />
                        <Button Content="Profil löschen" Click="DeleteProfile_Click" Margin="0,0,0,8" />
                        <TextBlock Text="Schnellwahl: Ctrl + Alt + 1–9; die Zuordnung folgt in den Profileinstellungen des nächsten Ausbaus." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,12,0,0" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Einstellungen">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="48,32" MaxWidth="720" HorizontalAlignment="Left">
                        <TextBlock Text="Einstellungen" FontFamily="Segoe UI Variable Display" FontSize="24" FontWeight="SemiBold" />
                        <Border Background="{StaticResource WarningSoftBrush}" BorderBrush="#E5C27C" BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,18,0,22">
                            <StackPanel>
                                <CheckBox Content="Snap-Funktion aktivieren" IsChecked="{Binding Settings.SnappingEnabled}" Checked="SafetySetting_Changed" Unchecked="SafetySetting_Changed" FontWeight="SemiBold" />
                                <TextBlock Text="Erst nach «Speichern» werden Fenster-Verschiebeereignisse beobachtet. Not-Aus: Ctrl + Alt + Shift + F12." Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" Margin="24,6,0,0" />
                            </StackPanel>
                        </Border>
                        <CheckBox Content="Mit Windows starten" IsChecked="{Binding Settings.StartWithWindows}" Margin="0,0,0,18" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="280" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Overlays anzeigen" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding Settings.OverlayScopes}" SelectedItem="{Binding Settings.OverlayScope}" />
                            <TextBlock Grid.Row="1" Text="Aktivierung" VerticalAlignment="Center" Margin="0,14,0,0" />
                            <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Settings.TriggerModes}" SelectedItem="{Binding Settings.TriggerMode}" Margin="0,14,0,0" />
                        </Grid>
                        <TextBlock Text="Aussenrand" Margin="0,24,0,5" />
                        <Slider Minimum="0" Maximum="80" Value="{Binding Settings.OuterMargin}" TickFrequency="4" IsSnapToTickEnabled="True" />
                        <TextBlock Text="Zonenabstand" Margin="0,18,0,5" />
                        <Slider Minimum="0" Maximum="80" Value="{Binding Settings.ZoneGap}" TickFrequency="4" IsSnapToTickEnabled="True" />
                        <TextBlock Text="Overlay-Deckkraft" Margin="0,18,0,5" />
                        <Slider Minimum="8" Maximum="75" Value="{Binding Settings.OverlayOpacityPercent}" TickFrequency="1" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource MutedBrush}" Margin="22,0" VerticalAlignment="Center" />
        </Border>
    </Grid>
</Window>

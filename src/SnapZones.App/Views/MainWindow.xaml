<Window x:Class="SnapZones.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SnapZones.App.Controls"
        xmlns:viewModels="clr-namespace:SnapZones.App.ViewModels"
        Title="Sascha Window Zones"
        Width="1480" Height="900" MinWidth="1180" MinHeight="720"
        FontSize="15"
        WindowStartupLocation="CenterScreen">
    <Window.Icon>
        <BitmapImage UriSource="/SaschaWindowZones;component/Assets/SaschaWindowZones.ico" DecodePixelWidth="64" />
    </Window.Icon>
    <Window.Resources>
        <viewModels:EnumDisplayConverter x:Key="EnumDisplayConverter" />
        <DataTemplate x:Key="EnumItemTemplate">
            <TextBlock Text="{Binding Converter={StaticResource EnumDisplayConverter}}" />
        </DataTemplate>
        <DataTemplate x:Key="MonitorItemTemplate">
            <StackPanel MinWidth="190">
                <TextBlock Text="{Binding FriendlyName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding ResolutionText}" Foreground="{DynamicResource MutedBrush}" FontSize="13" Margin="0,3,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{DynamicResource CanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="*" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="14" /><ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="36" /><ColumnDefinition Width="260" /><ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Width="36" Height="36" Source="/SaschaWindowZones;component/Assets/SaschaWindowZones.Header.png"
                       RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" VerticalAlignment="Center" />
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="Sascha Window Zones" FontFamily="Segoe UI Variable Display" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="Fensterbereiche pro Monitor" Foreground="{DynamicResource MutedBrush}" FontSize="13" />
                </StackPanel>
                <ComboBox Grid.Column="4" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Name"
                          VerticalAlignment="Center" AutomationProperties.Name="Aktives Profil" />
                <Border Grid.Column="6" x:Name="SafetyBadge" Background="{DynamicResource WarningSoftBrush}" CornerRadius="5"
                        Padding="12,7" Margin="0,0,10,0" VerticalAlignment="Center">
                    <TextBlock x:Name="SafetyStatus" Text="Snap-Funktion aus" Foreground="{DynamicResource WarningBrush}" FontWeight="SemiBold" />
                </Border>
                <TextBlock x:Name="PersistenceStatusText" Grid.Column="7" Text="{Binding StatusMessage}"
                           Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0"
                           MinWidth="150" TextAlignment="Right" TextTrimming="CharacterEllipsis"
                           AutomationProperties.Name="Speicherstatus" />
            </Grid>
        </Border>

        <TabControl Grid.Row="1" Margin="0" TabStripPlacement="Left">
            <TabItem Header="Profile">
                <Grid Margin="38,30" MaxWidth="940" HorizontalAlignment="Left">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="22" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Profile" Style="{StaticResource PageTitle}" />
                        <Button x:Name="ProfileInfoButton" Style="{StaticResource InfoButton}" VerticalAlignment="Center"
                                AutomationProperties.Name="Hilfe zu Profilen"
                                ToolTip="Ein Profil bündelt die Fensterbereiche aller angeschlossenen Monitore. Über die Profilauswahl im Kopf wechselst du zwischen unterschiedlichen Arbeitsumgebungen." />
                    </StackPanel>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="340" /><ColumnDefinition Width="18" /><ColumnDefinition Width="440" /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource SectionCard}" Margin="0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Vorhandene Profile" Style="{StaticResource SectionTitle}" Margin="0,0,0,14" />
                                <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Name" MinHeight="300" />
                            </DockPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource SectionCard}" Margin="0">
                            <StackPanel>
                                <TextBlock Text="Ausgewähltes Profil" Style="{StaticResource SectionTitle}" />
                                <StackPanel Orientation="Horizontal" Margin="0,18,0,5">
                                    <TextBlock Text="Profilname" Style="{StaticResource FieldLabel}" Margin="0" VerticalAlignment="Center" />
                                    <Button Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zum Profilnamen"
                                            ToolTip="Der Name wird in der Profilauswahl und im Infobereich verwendet. Kurze, eindeutige Namen wie Arbeit, Gaming oder Präsentation sind am leichtesten erkennbar." />
                                </StackPanel>
                                <TextBox x:Name="ProfileNameText" Text="{Binding SelectedProfile.Name}" LostFocus="ProfileName_LostFocus" />
                                <Button Content="Neues Profil" Click="AddProfile_Click" Margin="0,18,0,8" />
                                <Button Content="Profil löschen" Click="DeleteProfile_Click" Margin="0,0,0,8" />
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <TextBlock Text="Schnellwahl: Ctrl + Alt + 1–9" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                                    <Button Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zur Profilschnellwahl"
                                            ToolTip="Die Zahl entspricht der Reihenfolge in der Profilliste. Mit Ctrl + Alt und dieser Zahl wechselst du das Profil, ohne das Programm zuerst öffnen zu müssen." />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Layouts">
                <Grid Margin="12,18,12,16">
                    <Grid.RowDefinitions><RowDefinition Height="56" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="340" />
                            <ColumnDefinition Width="12" /><ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                            <TextBlock Text="Layouts" Style="{StaticResource PageTitle}" />
                            <Button Style="{StaticResource InfoButton}" VerticalAlignment="Center" AutomationProperties.Name="Hilfe zu Layouts"
                                    ToolTip="Ein Layout legt für den gewählten Monitor fest, wo Fenster abgelegt werden. Du kannst Zonen direkt in der Vorschau verschieben und skalieren oder ihre Werte rechts exakt eingeben." />
                        </StackPanel>
                        <ComboBox Grid.Column="2" x:Name="LayoutMonitorSelector" ItemsSource="{Binding Monitors}"
                                  SelectedItem="{Binding SelectedMonitor}" ItemTemplate="{StaticResource MonitorItemTemplate}"
                                  SelectionChanged="Monitor_SelectionChanged" VerticalAlignment="Top"
                                  AutomationProperties.Name="Monitor für Layout wählen"
                                  ToolTip="Wähle den Monitor, dessen Zonen du bearbeiten möchtest." />
                        <Button Grid.Column="4" Content="+ Neue Zone" Click="AddZone_Click" Style="{StaticResource PrimaryButton}"
                                Margin="0" VerticalAlignment="Top" AutomationProperties.Name="Neue Zone hinzufügen" />
                    </Grid>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="320" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" x:Name="LayoutEditorArea">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="26" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding SelectedMonitor.ResolutionText, StringFormat=Vorschläge für {0}}"
                                                   Style="{StaticResource FieldLabel}" Margin="4,0,8,0" VerticalAlignment="Center" />
                                        <Button Style="{StaticResource InfoButton}" Margin="0" AutomationProperties.Name="Hilfe zu Layoutvorlagen"
                                                ToolTip="Die Vorschläge berücksichtigen Seitenverhältnis, Auflösung, Windows-Skalierung und – falls Windows sie liefert – die physische Monitorgrösse. Zu kleine Zonen werden nicht angeboten." />
                                    </StackPanel>
                                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                                  PanningMode="HorizontalOnly" CanContentScroll="False">
                                        <ItemsControl x:Name="TemplateSuggestions" ItemsSource="{Binding SelectedMonitor.LayoutSuggestions}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Click="Template_Click" Width="160" Height="108" Margin="0,0,10,8" Padding="8,6"
                                                            ToolTip="{Binding Description}" AutomationProperties.Name="{Binding AccessibilityName}"
                                                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="52" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>
                                                            <controls:LayoutTemplatePreview Suggestion="{Binding}" Margin="4,0,4,4" />
                                                            <TextBlock Grid.Row="1" Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                                                       TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" />
                                                            <TextBlock Grid.Row="2" Text="{Binding Description}" Foreground="{DynamicResource MutedBrush}"
                                                                       FontSize="10.5" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                                       Margin="0,2,0,0" HorizontalAlignment="Center" />
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                            <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="54" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                    <Grid Margin="18,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock x:Name="MonitorTitle" Text="Monitor" FontFamily="Segoe UI Variable Display" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Style="{StaticResource InfoButton}" VerticalAlignment="Center" AutomationProperties.Name="Hilfe zur Layoutbearbeitung"
                                                ToolTip="Ziehe eine Zone, um sie zu verschieben. Ziehe an ihren Rändern oder Ecken, um sie zu skalieren. Mit Alt löst du das automatische Andocken während des Ziehens vorübergehend." />
                                    </Grid>
                                    <controls:LayoutCanvas Grid.Row="1" x:Name="EditorCanvas" MinHeight="390" ZoneSelected="EditorCanvas_ZoneSelected"
                                                           ZoneChanged="EditorCanvas_ZoneChanged" AutomationProperties.Name="Layout-Editor" />
                                </Grid>
                            </Border>
                        </Grid>
                        <Border Grid.Column="2" Style="{StaticResource SectionCard}" Margin="0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="Ausgewählte Zone" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="Name" Style="{StaticResource FieldLabel}" Margin="0,16,0,5" />
                                    <TextBox x:Name="ZoneNameText" AutomationProperties.Name="Zonenname" />
                                    <Border x:Name="ZonePositionGroupBorder" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                                            CornerRadius="6" Padding="12" Margin="0,14,0,0">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                <TextBlock Text="Position und Grösse" Style="{StaticResource FieldLabel}" Margin="0" VerticalAlignment="Center" />
                                                <Button x:Name="ZonePositionInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zu Position und Grösse"
                                                        ToolTip="X und Y bestimmen die linke obere Fensterecke. Breite und Höhe bestimmen die Fenstergrösse. Klicke direkt auf % oder px, um nur diesen Wert umzuschalten." />
                                            </StackPanel>
                                            <UniformGrid Columns="2">
                                                <StackPanel Margin="0,0,6,0">
                                                    <TextBlock Text="X · von links" Style="{StaticResource FieldLabel}" />
                                                    <Grid>
                                                        <TextBox x:Name="ZonePositionXText" Tag="PositionAndSize" Padding="10,7,48,7" FontFamily="Cascadia Mono"
                                                                 AutomationProperties.Name="X-Position" GotKeyboardFocus="ZoneField_GotKeyboardFocus" KeyDown="ZoneField_KeyDown" />
                                                        <Button x:Name="ZonePositionXUnitButton" Tag="PositionX" Content="%" Click="ZoneUnitButton_Click"
                                                                Style="{StaticResource UnitToggleButton}" AutomationProperties.Name="Einheit für X-Position: Prozent" />
                                                    </Grid>
                                                </StackPanel>
                                                <StackPanel Margin="6,0,0,0">
                                                    <TextBlock Text="Y · von oben" Style="{StaticResource FieldLabel}" />
                                                    <Grid>
                                                        <TextBox x:Name="ZonePositionYText" Tag="PositionAndSize" Padding="10,7,48,7" FontFamily="Cascadia Mono"
                                                                 AutomationProperties.Name="Y-Position" GotKeyboardFocus="ZoneField_GotKeyboardFocus" KeyDown="ZoneField_KeyDown" />
                                                        <Button x:Name="ZonePositionYUnitButton" Tag="PositionY" Content="%" Click="ZoneUnitButton_Click"
                                                                Style="{StaticResource UnitToggleButton}" AutomationProperties.Name="Einheit für Y-Position: Prozent" />
                                                    </Grid>
                                                </StackPanel>
                                                <StackPanel Margin="0,12,6,0">
                                                    <TextBlock Text="Breite" Style="{StaticResource FieldLabel}" />
                                                    <Grid>
                                                        <TextBox x:Name="ZoneWidthText" Tag="PositionAndSize" Padding="10,7,48,7" FontFamily="Cascadia Mono"
                                                                 AutomationProperties.Name="Breite" GotKeyboardFocus="ZoneField_GotKeyboardFocus" KeyDown="ZoneField_KeyDown" />
                                                        <Button x:Name="ZoneWidthUnitButton" Tag="Width" Content="%" Click="ZoneUnitButton_Click"
                                                                Style="{StaticResource UnitToggleButton}" AutomationProperties.Name="Einheit für Breite: Prozent" />
                                                    </Grid>
                                                </StackPanel>
                                                <StackPanel Margin="6,12,0,0">
                                                    <TextBlock Text="Höhe" Style="{StaticResource FieldLabel}" />
                                                    <Grid>
                                                        <TextBox x:Name="ZoneHeightText" Tag="PositionAndSize" Padding="10,7,48,7" FontFamily="Cascadia Mono"
                                                                 AutomationProperties.Name="Höhe" GotKeyboardFocus="ZoneField_GotKeyboardFocus" KeyDown="ZoneField_KeyDown" />
                                                        <Button x:Name="ZoneHeightUnitButton" Tag="Height" Content="%" Click="ZoneUnitButton_Click"
                                                                Style="{StaticResource UnitToggleButton}" AutomationProperties.Name="Einheit für Höhe: Prozent" />
                                                    </Grid>
                                                </StackPanel>
                                            </UniformGrid>
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="ZoneMarginsGroupBorder" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                            CornerRadius="6" Padding="12" Margin="0,12,0,0">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                <TextBlock Text="Abstände zum Rand" Style="{StaticResource FieldLabel}" Margin="0" VerticalAlignment="Center" />
                                                <Button x:Name="ZoneMarginsInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zu Randabständen"
                                                        ToolTip="Die vier Werte bestimmen gemeinsam die Abstände des Fensters zu jeder Seite. Klicke direkt auf % oder px, um nur diesen Wert umzuschalten." />
                                            </StackPanel>
                                            <UniformGrid Columns="2">
                                                <StackPanel Margin="0,0,6,0">
                                                    <TextBlock Text="Links" Style="{StaticResource FieldLabel}" />
                                                    <Grid>
                                                        <TextBox x:Name="ZoneMarginLeftText" Tag="Margins" Padding="10,7,48,7" FontFamily="Cascadia Mono"
                                                                 AutomationProperties.Name="Abstand links" GotKeyboardFocus="ZoneField_GotKeyboardFocus" KeyDown="ZoneField_KeyDown" />
                                                        <Button x:Name="ZoneMarginLeftUnitButton" Tag="MarginLeft" Content="%" Click="ZoneUnitButton_Click"
                                                                Style="{StaticResource UnitToggleButton}" AutomationProperties.Name="Einheit für Abstand links: Prozent" />
                                                    </Grid>
                                                </StackPanel>
                                                <StackPanel Margin="6,0,0,0">
                                                    <TextBlock Text="Oben" Style="{StaticResource FieldLabel}" />
                                                    <Grid>
                                                        <TextBox x:Name="ZoneMarginTopText" Tag="Margins" Padding="10,7,48,7" FontFamily="Cascadia Mono"
                                                                 AutomationProperties.Name="Abstand oben" GotKeyboardFocus="ZoneField_GotKeyboardFocus" KeyDown="ZoneField_KeyDown" />
                                                        <Button x:Name="ZoneMarginTopUnitButton" Tag="MarginTop" Content="%" Click="ZoneUnitButton_Click"
                                                                Style="{StaticResource UnitToggleButton}" AutomationProperties.Name="Einheit für Abstand oben: Prozent" />
                                                    </Grid>
                                                </StackPanel>
                                                <StackPanel Margin="0,12,6,0">
                                                    <TextBlock Text="Rechts" Style="{StaticResource FieldLabel}" />
                                                    <Grid>
                                                        <TextBox x:Name="ZoneMarginRightText" Tag="Margins" Padding="10,7,48,7" FontFamily="Cascadia Mono"
                                                                 AutomationProperties.Name="Abstand rechts" GotKeyboardFocus="ZoneField_GotKeyboardFocus" KeyDown="ZoneField_KeyDown" />
                                                        <Button x:Name="ZoneMarginRightUnitButton" Tag="MarginRight" Content="%" Click="ZoneUnitButton_Click"
                                                                Style="{StaticResource UnitToggleButton}" AutomationProperties.Name="Einheit für Abstand rechts: Prozent" />
                                                    </Grid>
                                                </StackPanel>
                                                <StackPanel Margin="6,12,0,0">
                                                    <TextBlock Text="Unten" Style="{StaticResource FieldLabel}" />
                                                    <Grid>
                                                        <TextBox x:Name="ZoneMarginBottomText" Tag="Margins" Padding="10,7,48,7" FontFamily="Cascadia Mono"
                                                                 AutomationProperties.Name="Abstand unten" GotKeyboardFocus="ZoneField_GotKeyboardFocus" KeyDown="ZoneField_KeyDown" />
                                                        <Button x:Name="ZoneMarginBottomUnitButton" Tag="MarginBottom" Content="%" Click="ZoneUnitButton_Click"
                                                                Style="{StaticResource UnitToggleButton}" AutomationProperties.Name="Einheit für Abstand unten: Prozent" />
                                                    </Grid>
                                                </StackPanel>
                                            </UniformGrid>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock x:Name="ZoneInputErrorText" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,10,0,0" />
                                    <Button x:Name="ApplyZoneValuesButton" Content="Werte anwenden" Click="ApplyZoneValues_Click"
                                            Style="{StaticResource PrimaryButton}" Margin="0,12,0,8" />
                                    <Button Content="Zone löschen" Click="DeleteZone_Click" Margin="0,0,0,8" />
                                    <Button Content="Entwurf zurücksetzen" Click="ResetLayout_Click" Margin="0,0,0,8" />
                                    <TextBlock x:Name="ValidationText" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Fensterplatzierung">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="38,30" MaxWidth="1120" HorizontalAlignment="Left">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="18" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="18" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Fensterplatzierung" Style="{StaticResource PageTitle}" />
                                <Button Style="{StaticResource InfoButton}" VerticalAlignment="Center"
                                        AutomationProperties.Name="Hilfe zur Fensterplatzierung"
                                        ToolTip="Gelernte Fenster können an ihrer letzten Position oder in einer festen Zone geöffnet werden. Ausschlüsse und feste Ziele gelten für den ausgewählten Fenstertyp." />
                            </StackPanel>
                            <CheckBox x:Name="PlacementAutomaticCheckBox" Grid.Column="1" Content="Automatik"
                                      IsChecked="{Binding Settings.RestoreWindowPlacementEnabled}"
                                      VerticalAlignment="Center" Margin="20,0,0,0"
                                      AutomationProperties.Name="Fensterplatzierung automatisch anwenden" />
                        </Grid>

                        <Button x:Name="PlacementSelectButton" Grid.Row="2" Content="Fenster auswählen"
                                Click="PlacementSelect_Click" Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Left" Margin="0"
                                AutomationProperties.Name="Nächstes Zielfenster auswählen" />

                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="560" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="500" />
                            </Grid.ColumnDefinitions>

                            <Border x:Name="PlacementLearnedCard" Style="{StaticResource SectionCard}" Margin="0">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="Gelernte Fenster" Style="{StaticResource SectionTitle}" Margin="0,0,0,14" />
                                    <ListBox ItemsSource="{Binding WindowPlacement.Items}"
                                             SelectedItem="{Binding WindowPlacement.SelectedItem}"
                                             MinHeight="430"
                                             AutomationProperties.Name="Gelernte Fenster">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="2*" />
                                                        <ColumnDefinition Width="3*" />
                                                        <ColumnDefinition Width="2*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Margin="0,0,12,0">
                                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding WindowKindText}" Foreground="{DynamicResource MutedBrush}" FontSize="13" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                                        <TextBlock Text="{Binding PlacementText}" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding RuleStatusText}" Foreground="{DynamicResource MutedBrush}" FontSize="13" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding LastUpdatedText}" Foreground="{DynamicResource MutedBrush}"
                                                               FontSize="13" TextAlignment="Right" TextWrapping="Wrap" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource SectionCard}" Margin="0">
                                <StackPanel>
                                    <TextBlock Text="Ausgewähltes Fenster" Style="{StaticResource SectionTitle}" />
                                    <WrapPanel Margin="0,16,0,8">
                                        <Button x:Name="PlacementApplyButton" Content="Jetzt anwenden" Click="PlacementApply_Click"
                                                IsEnabled="{Binding WindowPlacement.HasSelection}" Style="{StaticResource PrimaryButton}" />
                                        <Button x:Name="PlacementRememberButton" Content="Letzte Platzierung" Click="PlacementRemember_Click"
                                                IsEnabled="{Binding WindowPlacement.HasSelection}" />
                                        <Button x:Name="PlacementExcludeButton" Content="Nicht verwalten" Click="PlacementExclude_Click"
                                                IsEnabled="{Binding WindowPlacement.HasSelection}" />
                                        <Button x:Name="PlacementForgetButton" Content="Vergessen" Click="PlacementForget_Click"
                                                IsEnabled="{Binding WindowPlacement.HasSelection}" />
                                    </WrapPanel>

                                    <TextBlock Text="Feste Zone" Style="{StaticResource FieldLabel}" Margin="0,8,0,5" />
                                    <ComboBox ItemsSource="{Binding WindowPlacement.TargetProfiles}"
                                              SelectedItem="{Binding WindowPlacement.SelectedTargetProfile}"
                                              DisplayMemberPath="Name" AutomationProperties.Name="Zielprofil" />
                                    <ComboBox ItemsSource="{Binding WindowPlacement.TargetMonitors}"
                                              SelectedItem="{Binding WindowPlacement.SelectedTargetMonitor}"
                                              DisplayMemberPath="DisplayName" Margin="0,8,0,0"
                                              AutomationProperties.Name="Zielmonitor" />
                                    <ComboBox ItemsSource="{Binding WindowPlacement.TargetZones}"
                                              SelectedItem="{Binding WindowPlacement.SelectedTargetZone}"
                                              DisplayMemberPath="Name" Margin="0,8,0,0"
                                              AutomationProperties.Name="Zielzone" />
                                    <Button x:Name="PlacementFixButton" Content="Feste Zone speichern" Click="PlacementFix_Click"
                                            IsEnabled="{Binding WindowPlacement.HasSelection}" Margin="0,10,0,8" />

                                    <TextBlock Text="Optionales Titelmuster" Style="{StaticResource FieldLabel}" Margin="0,10,0,5" />
                                    <TextBox Text="{Binding WindowPlacement.TitlePattern, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Optionales Titelmuster" />

                                    <TextBlock Text="Technische Werte" Style="{StaticResource FieldLabel}" Margin="0,14,0,5" />
                                    <TextBlock Text="App-Schlüssel" Foreground="{DynamicResource MutedBrush}" FontSize="13" />
                                    <TextBox x:Name="PlacementApplicationKeyText" Text="{Binding WindowPlacement.SelectedItem.Identity.ApplicationKey, Mode=OneWay}"
                                             IsReadOnly="True" FontFamily="Cascadia Mono" Margin="0,3,0,8"
                                             AutomationProperties.Name="App-Schlüssel" />
                                    <TextBlock Text="Fensterklasse" Foreground="{DynamicResource MutedBrush}" FontSize="13" />
                                    <TextBox x:Name="PlacementWindowClassText" Text="{Binding WindowPlacement.SelectedItem.Identity.WindowClass, Mode=OneWay}"
                                             IsReadOnly="True" FontFamily="Cascadia Mono" Margin="0,3,0,8"
                                             AutomationProperties.Name="Fensterklasse" />
                                    <TextBlock Text="Art" Foreground="{DynamicResource MutedBrush}" FontSize="13" />
                                    <TextBox Text="{Binding WindowPlacement.SelectedItem.WindowKindText, Mode=OneWay}" IsReadOnly="True"
                                             Margin="0,3,0,8" AutomationProperties.Name="Fensterart" />
                                    <TextBlock x:Name="PlacementRuleStatusText" Text="{Binding WindowPlacement.SelectedItem.RuleStatusText}"
                                               Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0"
                                               AutomationProperties.Name="Regelstatus" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Windows-Anzeige">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="38,30" MaxWidth="1020" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,22">
                            <TextBlock Text="Windows-Anzeige" Style="{StaticResource PageTitle}" />
                            <Button Style="{StaticResource InfoButton}" VerticalAlignment="Center" AutomationProperties.Name="Hilfe zur Windows-Anzeige"
                                    ToolTip="Diese Seite zeigt erkannte Monitorwerte und öffnet die passenden Windows-Einstellungen. Das Programm verändert keine privaten Explorer-, DPI- oder Registry-Strukturen." />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                            <TextBlock Text="Monitor" Style="{StaticResource FieldLabel}" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <ComboBox ItemsSource="{Binding Monitors}" SelectedItem="{Binding SelectedMonitor}" ItemTemplate="{StaticResource MonitorItemTemplate}" Width="340" />
                        </StackPanel>
                        <UniformGrid Columns="3">
                            <Border Style="{StaticResource SectionCard}" Margin="0,0,10,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="Anzeige skalieren" Style="{StaticResource SectionTitle}" />
                                        <Button Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zur Anzeigeskalierung"
                                                ToolTip="Die normale Windows-Skalierung ist monitorbezogen und bietet nur unterstützte Werte. Eine freie benutzerdefinierte Skalierung gilt systemweit und kann eine Abmeldung erfordern." />
                                    </StackPanel>
                                    <TextBlock x:Name="WindowsScaleText" Text="Erkannter Wert" FontSize="22" FontWeight="SemiBold" Margin="0,18,0,18" />
                                    <Button Content="Anzeigeeinstellungen öffnen" Tag="ms-settings:display" Click="OpenSystemSetting_Click" Margin="0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SectionCard}" Margin="0,0,10,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="Textgrösse" Style="{StaticResource SectionTitle}" />
                                        <Button Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zur Textgrösse"
                                                ToolTip="Windows bietet eine Textgrösse von 100 bis 225 Prozent, wendet sie jedoch global auf alle Monitore an. Eine sichere freie Einstellung pro Monitor ist nicht verfügbar." />
                                    </StackPanel>
                                    <Button Content="Textgrösse öffnen" Tag="ms-settings:easeofaccess-textsize" Click="OpenSystemSetting_Click" Margin="0,58,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SectionCard}" Margin="0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="Taskleiste" Style="{StaticResource SectionTitle}" />
                                        <Button Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zu Taskleiste und Symbolen"
                                                ToolTip="Windows 11 bietet keine unterstützte freie oder monitorweise Schnittstelle für Taskleistenhöhe und Symbolgrösse. Instabile Explorer-Eingriffe werden nicht verwendet." />
                                    </StackPanel>
                                    <Button Content="Taskleisteneinstellungen öffnen" Tag="ms-settings:taskbar" Click="OpenSystemSetting_Click" Margin="0,58,0,0" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Einstellungen">
                <ScrollViewer x:Name="SettingsScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              HorizontalContentAlignment="Stretch">
                    <StackPanel x:Name="SettingsContent" Margin="38,30" HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,22">
                            <TextBlock Text="Einstellungen" Style="{StaticResource PageTitle}" />
                            <Button Style="{StaticResource InfoButton}" VerticalAlignment="Center" AutomationProperties.Name="Hilfe zu den Einstellungen"
                                    ToolTip="Gültige Änderungen werden automatisch gespeichert und sofort für die Snap-Funktion wirksam. Die Theme-Vorschau wird direkt angezeigt." />
                        </StackPanel>
                        <Border Background="{DynamicResource WarningSoftBrush}" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox Content="Snap-Funktion aktivieren" IsChecked="{Binding Settings.SnappingEnabled}" Checked="SafetySetting_Changed" Unchecked="SafetySetting_Changed" FontWeight="SemiBold" />
                                    <Button Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zur Snap-Funktion"
                                            ToolTip="Nach dem Aktivieren beobachtet das Programm geeignete Fensterverschiebungen. Escape beendet nur den aktuellen Ziehvorgang; der Not-Aus deaktiviert die gesamte Snap-Funktion." />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="Not-Aus: Ctrl + Alt + Shift + F12" Foreground="{DynamicResource WarningBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <Border Style="{StaticResource SectionCard}">
                                    <StackPanel>
                                        <TextBlock Text="Programm" Style="{StaticResource SectionTitle}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,16,0,5">
                                            <TextBlock Text="Theme" Style="{StaticResource FieldLabel}" Margin="0" VerticalAlignment="Center" />
                                            <Button x:Name="ThemeInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zum Theme"
                                                    ToolTip="Windows-System folgt automatisch dem App-Modus von Windows. Hell oder Dunkel überschreibt diese Auswahl nur für Sascha Window Zones." />
                                        </StackPanel>
                                        <ComboBox ItemsSource="{Binding Settings.ThemeModes}" SelectedItem="{Binding Settings.ThemeMode}" ItemTemplate="{StaticResource EnumItemTemplate}" SelectionChanged="Theme_SelectionChanged" />
                                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                            <CheckBox Content="Mit Windows starten" IsChecked="{Binding Settings.StartWithWindows}" />
                                            <Button Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zum Autostart"
                                                    ToolTip="Erstellt automatisch einen Autostarteintrag nur für den aktuellen Benutzer. Dafür werden weder Administratorrechte noch ein Windows-Dienst benötigt." />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SectionCard}">
                                    <StackPanel>
                                        <TextBlock Text="Ziehen und Overlay" Style="{StaticResource SectionTitle}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,16,0,5">
                                            <TextBlock Text="Overlays anzeigen" Style="{StaticResource FieldLabel}" Margin="0" VerticalAlignment="Center" />
                                            <Button x:Name="OverlayScopeInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zum Overlaybereich"
                                                    ToolTip="Alle Monitore zeigt die Zonen auf jeder aktiven Anzeige. Aktiver Monitor zeigt nur die Zonen des Bildschirms, auf dem sich der Mauszeiger befindet." />
                                        </StackPanel>
                                        <ComboBox ItemsSource="{Binding Settings.OverlayScopes}" SelectedItem="{Binding Settings.OverlayScope}" ItemTemplate="{StaticResource EnumItemTemplate}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,16,0,5">
                                            <TextBlock Text="Aktivierung" Style="{StaticResource FieldLabel}" Margin="0" VerticalAlignment="Center" />
                                            <Button x:Name="TriggerModeInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zur Overlayaktivierung"
                                                    ToolTip="Sofort zeigt die Zonen bei jedem geeigneten Ziehen an der Titelleiste. Umschalttaste zeigt sie nur, wenn du beim Ziehen zusätzlich Shift gedrückt hältst." />
                                        </StackPanel>
                                        <ComboBox ItemsSource="{Binding Settings.TriggerModes}" SelectedItem="{Binding Settings.TriggerMode}" ItemTemplate="{StaticResource EnumItemTemplate}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                            <CheckBox Content="Zonennamen anzeigen" IsChecked="{Binding Settings.ShowZoneNames}" />
                                            <Button Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zu Zonennamen"
                                                    ToolTip="Zeigt beim Verschieben den Namen jeder Zone auf einer kleinen dunklen Beschriftungsfläche. Kontur und Zielfläche bleiben auch ohne Namen sichtbar." />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SectionCard}">
                                    <StackPanel>
                                        <TextBlock Text="Overlay-Darstellung" Style="{StaticResource SectionTitle}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,16,0,5">
                                            <TextBlock Text="Farbe" Style="{StaticResource FieldLabel}" Margin="0" VerticalAlignment="Center" />
                                            <Button x:Name="OverlayColourInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zur Overlayfarbe"
                                                    ToolTip="Gib eine RGB-Farbe im Format #RRGGBB ein. Das neutrale Windows-Grau #707070 wirkt ruhig; eine eigene Farbe bleibt möglich." />
                                        </StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="38" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="OverlayColorPreview" Width="38" Height="38" Background="{Binding Settings.OverlayColor}"
                                                    BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="5"
                                                    AutomationProperties.Name="Vorschau der Overlayfarbe" />
                                            <TextBox x:Name="OverlayColorText" Grid.Column="1" Margin="10,0,0,0"
                                                     Text="{Binding Settings.OverlayColor, UpdateSourceTrigger=PropertyChanged}" FontFamily="Cascadia Mono"
                                                     AutomationProperties.Name="Hexwert der Overlayfarbe" />
                                            <Button x:Name="OverlayColorPickerButton" Grid.Column="2" Content="Farbe wählen" Click="OverlayColorPicker_Click"
                                                    Margin="10,0,0,0" AutomationProperties.Name="Overlayfarbe auswählen" />
                                        </Grid>
                                        <Grid Margin="0,16,0,3">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="Deckkraft" Style="{StaticResource FieldLabel}" Margin="0" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" x:Name="OverlayOpacityInfoButton" Style="{StaticResource InfoButton}" Margin="7,0,12,0" AutomationProperties.Name="Hilfe zur Overlaydeckkraft"
                                                    ToolTip="Eine kleine Deckkraft hält das Overlay sehr dezent. Die aktive Zielzone wird nur leicht verstärkt, damit das Ziel erkennbar bleibt, ohne den Bildschirm zu überdecken." />
                                            <TextBlock Grid.Column="2" Text="{Binding Settings.OverlayOpacityPercent, StringFormat={}{0:0.#} %}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="72" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <Slider x:Name="OverlayOpacitySlider" Minimum="8" Maximum="75" Value="{Binding Settings.OverlayOpacityPercent}"
                                                    TickFrequency="0.5" IsSnapToTickEnabled="True" />
                                            <TextBox x:Name="OverlayOpacityPercentText" Grid.Column="1" Margin="10,0,6,0" TextAlignment="Right"
                                                     Text="{Binding Settings.OverlayOpacityPercent, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:0.#}}"
                                                     AutomationProperties.Name="Deckkraft in Prozent" />
                                            <TextBlock Grid.Column="2" Text="%" VerticalAlignment="Center" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <Border Style="{StaticResource SectionCard}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Overlay-Abstände und Andocken" Style="{StaticResource SectionTitle}" />
                                            <Button x:Name="OuterMarginsInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zu äusseren Abständen"
                                                    ToolTip="Diese Werte bestimmen ausschliesslich die zusätzlichen Aussenabstände des Overlays. Fenster und Layoutdefinition bleiben unverändert; das Overlay behält auch bei 0 einen kleinen visuellen Mindestabstand. Zulässig sind 0 bis 400 Pixel." />
                                        </StackPanel>
                                        <TextBlock Text="Overlay-Aussenabstände in Pixel" Style="{StaticResource FieldLabel}" Margin="0,16,0,5" />
                                        <UniformGrid Columns="4">
                                            <StackPanel Margin="0,0,8,0"><TextBlock Text="Links" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding Settings.OuterMarginLeft, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                            <StackPanel Margin="0,0,8,0"><TextBlock Text="Oben" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding Settings.OuterMarginTop, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                            <StackPanel Margin="0,0,8,0"><TextBlock Text="Rechts" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding Settings.OuterMarginRight, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                            <StackPanel><TextBlock Text="Unten" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding Settings.OuterMarginBottom, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                        </UniformGrid>
                                        <Grid Margin="0,20,0,3">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="Overlay-Zonenabstand" Style="{StaticResource FieldLabel}" Margin="0" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" x:Name="ZoneGapInfoButton" Style="{StaticResource InfoButton}" Margin="7,0,12,0" AutomationProperties.Name="Hilfe zum Zonenabstand"
                                                    ToolTip="Bestimmt den zusätzlichen Abstand zwischen benachbarten Overlayflächen. Fenster folgen exakt der Layoutdefinition; bei 0 behält das Overlay trotzdem seinen visuellen Mindestabstand." />
                                            <TextBlock Grid.Column="2" Text="{Binding Settings.ZoneGap, StringFormat={}{0} px}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="72" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <Slider x:Name="ZoneGapSlider" Minimum="0" Maximum="100" Value="{Binding Settings.ZoneGapPercent}"
                                                    TickFrequency="0.5" IsSnapToTickEnabled="True" />
                                            <TextBox x:Name="ZoneGapPercentText" Grid.Column="1" Margin="10,0,6,0" TextAlignment="Right"
                                                     Text="{Binding Settings.ZoneGapPercent, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:0.#}}"
                                                     AutomationProperties.Name="Zonenabstand in Prozent" />
                                            <TextBlock Grid.Column="2" Text="%" VerticalAlignment="Center" />
                                        </Grid>
                                        <Grid Margin="0,16,0,3">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="Magnetdistanz" Style="{StaticResource FieldLabel}" Margin="0" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" x:Name="MagnetDistanceInfoButton" Style="{StaticResource InfoButton}" Margin="7,0,12,0" AutomationProperties.Name="Hilfe zur Magnetdistanz"
                                                    ToolTip="Kanten innerhalb dieser Distanz docken im Editor automatisch an Monitor- oder Zonenkanten an. 0 deaktiviert das Andocken; Alt pausiert es beim Ziehen." />
                                            <TextBlock Grid.Column="2" Text="{Binding Settings.MagnetThresholdPixels, StringFormat={}{0} px}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="72" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <Slider x:Name="MagnetThresholdSlider" Minimum="0" Maximum="100" Value="{Binding Settings.MagnetThresholdPercent}"
                                                    TickFrequency="0.5" IsSnapToTickEnabled="True" />
                                            <TextBox x:Name="MagnetThresholdPercentText" Grid.Column="1" Margin="10,0,6,0" TextAlignment="Right"
                                                     Text="{Binding Settings.MagnetThresholdPercent, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:0.#}}"
                                                     AutomationProperties.Name="Magnetdistanz in Prozent" />
                                            <TextBlock Grid.Column="2" Text="%" VerticalAlignment="Center" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SectionCard}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Visueller Mindestabstand" Style="{StaticResource SectionTitle}" />
                                            <Button x:Name="OverlayVisualMarginInfoButton" Style="{StaticResource InfoButton}"
                                                    AutomationProperties.Name="Hilfe zum visuellen Overlay-Abstand"
                                                    ToolTip="Dieser Abstand betrifft nur die Vorschau beim Ziehen. Die tatsächlichen Fenster bleiben exakt in den definierten Zonen und können direkt aneinander oder am Bildschirmrand liegen." />
                                        </StackPanel>
                                        <TextBlock Text="8 px visuell" FontSize="24" FontWeight="SemiBold" Margin="0,16,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Import / Export">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="38,30" MaxWidth="940" HorizontalAlignment="Left">
                        <TextBlock Text="Import / Export" Style="{StaticResource PageTitle}" Margin="0,0,0,8" />
                        <TextBlock Text="Sichere die vollständige Konfiguration in einer Datei oder ersetze sie durch eine zuvor exportierte Konfiguration."
                                   Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,22" />
                        <UniformGrid Columns="2">
                            <Border Style="{StaticResource SectionCard}" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="Konfiguration exportieren" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="Erstellt ein vollständiges Backup mit Einstellungen, Profilen, Monitorlayouts und Zonen."
                                               Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,12,0,18" />
                                    <Button x:Name="ExportConfigurationButton" Content="Vollständig exportieren"
                                            Click="ExportConfiguration_Click" Style="{StaticResource PrimaryButton}"
                                            Margin="0" AutomationProperties.Name="Vollständig exportieren" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SectionCard}" Margin="10,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Konfiguration importieren" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="Prüft ein vollständiges Backup und ersetzt die aktuelle Konfiguration erst nach Bestätigung."
                                               Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,12,0,18" />
                                    <Button x:Name="ImportConfigurationButton" Content="Vollständig importieren"
                                            Click="ImportConfiguration_Click" Margin="0"
                                            AutomationProperties.Name="Vollständig importieren" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource MutedBrush}" Margin="20,0" VerticalAlignment="Center" FontSize="13" />
        </Border>
    </Grid>
</Window>

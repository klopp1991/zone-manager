<Window x:Class="SnapZones.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SnapZones.App.Controls"
        xmlns:viewModels="clr-namespace:SnapZones.App.ViewModels"
        Title="Zone Manager"
        Width="1480" Height="900" MinWidth="1180" MinHeight="720"
        FontSize="16"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Icon>
        <BitmapImage UriSource="/ZoneManager;component/Assets/ZoneManager.ico" DecodePixelWidth="64" />
    </Window.Icon>
    <Window.Resources>
        <viewModels:EnumDisplayConverter x:Key="EnumDisplayConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <viewModels:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
        <viewModels:ZeroToVisibilityConverter x:Key="ZeroToVisibilityConverter" />
        <viewModels:NonZeroToVisibilityConverter x:Key="NonZeroToVisibilityConverter" />
        <viewModels:NotNullToVisibilityConverter x:Key="NotNullToVisibilityConverter" />
        <viewModels:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <controls:ProgramIconConverter x:Key="ProgramIconConverter" />
        <controls:ProgramInitialsConverter x:Key="ProgramInitialsConverter" />
        <viewModels:EqualityConverter x:Key="EqualityConverter" />
        <DataTemplate x:Key="EnumItemTemplate">
            <TextBlock Text="{Binding Converter={StaticResource EnumDisplayConverter}}" />
        </DataTemplate>
        <DataTemplate x:Key="LayoutMonitorItemTemplate">
            <TextBlock Text="{Binding UserFacingName}" />
        </DataTemplate>
        <DataTemplate x:Key="TargetLayoutItemTemplate">
            <TextBlock>
                <Run Text="{Binding UserFacingMonitorName, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Name, Mode=OneWay}" />
            </TextBlock>
        </DataTemplate>
        <!-- Programm-Symbol 36 x 36: echtes Symbol der .exe, sonst zwei Buchstaben auf AccentSoftBrush. -->
        <DataTemplate x:Key="ProgramIconTemplate">
            <Border Width="36" Height="36" CornerRadius="8" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Center">
                <Grid>
                    <TextBlock Text="{Binding Converter={StaticResource ProgramInitialsConverter}}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentStatusBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Image Source="{Binding Converter={StaticResource ProgramIconConverter}}" Width="24" Height="24"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{DynamicResource CanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Kopfzeile: Icon fuehrt zur Uebersicht; nur die Versionsnummer, ohne das Wort «Version». -->
        <Border Grid.Row="0" MinHeight="72" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="14" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="10" /><ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="HeaderLogoButton" Click="ShowOverview_Click" AutomationProperties.Name="Zur Übersicht"
                        ToolTip="Zur Übersicht" VerticalAlignment="Center" MinHeight="0" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button"><ContentPresenter /></ControlTemplate>
                    </Button.Template>
                    <Image Width="36" Height="36" Source="/ZoneManager;component/Assets/ZoneManager.Header.png"
                           RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" />
                </Button>
                <TextBlock Grid.Column="2" Text="Zone Manager" FontFamily="Segoe UI Variable Display"
                           FontSize="23" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock x:Name="VersionLabel" Grid.Column="4" Foreground="{DynamicResource MutedBrush}"
                           FontSize="14" VerticalAlignment="Center" Margin="0,7,0,0"
                           AutomationProperties.Name="Programmversion" />
            </Grid>
        </Border>

        <TabControl x:Name="NavigationTabs" Grid.Row="1" Margin="0" TabStripPlacement="Left">
            <controls:Chrome.SidebarHeader>
                <StackPanel>
                    <Grid>
                        <TextBox x:Name="SearchText" MinHeight="36" FontSize="14" Padding="30,0,10,0"
                                 controls:Chrome.Placeholder="Einstellung suchen …"
                                 Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="SearchText_KeyDown" AutomationProperties.Name="Einstellung suchen" />
                        <TextBlock Text="⌕" FontSize="14" Foreground="{DynamicResource SubtleInkBrush}" Margin="10,0,0,0"
                                   HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" />
                    </Grid>
                    <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="4" Margin="0,6,0,0"
                            Visibility="{Binding HasSearchQuery, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <ItemsControl x:Name="SearchResultsList" ItemsSource="{Binding SearchResults}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Click="SearchResult_Click" Style="{StaticResource LinkButton}" HorizontalAlignment="Stretch" Padding="6"
                                                AutomationProperties.Name="{Binding Label}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Row" Background="Transparent" CornerRadius="4" Padding="6,5">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Label}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                            <TextBlock Text="{Binding Path}" FontSize="12" Foreground="{DynamicResource SubtleInkBrush}" />
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverBrush}" /></Trigger>
                                                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverBrush}" /></Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Nichts gefunden." FontSize="13" Foreground="{DynamicResource SubtleInkBrush}" Margin="10,6"
                                       Visibility="{Binding HasNoSearchResults, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </controls:Chrome.SidebarHeader>

            <!-- ========================= Übersicht ========================= -->
            <TabItem x:Name="OverviewTab" Header="Übersicht" controls:Chrome.Group="ÜBERSICHT">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="38,30" MinWidth="860" MaxWidth="1100" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Übersicht" Style="{StaticResource PageTitle}" />
                            <TextBlock x:Name="LastSavedText" Text="{Binding LastSavedText}" Style="{StaticResource HelpText}" Margin="14,0,0,4" VerticalAlignment="Bottom"
                                       AutomationProperties.Name="Zeitpunkt der letzten Speicherung" />
                        </StackPanel>
                        <TextBlock Text="Deine Monitore, ihre aktiven Layouts und was gerade eingerichtet ist. Ein Klick auf einen Monitor öffnet den Editor."
                                   Style="{StaticResource HelpText}" Margin="0,8,0,22" />
                        <ItemsControl x:Name="OverviewMonitorCards" ItemsSource="{Binding Monitors}" Margin="0,0,-12,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource SectionCard}" Margin="0,0,12,12" Padding="18">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <Border Width="24" Height="24" CornerRadius="12" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayNumber}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding UserFacingName}" Style="{StaticResource SectionTitle}" Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="2" Text="{Binding OverviewDetailsText}" FontSize="14" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                                            </Grid>
                                            <Button Style="{StaticResource CardButton}" Padding="0" BorderThickness="0" Background="Transparent" Click="OverviewMonitor_Click"
                                                    AutomationProperties.Name="{Binding UserFacingName, StringFormat=Zonen von {0} bearbeiten}">
                                                <controls:ZonePreview Zones="{Binding Layout.Zones}" MainZoneId="{Binding Layout.MainZoneId}" AspectRatio="{Binding AspectRatio}"
                                                                      FrameRadius="8" FramePadding="5" LabelFontSize="12" MaxHeight="260" />
                                            </Button>
                                            <Grid Margin="0,14,0,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="Aktives Layout" Style="{StaticResource FieldLabel}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                <ComboBox Grid.Column="1" MaxWidth="220" HorizontalAlignment="Left" ItemsSource="{Binding Layouts}" SelectedItem="{Binding Layout, Mode=OneWay}"
                                                          DisplayMemberPath="Name" SelectionChanged="OverviewLayout_SelectionChanged"
                                                          AutomationProperties.Name="{Binding UserFacingName, StringFormat=Aktives Layout für {0}}" />
                                                <TextBlock Grid.Column="2" Text="{Binding LayoutCountText}" FontSize="14" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <UniformGrid Columns="3" Margin="0,0,-12,0">
                            <Button x:Name="RuleCounterCard" Style="{StaticResource CardButton}" Margin="0,0,12,12" Click="ShowRules_Click" AutomationProperties.Name="Zugeordnete Fenster anzeigen">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding RuleCountText}" FontFamily="Segoe UI Variable Display" FontSize="30" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Zugeordnete Fenster" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding RuleCountHint}" FontSize="14">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource SubtleInkBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasPausedRules}" Value="True"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="›" FontSize="18" Foreground="{DynamicResource SubtleInkBrush}" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                            <Button x:Name="ExclusionCounterCard" Style="{StaticResource CardButton}" Margin="0,0,12,12" Click="ShowExclusions_Click" AutomationProperties.Name="In Ruhe gelassene Fenster anzeigen">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding ExclusionCountText}" FontFamily="Segoe UI Variable Display" FontSize="30" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="In Ruhe gelassen" FontWeight="SemiBold" />
                                        <TextBlock Text="Fenster ohne Zonen" FontSize="14" Foreground="{DynamicResource SubtleInkBrush}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="›" FontSize="18" Foreground="{DynamicResource SubtleInkBrush}" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                            <Button x:Name="RememberedCounterCard" Style="{StaticResource CardButton}" Margin="0,0,12,12" Click="ShowRemembered_Click" AutomationProperties.Name="Gemerkte Fenster anzeigen">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding RememberedWindowCount}" FontFamily="Segoe UI Variable Display" FontSize="30" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Gemerkte Fenster" FontWeight="SemiBold" />
                                        <TextBlock Text="kehren in ihre Zone zurück" FontSize="14" Foreground="{DynamicResource SubtleInkBrush}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="›" FontSize="18" Foreground="{DynamicResource SubtleInkBrush}" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                        </UniformGrid>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Button x:Name="DrawZonesButton" Content="Zonen auf dem Monitor zeichnen" Style="{StaticResource PrimaryButton}" Click="DrawOnMonitor_Click"
                                    AutomationProperties.Name="Zonen auf dem Monitor zeichnen" ToolTip="Öffnet den Editor in echter Grösse auf dem gewählten Monitor." />
                            <Button x:Name="OverviewAssignButton" Content="+ Fenster zuordnen" Margin="10,0,0,0" Click="AppRuleAdd_Click"
                                    AutomationProperties.Name="Fenster zuordnen" />
                            <Button x:Name="PreviewZonesButton" Content="Zonen kurz einblenden" Margin="10,0,0,0" Click="PreviewZones_Click"
                                    AutomationProperties.Name="Zonen drei Sekunden lang auf allen Monitoren zeigen"
                                    ToolTip="Zeigt die aktiven Layouts drei Sekunden lang auf allen Monitoren, genau so, wie das Overlay sie beim Ziehen zeigt." />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ========================= Monitore ========================= -->
            <TabItem x:Name="MonitorsTab" Header="Monitore" controls:Chrome.Group="EINRICHTEN" controls:Chrome.Badge="{Binding MonitorCountText}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="38,30" MinWidth="860" MaxWidth="900" HorizontalAlignment="Left">
                        <TextBlock Text="Monitore" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="Monitore werden an ihrer EDID wiedererkannt – Name, Reihenfolge und Layouts folgen ihnen an jeden Anschluss."
                                   Style="{StaticResource HelpText}" Margin="0,8,0,22" />
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Button x:Name="PreviousMonitorButton" Content="‹" Style="{StaticResource IconButton}" Click="PreviousMonitor_Click"
                                            IsEnabled="{Binding CanSelectPreviousMonitor}" AutomationProperties.Name="Vorheriger Monitor" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SelectedMonitor.UserFacingName}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding MonitorPositionText}" FontSize="14" Foreground="{DynamicResource MutedBrush}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Button x:Name="NextMonitorButton" Grid.Column="2" Content="›" Style="{StaticResource IconButton}" Click="NextMonitor_Click"
                                            IsEnabled="{Binding CanSelectNextMonitor}" AutomationProperties.Name="Nächster Monitor" />
                                </Grid>
                                <TextBlock Text="{Binding SelectedMonitor.ConnectionNote}" Style="{StaticResource HelpText}" HorizontalAlignment="Center"
                                           Visibility="{Binding SelectedMonitor.ConnectionNote, Converter={StaticResource NotNullToVisibilityConverter}}" />
                                <controls:ZonePreview x:Name="MonitorPreview" Zones="{Binding SelectedMonitor.Layout.Zones}" MainZoneId="{Binding SelectedMonitor.Layout.MainZoneId}"
                                                      AspectRatio="{Binding SelectedMonitor.AspectRatio}" FrameRadius="12" FramePadding="8" LabelFontSize="14"
                                                      Margin="60,16,60,0" MaxHeight="360" />
                                <Button x:Name="EditActiveLayoutLink" Style="{StaticResource LinkButton}" HorizontalAlignment="Right" Margin="0,6,60,0" Click="EditActiveLayout_Click"
                                        Content="{Binding SelectedMonitor.Layout.Name, StringFormat=Layout «{0}» · bearbeiten, Mode=OneWay}"
                                        AutomationProperties.Name="Aktives Layout bearbeiten" />
                                <Grid Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="10" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="MonitorNameText" Text="{Binding SelectedMonitor.CustomName, Mode=OneWay}" VerticalContentAlignment="Center"
                                                 LostFocus="MonitorName_LostFocus" KeyDown="MonitorName_KeyDown" AutomationProperties.Name="Eigener Monitorname" />
                                        <TextBlock Style="{StaticResource HelpText}"><Run Text="Leer = automatischer Name «Monitor " /><Run Text="{Binding SelectedMonitor.DisplayNumber, Mode=OneWay}" /><Run Text="»." /></TextBlock>
                                    </StackPanel>
                                    <Button x:Name="IdentifyMonitorsButton" Grid.Column="2" Content="Auf Monitor zeigen" Click="IdentifyMonitors_Click" VerticalAlignment="Top" Margin="0,21,0,0"
                                            AutomationProperties.Name="Monitore identifizieren"
                                            ToolTip="Zeigt den verwendeten Namen drei Sekunden lang auf jedem Monitor an." />
                                    <Button x:Name="MonitorOrderButton" Grid.Column="4" Content="Reihenfolge ⌵" Click="MonitorOrder_Click" VerticalAlignment="Top" Margin="0,21,0,0"
                                            AutomationProperties.Name="Monitorreihenfolge ändern">
                                        <Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem x:Name="MoveMonitorUpButton" Header="Nach oben" Click="MoveMonitorUp_Click" AutomationProperties.Name="Ausgewählten Monitor nach oben verschieben" />
                                                <MenuItem x:Name="MoveMonitorDownButton" Header="Nach unten" Click="MoveMonitorDown_Click" AutomationProperties.Name="Ausgewählten Monitor nach unten verschieben" />
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                </Grid>
                                <Border Style="{StaticResource FieldGroup}" Margin="0,18,0,0">
                                    <Expander x:Name="DetectedValuesExpander" IsExpanded="True">
                                        <Expander.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Erkannte Werte" Style="{StaticResource GroupTitle}" />
                                                <TextBlock Text="von Windows gemeldet, nur lesbar" Style="{StaticResource HelpText}" Margin="10,0,0,0" />
                                            </StackPanel>
                                        </Expander.Header>
                                        <StackPanel>
                                            <UniformGrid Columns="4">
                                                <StackPanel><TextBlock Text="Skalierung" Style="{StaticResource HelpText}" Margin="0" /><TextBlock x:Name="ScalingFactorText" Text="–" FontSize="22" FontWeight="SemiBold" /></StackPanel>
                                                <StackPanel><TextBlock Text="Auflösung" Style="{StaticResource HelpText}" Margin="0" /><TextBlock x:Name="ScalingResolutionText" Text="–" FontSize="22" FontWeight="SemiBold" /></StackPanel>
                                                <StackPanel><TextBlock Text="Arbeitsfläche" Style="{StaticResource HelpText}" Margin="0" /><TextBlock x:Name="ScalingWorkAreaText" Text="–" FontSize="22" FontWeight="SemiBold" /></StackPanel>
                                                <StackPanel><TextBlock Text="Diagonale" Style="{StaticResource HelpText}" Margin="0" /><TextBlock x:Name="ScalingPhysicalSizeText" Text="–" FontSize="22" FontWeight="SemiBold" /></StackPanel>
                                            </UniformGrid>
                                            <TextBlock x:Name="WindowsScaleText" Style="{StaticResource HelpText}" Margin="0,10,0,0" />
                                        </StackPanel>
                                    </Expander>
                                </Border>
                                <Border Style="{StaticResource FieldGroup}" Margin="0">
                                    <Expander>
                                        <Expander.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Windows-Einstellungen öffnen" Style="{StaticResource GroupTitle}" />
                                                <TextBlock Text="Anzeige · Textgrösse · Taskleiste" Style="{StaticResource HelpText}" Margin="10,0,0,0" />
                                            </StackPanel>
                                        </Expander.Header>
                                        <StackPanel>
                                            <TextBlock Text="Ändern lassen sich diese Werte nur in Windows selbst – dafür gibt es keine unterstützte Programmierschnittstelle. Die Textgrösse gilt immer für alle Monitore zusammen; Höhe und Symbolgrösse der Taskleiste sind in Windows 11 nicht frei einstellbar."
                                                       Style="{StaticResource HelpText}" Margin="0,0,0,12" />
                                            <WrapPanel>
                                                <Button Content="Anzeigeeinstellungen öffnen" Tag="ms-settings:display" Click="OpenSystemSetting_Click" Margin="0,0,8,8" />
                                                <Button Content="Textgrösse öffnen" Tag="ms-settings:easeofaccess-textsize" Click="OpenSystemSetting_Click" Margin="0,0,8,8" />
                                                <Button Content="Taskleisteneinstellungen öffnen" Tag="ms-settings:taskbar" Click="OpenSystemSetting_Click" Margin="0,0,0,8" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </Expander>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ========================= Zonen & Layouts ========================= -->
            <TabItem x:Name="LayoutsTab" Header="Zonen &amp; Layouts" controls:Chrome.Badge="{Binding LayoutCountText}">
                <Grid Margin="18,20,18,16">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <ComboBox x:Name="LayoutMonitorSelector" ItemsSource="{Binding Monitors}" SelectedItem="{Binding SelectedMonitor, Mode=TwoWay}"
                                  ItemTemplate="{StaticResource LayoutMonitorItemTemplate}" SelectionChanged="Monitor_SelectionChanged" AutomationProperties.Name="Monitor wählen" />
                        <Border Grid.Column="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,8" VerticalAlignment="Bottom">
                            <StackPanel Orientation="Horizontal">
                                <ItemsControl x:Name="LayoutTabs" ItemsSource="{Binding Layouts}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Click="LayoutTab_Click" MouseRightButtonUp="LayoutTab_RightClick"
                                                    AutomationProperties.Name="{Binding Name, StringFormat=Layout {0} bearbeiten}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource LayoutTab}">
                                                        <Setter Property="controls:Chrome.IsCurrent">
                                                            <Setter.Value>
                                                                <MultiBinding Converter="{StaticResource EqualityConverter}">
                                                                    <Binding Path="Id" />
                                                                    <Binding Path="DataContext.SelectedLayout.Id" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                                </MultiBinding>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Button.Style>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" />
                                                    <TextBlock Text="● aktiv" FontSize="11" Foreground="{DynamicResource SuccessBrush}" Margin="8,0,0,0" VerticalAlignment="Center"
                                                               Visibility="{Binding IsActive, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button x:Name="AddLayoutButton" Content="+ Neu ⌵" Style="{StaticResource LayoutTab}" Click="AddLayoutMenu_Click" AutomationProperties.Name="Neues Layout erstellen">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Leeres Layout" Click="AddEmptyLayout_Click" />
                                            <MenuItem Header="Aus Vorlage …" Click="AddLayoutFromTemplate_Click" />
                                            <MenuItem Header="Aktuelles duplizieren" Click="DuplicateLayout_Click" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </StackPanel>
                        </Border>
                        <Button x:Name="ToggleValuePanelButton" Grid.Column="3" Content="Werte ausblenden ›" Click="ToggleValuePanel_Click" Margin="12,0,0,0"
                                AutomationProperties.Name="Werte-Panel ein- oder ausblenden" />
                    </Grid>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition x:Name="ValuePanelColumn" Width="Auto" /></Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" x:Name="LayoutEditorArea">
                            <Border Style="{StaticResource SectionCard}" Margin="0" Padding="12">
                                <DockPanel LastChildFill="True">
                                    <TextBlock x:Name="ValidationText" DockPanel.Dock="Bottom" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" FontSize="14"
                                               Visibility="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource NotNullToVisibilityConverter}}" />
                                    <Grid>
                                        <controls:LayoutCanvas x:Name="EditorCanvas" MinHeight="390" ZoneSelected="EditorCanvas_ZoneSelected"
                                                               ZoneChanged="EditorCanvas_ZoneChanged" DragStarted="EditorCanvas_DragStarted" DragEnded="EditorCanvas_DragEnded"
                                                               ZoneRenameRequested="EditorCanvas_ZoneRenameRequested" ZoneContextMenuRequested="EditorCanvas_ZoneContextMenuRequested"
                                                               ZoneDeleteRequested="EditorCanvas_ZoneDeleteRequested" AutomationProperties.Name="Layout-Editor" />
                                        <Canvas x:Name="RenameOverlay" IsHitTestVisible="True" Visibility="Collapsed">
                                            <TextBox x:Name="RenameTextBox" MinHeight="28" Padding="8,0" FontSize="14" KeyDown="RenameTextBox_KeyDown" LostKeyboardFocus="RenameTextBox_LostFocus"
                                                     AutomationProperties.Name="Zone umbenennen" />
                                        </Canvas>
                                    </Grid>
                                </DockPanel>
                            </Border>
                        </Grid>
                        <Border x:Name="ZoneValuesHost" Grid.Column="1" Style="{StaticResource SectionCard}" Margin="12,0,0,0" Padding="16" Width="300">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <controls:ZoneValuesPanel x:Name="ZoneValues" ValuesApplied="ZoneValues_ValuesApplied" />
                            </ScrollViewer>
                        </Border>
                    </Grid>
                    <DockPanel Grid.Row="2" Margin="0,12,0,0" LastChildFill="True">
                        <Button x:Name="AddZoneButton" DockPanel.Dock="Left" Content="+ Zone" Style="{StaticResource PrimaryButton}" Click="AddZone_Click"
                                AutomationProperties.Name="Neue Zone hinzufügen" ToolTip="Fügt in der grössten freien Fläche eine neue Zone hinzu." />
                        <Button x:Name="DeleteZoneButton" DockPanel.Dock="Left" Content="Zone löschen" Click="DeleteZone_Click" Margin="8,0,0,0"
                                AutomationProperties.Name="Ausgewählte Zone löschen" ToolTip="Löscht die ausgewählte Zone. Rückgängig ist über den Hinweis unten oder mit Strg + Z möglich." />
                        <Button x:Name="TemplateMenuButton" DockPanel.Dock="Left" Content="Vorlage ⌵" Click="TemplateMenu_Click" Margin="8,0,0,0"
                                AutomationProperties.Name="Vorlage wählen" ToolTip="Die Vorschläge berücksichtigen Seitenverhältnis, Auflösung, Windows-Skalierung und – falls Windows sie liefert – die physische Monitorgrösse." />
                        <Border DockPanel.Dock="Left" Width="1" Background="{DynamicResource BorderBrush}" Margin="12,4" />
                        <Button x:Name="UndoZoneChangeButton" DockPanel.Dock="Left" Content="↶" Style="{StaticResource IconButton}" Click="UndoZoneChange_Click" IsEnabled="{Binding Editor.CanUndo}"
                                AutomationProperties.Name="Letzte Änderung am Layout zurücknehmen" ToolTip="Nimmt die letzte Änderung zurück (Strg + Z)." />
                        <Button x:Name="RedoZoneChangeButton" DockPanel.Dock="Left" Content="↷" Style="{StaticResource IconButton}" Click="RedoZoneChange_Click" IsEnabled="{Binding Editor.CanRedo}" Margin="8,0,0,0"
                                AutomationProperties.Name="Zurückgenommene Änderung wiederherstellen" ToolTip="Stellt eine zurückgenommene Änderung wieder her (Strg + Y)." />
                        <Button x:Name="DrawOnMonitorButton" DockPanel.Dock="Right" Content="Auf dem Monitor zeichnen ⤢" Style="{StaticResource PrimaryButton}" Click="DrawOnMonitor_Click"
                                AutomationProperties.Name="Zonen in echter Grösse auf dem Monitor zeichnen"
                                ToolTip="Öffnet dieses Layout in echter Grösse auf dem Monitor. Alles, was du dort ziehst, ist sofort gespeichert; Esc oder «Fertig» schliesst." />
                        <TextBlock Text="Doppelklick = umbenennen · Rechtsklick = Menü · Alt = Andocken aus" Style="{StaticResource HelpText}" Margin="16,0,16,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <Popup x:Name="TemplatePopup" PlacementTarget="{Binding ElementName=TemplateMenuButton}" Placement="Top" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,6" MaxWidth="900">
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedMonitor.ResolutionText, StringFormat=Vorschläge für {0}}" Style="{StaticResource GroupTitle}" Margin="0,0,0,8" />
                                <ItemsControl x:Name="TemplateSuggestions" ItemsSource="{Binding SelectedMonitor.LayoutSuggestions}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Click="Template_Click" Width="164" MinHeight="112" Margin="0,0,10,8" Padding="8,6"
                                                    ToolTip="{Binding Description}" AutomationProperties.Name="{Binding AccessibilityName}"
                                                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                                                <Grid>
                                                    <Grid.RowDefinitions><RowDefinition Height="52" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                                    <controls:LayoutTemplatePreview Suggestion="{Binding}" Margin="4,0,4,4" />
                                                    <TextBlock Grid.Row="1" Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" />
                                                    <TextBlock Grid.Row="2" Text="{Binding Description}" Foreground="{DynamicResource SubtleInkBrush}" FontSize="11.5" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" HorizontalAlignment="Center" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Popup>
                    <Popup x:Name="LayoutRenamePopup" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,4,0,0">
                            <StackPanel Width="260">
                                <TextBlock Text="Layoutname" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="LayoutNameText" KeyDown="LayoutNameText_KeyDown" AutomationProperties.Name="Layoutname" />
                                <TextBlock Text="Enter übernimmt · Esc bricht ab" Style="{StaticResource HelpText}" />
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
            </TabItem>

            <!-- ========================= Fenster zuordnen ========================= -->
            <TabItem x:Name="RulesTab" Header="Fenster zuordnen" controls:Chrome.Badge="{Binding RuleCountText}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="38,30" MinWidth="860" MaxWidth="900" HorizontalAlignment="Left">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Fenster zuordnen" Style="{StaticResource PageTitle}" />
                            <Button x:Name="AppRuleAddButton" Grid.Column="1" Content="+ Fenster zuordnen" Style="{StaticResource PrimaryButton}" Click="AppRuleAdd_Click"
                                    AutomationProperties.Name="Fenster zuordnen" />
                        </Grid>
                        <TextBlock Text="Eine Zuordnung bringt ein Fenster immer in dieselbe Zone – beim Öffnen, beim Fokus oder beim Layoutwechsel."
                                   Style="{StaticResource HelpText}" Margin="0,8,0,22" />

                        <!-- Leerer Zustand: gestrichelte Karte mit einer aus Rechtecken gezeichneten Illustration. -->
                        <Grid x:Name="AppRuleEmptyState" Visibility="{Binding RuleCount, Converter={StaticResource ZeroToVisibilityConverter}}">
                            <Rectangle Stroke="{DynamicResource ControlBorderBrush}" StrokeDashArray="4 3" StrokeThickness="1" RadiusX="8" RadiusY="8" />
                            <StackPanel Margin="32" HorizontalAlignment="Center">
                                <Grid Width="180" Height="104" HorizontalAlignment="Center" Margin="0,0,0,18">
                                    <Border Background="{DynamicResource MonitorFrameBrush}" CornerRadius="6" />
                                    <Grid Margin="6">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                        <Rectangle Grid.RowSpan="2" Fill="{DynamicResource ZoneFillBrush}" Opacity="0.35" Stroke="{DynamicResource ZoneBorderBrush}" Margin="0,0,2,0" />
                                        <Rectangle Grid.Column="1" Stroke="{DynamicResource DropTargetBrush}" StrokeDashArray="3 2" StrokeThickness="1.5" Margin="2,0,0,2" />
                                        <Rectangle Grid.Column="1" Grid.Row="1" Fill="{DynamicResource ZoneFillBrush}" Opacity="0.35" Stroke="{DynamicResource ZoneBorderBrush}" Margin="2,2,0,0" />
                                    </Grid>
                                    <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="3"
                                            Width="70" Height="40" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="26,0,0,14">
                                        <TextBlock Text="Explorer →" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                                <TextBlock Text="Noch kein Fenster zugeordnet" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center" />
                                <TextBlock Text="Beispiel: «Wenn der Explorer geöffnet wird, setze ihn in die Zone Referenz.» Du ziehst dazu einfach ein laufendes Fenster auf eine Zone – oder wählst eine .exe-Datei."
                                           Style="{StaticResource HelpText}" TextAlignment="Center" MaxWidth="560" Margin="0,8,0,16" />
                                <Button x:Name="AppRuleAddFirstButton" Content="+ Erstes Fenster zuordnen" Style="{StaticResource PrimaryButton}" Click="AppRuleAdd_Click" HorizontalAlignment="Center"
                                        AutomationProperties.Name="Erstes Fenster zuordnen" />
                                <TextBlock Text="Tipp: Im Dialog ziehst du ein laufendes Fenster direkt auf die Zone, in der es künftig landen soll."
                                           FontSize="13" Foreground="{DynamicResource SubtleInkBrush}" TextAlignment="Center" Margin="0,14,0,0" />
                            </StackPanel>
                        </Grid>

                        <ItemsControl x:Name="AppRuleList" ItemsSource="{Binding AppRules.RuleItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <Border Style="{StaticResource ListRow}" Margin="0,0,0,8">
                                            <Border.Resources>
                                                <Style TargetType="Border" BasedOn="{StaticResource ListRow}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPaused}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource WarningBorderBrush}" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Resources>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <ContentPresenter Content="{Binding ProcessPath}" ContentTemplate="{StaticResource ProgramIconTemplate}" />
                                                <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                                                    <TextBlock TextTrimming="CharacterEllipsis">
                                                        <Run Text="{Binding DisplayName, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  →  " Foreground="{DynamicResource SubtleInkBrush}" /><Run Text="{Binding TargetLabel, Mode=OneWay}" FontWeight="SemiBold">
                                                            <Run.Style>
                                                                <Style TargetType="Run">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsPaused}" Value="True"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}" /></DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Run.Style>
                                                        </Run>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource ListSubtitle}" />
                                                </StackPanel>
                                                <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsEnabled, Mode=OneWay}" Click="AppRuleEnabled_Click" Margin="0,0,16,0"
                                                          AutomationProperties.Name="{Binding DisplayName, StringFormat=Zuordnung {0} ein- oder ausschalten}" />
                                                <Button Grid.Column="3" Content="{Binding ActionLabel}" Style="{StaticResource ListButton}" MinWidth="110" Click="AppRuleToggleDetail_Click"
                                                        AutomationProperties.Name="{Binding DisplayName, StringFormat=Zuordnung {0} bearbeiten}" />
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource SectionCard}" Margin="52,0,0,8" BorderBrush="{DynamicResource ControlBorderBrush}"
                                                Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                DataContext="{Binding DataContext.AppRules, RelativeSource={RelativeSource AncestorType=Window}}">
                                            <StackPanel>
                                                <Border Style="{StaticResource WarningBox}" Margin="0,0,0,14" Visibility="{Binding IsTargetMissing, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" FontSize="14">
                                                        <Run Text="Ziel fehlt." FontWeight="SemiBold" /><Run Text=" " /><Run Text="{Binding MissingTargetExplanation, Mode=OneWay}" />
                                                    </TextBlock>
                                                </Border>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="Programm" Style="{StaticResource FieldLabel}" />
                                                        <Grid>
                                                            <TextBox x:Name="AppRuleProcessPathText" Text="{Binding ProcessPath, UpdateSourceTrigger=PropertyChanged}" Padding="12,0,80,0"
                                                                     AutomationProperties.Name="Prozesspfad oder Dateiname" controls:Chrome.Placeholder="Dateiname, z. B. Explorer.exe" />
                                                            <Button x:Name="AppRuleBrowseButton" Content="ändern" Style="{StaticResource LinkButton}" HorizontalAlignment="Right" Margin="0,0,12,0" Click="AppRuleBrowse_Click"
                                                                    AutomationProperties.Name="Prozess auswählen" ToolTip="Wähle ein laufendes Programm oder eine Programmdatei." />
                                                        </Grid>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Wann" Style="{StaticResource FieldLabel}" />
                                                        <ComboBox x:Name="AppRuleEventSelector" ItemsSource="{Binding Events}" SelectedItem="{Binding SelectedEvent, Mode=TwoWay}"
                                                                  ItemTemplate="{StaticResource EnumItemTemplate}" AutomationProperties.Name="Ereignis der Zuordnung" ToolTip="{Binding SelectedEventDescription}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Row="1" Margin="0,14,0,0">
                                                        <TextBlock Text="Ziellayout" Style="{StaticResource FieldLabel}" />
                                                        <ComboBox x:Name="AppRuleTargetLayoutSelector" ItemsSource="{Binding TargetLayouts}" SelectedItem="{Binding SelectedTargetLayout, Mode=TwoWay}"
                                                                  ItemTemplate="{StaticResource TargetLayoutItemTemplate}" AutomationProperties.Name="Ziellayout" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,14,0,0">
                                                        <TextBlock Text="Zielzone" Style="{StaticResource FieldLabel}" />
                                                        <ComboBox x:Name="AppRuleTargetZoneSelector" ItemsSource="{Binding TargetZones}" SelectedItem="{Binding SelectedTargetZone, Mode=TwoWay}"
                                                                  DisplayMemberPath="Name" AutomationProperties.Name="Zielzone" controls:Chrome.Placeholder="Zone wählen …">
                                                            <ComboBox.Style>
                                                                <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsTargetMissing}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" /></DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ComboBox.Style>
                                                        </ComboBox>
                                                    </StackPanel>
                                                </Grid>
                                                <TextBlock x:Name="AppRuleTargetStatusText" Text="{Binding TargetStatus}" Style="{StaticResource HelpText}" AutomationProperties.Name="Status des Ziels" />
                                                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,14,0,0" Padding="0,10,0,0">
                                                    <Expander>
                                                        <Expander.Header>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="Fenster eingrenzen" Style="{StaticResource GroupTitle}" />
                                                                <TextBlock Text="Titel · Fensterklasse" Style="{StaticResource HelpText}" Margin="10,0,0,0" />
                                                            </StackPanel>
                                                        </Expander.Header>
                                                        <StackPanel>
                                                            <TextBlock Text="Alle drei Merkmale sind gleichrangige Filter. Leer bedeutet: keine Einschränkung. Mindestens eines der drei muss stehen."
                                                                       Style="{StaticResource HelpText}" Margin="0,0,0,10" />
                                                            <Grid>
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                                <StackPanel>
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="Titel enthält" Style="{StaticResource FieldLabel}" Margin="0" VerticalAlignment="Center" />
                                                                        <Button x:Name="AppRuleTitleInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zum Titelmuster"
                                                                                ToolTip="Verglichen wird der Text in der Titelleiste des Fensters. Es genügt ein Teilstück, Gross- und Kleinschreibung spielen keine Rolle. Beispiel: «Posteingang» trifft das Outlook-Fenster «Posteingang – Buchhaltung», nicht aber ein offenes E-Mail-Fenster. Nützlich, wenn ein Programm mehrere Fensterarten hat und nur eine davon positioniert werden soll. Leer = jeder Titel." />
                                                                    </StackPanel>
                                                                    <TextBox x:Name="AppRuleWindowTitleText" Text="{Binding WindowTitlePattern, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0"
                                                                             controls:Chrome.Placeholder="z. B. «Posteingang»" AutomationProperties.Name="Optionales Fenstertitelmuster" />
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="2">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="Fensterklasse (selten nötig)" Style="{StaticResource FieldLabel}" Margin="0" VerticalAlignment="Center" />
                                                                        <Button x:Name="AppRuleWindowClassInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zur Fensterklasse"
                                                                                ToolTip="Die Fensterklasse ist ein interner Windows-Name, den ein Programm jedem seiner Fenstertypen gibt – zum Beispiel «Chrome_WidgetWin_1» für Chrome-Fenster oder «CabinetWClass» für den Explorer. Anders als der Titel ändert sie sich nicht mit dem Inhalt. Verwende sie, wenn ein Programm Hauptfenster, Dialoge und Popups mischt und nur eine Sorte gemeint ist. Ist dir die Klasse nicht bekannt, lass das Feld leer – es wird selten gebraucht." />
                                                                    </StackPanel>
                                                                    <TextBox x:Name="AppRuleWindowClassText" Text="{Binding WindowClass, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0"
                                                                             controls:Chrome.Placeholder="z. B. «CabinetWClass»" AutomationProperties.Name="Optionale Fensterklasse" />
                                                                </StackPanel>
                                                            </Grid>
                                                            <TextBlock x:Name="AppRuleCriteriaStatusText" Text="{Binding CriteriaStatus}" Style="{StaticResource HelpText}" Foreground="{DynamicResource WarningBrush}"
                                                                       AutomationProperties.Name="Hinweis zu den Erkennungsmerkmalen"
                                                                       Visibility="{Binding CriteriaStatus, Converter={StaticResource NotNullToVisibilityConverter}}" />
                                                        </StackPanel>
                                                    </Expander>
                                                </Border>
                                                <Expander Margin="0,6,0,0">
                                                    <Expander.Header>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="Feinheiten" Style="{StaticResource GroupTitle}" />
                                                            <TextBlock Style="{StaticResource HelpText}" Margin="10,0,0,0">
                                                                <Run Text="Verzögerung" /><Run Text="{Binding DelayMilliseconds, Mode=OneWay}" /><Run Text="ms ·" /><Run Text="{Binding RetryCount, Mode=OneWay}" /><Run Text="Wiederholungen · Priorität" /><Run Text="{Binding Priority, Mode=OneWay}" />
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Expander.Header>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="Verzögerung" Style="{StaticResource FieldLabel}" Margin="0" VerticalAlignment="Center" />
                                                                <Button x:Name="AppRuleDelayInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zur Verzögerung"
                                                                        ToolTip="Wartezeit in Millisekunden zwischen Ereignis und Positionierung. Viele Programme zeichnen ihr Fenster erst nach kurzer Zeit fertig; 200 bis 800 ms helfen dann. Erlaubt sind 0 bis 30000." />
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                                <TextBox x:Name="AppRuleDelayText" Style="{StaticResource NumberField}" Text="{Binding DelayMilliseconds, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Verzögerung in Millisekunden" />
                                                                <TextBlock Text="ms" Style="{StaticResource UnitLabel}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="Wiederholungen" Style="{StaticResource FieldLabel}" Margin="0" VerticalAlignment="Center" />
                                                                <Button x:Name="AppRuleRetryInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zu Wiederholungen"
                                                                        ToolTip="Wie oft die Positionierung wiederholt wird, falls das Programm sein Fenster danach nochmals selbst verschiebt. Erlaubt sind 0 bis 3." />
                                                            </StackPanel>
                                                            <TextBox x:Name="AppRuleRetryText" Style="{StaticResource NumberField}" Text="{Binding RetryCount, UpdateSourceTrigger=LostFocus}" Margin="0,6,0,0" HorizontalAlignment="Left" AutomationProperties.Name="Wiederholungen von null bis drei" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="4">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="Priorität" Style="{StaticResource FieldLabel}" Margin="0" VerticalAlignment="Center" />
                                                                <Button x:Name="AppRulePriorityInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zur Priorität"
                                                                        ToolTip="Treffen mehrere Zuordnungen auf dasselbe Fenster zu, gewinnt die mit der höheren Priorität. Erlaubt sind 0 bis 100, Standard ist 50." />
                                                            </StackPanel>
                                                            <TextBox x:Name="AppRulePriorityText" Style="{StaticResource NumberField}" Text="{Binding Priority, UpdateSourceTrigger=LostFocus}" Margin="0,6,0,0" HorizontalAlignment="Left" AutomationProperties.Name="Priorität von null bis hundert" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Expander>
                                                <Grid Margin="0,16,0,0">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <Button Content="Fertig" Style="{StaticResource PrimaryButton}" Click="AppRuleDone_Click" AutomationProperties.Name="Detail schliessen" />
                                                    <Button x:Name="AppRuleDeleteButton" Grid.Column="1" Content="Zuordnung entfernen" Style="{StaticResource DangerButton}" Margin="10,0,0,0" Click="AppRuleDelete_Click"
                                                            AutomationProperties.Name="Zuordnung entfernen" />
                                                    <TextBlock Grid.Column="2" Text="Wird sofort gespeichert · Entfernen lässt sich rückgängig machen" Style="{StaticResource HelpText}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ========================= In Ruhe lassen ========================= -->
            <TabItem x:Name="ExclusionsTab" Header="In Ruhe lassen" controls:Chrome.Badge="{Binding ExclusionCountText}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="38,30" MinWidth="860" MaxWidth="900" HorizontalAlignment="Left">
                        <TextBlock Text="Fenster in Ruhe lassen" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="Diese Fenster fasst Zone Manager nie an: keine Zonen beim Ziehen, kein Einrasten, keine Zuordnung, keine gemerkte Position. Das gilt vor jeder Zuordnung."
                                   Style="{StaticResource HelpText}" Margin="0,8,0,22" />
                        <Grid x:Name="AppExclusionEmptyState" Visibility="{Binding ExclusionCount, Converter={StaticResource ZeroToVisibilityConverter}}" Margin="0,0,0,8">
                            <Rectangle Stroke="{DynamicResource ControlBorderBrush}" StrokeDashArray="4 3" StrokeThickness="1" RadiusX="8" RadiusY="8" />
                            <StackPanel Margin="32" HorizontalAlignment="Center">
                                <TextBlock Text="Alle Fenster dürfen einrasten" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center" />
                                <TextBlock Text="Wenn ein Programm lieber frei bleiben soll – etwa der Taschenrechner oder ein Videoplayer –, trag es hier ein. Es bekommt dann keine Zonen mehr angezeigt."
                                           Style="{StaticResource HelpText}" TextAlignment="Center" MaxWidth="560" Margin="0,8,0,16" />
                                <Button x:Name="AppExclusionAddFirstButton" Content="+ Programm in Ruhe lassen" Style="{StaticResource PrimaryButton}" Click="AppExclusionAdd_Click" HorizontalAlignment="Center"
                                        AutomationProperties.Name="Programm in Ruhe lassen" />
                            </StackPanel>
                        </Grid>
                        <ItemsControl x:Name="AppExclusionList" ItemsSource="{Binding AppExclusions.ExclusionItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <Border Style="{StaticResource ListRow}">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <ContentPresenter Content="{Binding ProcessPath}" ContentTemplate="{StaticResource ProgramIconTemplate}" />
                                                <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource ListSubtitle}" />
                                                </StackPanel>
                                                <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsEnabled, Mode=OneWay}" Click="AppExclusionEnabled_Click" Margin="0,0,16,0"
                                                          AutomationProperties.Name="{Binding DisplayName, StringFormat=Eintrag {0} ein- oder ausschalten}" />
                                                <Button Grid.Column="3" Content="{Binding ActionLabel}" Style="{StaticResource ListButton}" MinWidth="120" Click="AppExclusionToggleDetail_Click"
                                                        AutomationProperties.Name="{Binding DisplayName, StringFormat=Eintrag {0} eingrenzen}" />
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource SectionCard}" Margin="52,0,0,8" BorderBrush="{DynamicResource ControlBorderBrush}"
                                                Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                DataContext="{Binding DataContext.AppExclusions, RelativeSource={RelativeSource AncestorType=Window}}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding ScopeHint}" Style="{StaticResource HelpText}" Margin="0,0,0,14" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="Titel enthält" Style="{StaticResource FieldLabel}" Margin="0" VerticalAlignment="Center" />
                                                            <Button x:Name="AppExclusionTitleInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zum Titelmuster"
                                                                    ToolTip="Verglichen wird der Text in der Titelleiste des Fensters. Es genügt ein Teilstück, Gross- und Kleinschreibung spielen keine Rolle. Nützlich, wenn ein Programm mehrere Fensterarten hat und nur eine davon frei bleiben soll – etwa ein Vorschaufenster, während das Hauptfenster weiterhin einrastet. «*» und «?» dienen als Platzhalter. Leer = alle Fenster des Programms." />
                                                        </StackPanel>
                                                        <TextBox x:Name="AppExclusionWindowTitleText" Text="{Binding WindowTitlePattern, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0"
                                                                 controls:Chrome.Placeholder="z. B. «Vorschau»" AutomationProperties.Name="Optionales Fenstertitelmuster" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="Fensterklasse (selten nötig)" Style="{StaticResource FieldLabel}" Margin="0" VerticalAlignment="Center" />
                                                            <Button x:Name="AppExclusionWindowClassInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zur Fensterklasse"
                                                                    ToolTip="Die Fensterklasse ist ein interner Windows-Name, den ein Programm jedem seiner Fenstertypen gibt – zum Beispiel «CabinetWClass» für den Explorer. Anders als der Titel ändert sie sich nicht mit dem Inhalt. Verwende sie, wenn ein Programm Hauptfenster, Dialoge und Popups mischt und nur eine Sorte frei bleiben soll. Ist dir die Klasse nicht bekannt, lass das Feld leer." />
                                                        </StackPanel>
                                                        <TextBox x:Name="AppExclusionWindowClassText" Text="{Binding WindowClass, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0"
                                                                 controls:Chrome.Placeholder="z. B. «CabinetWClass»" AutomationProperties.Name="Optionale Fensterklasse" />
                                                    </StackPanel>
                                                </Grid>
                                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                                    <TextBlock Text="Programm" Style="{StaticResource FieldLabel}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                    <TextBox x:Name="AppExclusionProcessPathText" Text="{Binding ProcessPath, UpdateSourceTrigger=PropertyChanged}" MinWidth="320"
                                                             controls:Chrome.Placeholder="Dateiname, z. B. Taschenrechner.exe" AutomationProperties.Name="Prozesspfad oder Dateiname" />
                                                </StackPanel>
                                                <TextBlock x:Name="AppExclusionCriteriaStatusText" Text="{Binding CriteriaStatus}" Style="{StaticResource HelpText}" Foreground="{DynamicResource WarningBrush}"
                                                           AutomationProperties.Name="Status des Eintrags" Visibility="{Binding CriteriaStatus, Converter={StaticResource NotNullToVisibilityConverter}}" />
                                                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                                    <Button Content="Fertig" Style="{StaticResource PrimaryButton}" Click="AppExclusionDone_Click" AutomationProperties.Name="Detail schliessen" />
                                                    <Button x:Name="AppExclusionDeleteButton" Content="Wieder einrasten lassen" Style="{StaticResource DangerButton}" Margin="10,0,0,0" Click="AppExclusionDelete_Click"
                                                            AutomationProperties.Name="Eintrag entfernen, Fenster rastet wieder ein" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button x:Name="AppExclusionAddButton" Style="{StaticResource CardButton}" Click="AppExclusionAdd_Click" Padding="20,14" Background="Transparent"
                                Visibility="{Binding ExclusionCount, Converter={StaticResource NonZeroToVisibilityConverter}}" AutomationProperties.Name="Programm in Ruhe lassen">
                            <Grid>
                                <Rectangle Stroke="{DynamicResource ControlBorderBrush}" StrokeDashArray="4 3" StrokeThickness="1" RadiusX="8" RadiusY="8" Margin="-20,-14" />
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="36" Height="36" CornerRadius="8" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1">
                                        <TextBlock Text="+" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
                                    </Border>
                                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Programm in Ruhe lassen" FontWeight="SemiBold" />
                                        <TextBlock Text="Aus den laufenden Programmen wählen oder eine .exe-Datei angeben" Style="{StaticResource ListSubtitle}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ========================= Verhalten ========================= -->
            <TabItem x:Name="BehaviourTab" Header="Verhalten" controls:Chrome.Group="EINSTELLUNGEN">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="BehaviourContent" Margin="38,30" MinWidth="860" MaxWidth="900" HorizontalAlignment="Left">
                        <TextBlock Text="Verhalten" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="Alle Einstellungen, sofort gespeichert. Das ? neben jeder Einstellung erklärt beim Darüberfahren, was sie tut."
                                   Style="{StaticResource HelpText}" Margin="0,8,0,18" />
                        <TabControl x:Name="BehaviourTabs" Style="{StaticResource SubTabControl}" SelectedIndex="{Binding Settings.BehaviourTabIndex, Mode=TwoWay}">
                            <!-- Beim Ziehen -->
                            <TabItem Header="Beim Ziehen" Style="{StaticResource SubTabItem}">
                                <StackPanel>
                                    <Border Style="{StaticResource SectionCard}" Padding="20,6">
                                        <StackPanel>
                                            <Border Style="{StaticResource SettingRow}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal"><TextBlock Text="Zonen anzeigen auf" Style="{StaticResource SettingLabel}" />
                                                        <Button x:Name="OverlayScopeInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zum Overlaybereich"
                                                                ToolTip="Wo die Zonen erscheinen, wenn du ein Fenster an der Titelleiste ziehst. «Alle Monitore»: überall gleichzeitig. «Monitor beim Ziehbeginn»: nur dort, wo du das Fenster angefasst hast – ziehst du auf einen anderen Bildschirm, siehst du dort keine Zonen. «Monitor unter dem Mauszeiger»: die Zonen wandern mit deiner Maus auf den anderen Bildschirm." /></StackPanel>
                                                    <ComboBox x:Name="OverlayScopeSelector" Grid.Column="1" ItemsSource="{Binding Settings.OverlayScopes}" SelectedItem="{Binding Settings.OverlayScope}" ItemTemplate="{StaticResource EnumItemTemplate}" AutomationProperties.Name="Wo die Zonen beim Ziehen erscheinen" />
                                                </Grid>
                                            </Border>
                                            <Border Style="{StaticResource SettingRow}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal"><TextBlock Text="Zonen einblenden" Style="{StaticResource SettingLabel}" />
                                                        <Button x:Name="TriggerModeInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zur Overlayaktivierung"
                                                                ToolTip="«Sofort»: die Zonen erscheinen bei jedem Ziehen an der Titelleiste. «Nur mit Umschalttaste»: sie erscheinen nur, wenn du beim Ziehen zusätzlich Shift gedrückt hältst – praktisch, wenn du Fenster oft nur kurz verschiebst und keine Zonen aufblitzen sollen." /></StackPanel>
                                                    <ComboBox x:Name="TriggerModeSelector" Grid.Column="1" ItemsSource="{Binding Settings.TriggerModes}" SelectedItem="{Binding Settings.TriggerMode}" ItemTemplate="{StaticResource EnumItemTemplate}" AutomationProperties.Name="Wann die Zonen erscheinen" />
                                                </Grid>
                                            </Border>
                                            <Border Style="{StaticResource SettingRowLast}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal"><TextBlock Text="Zonennamen anzeigen" Style="{StaticResource SettingLabel}" />
                                                        <Button x:Name="ShowZoneNamesInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zu Zonennamen"
                                                                ToolTip="Zeigt beim Ziehen auf jeder Zone ihre Nummer und ihren Namen auf einer kleinen dunklen Fläche, etwa «1 · Links». Die Nummer ist zugleich die Taste des Tastenkürzels. Aus: Kontur und Zielfläche bleiben sichtbar, nur die Beschriftung fehlt." /></StackPanel>
                                                    <CheckBox x:Name="ShowZoneNamesSwitch" Grid.Column="1" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" IsChecked="{Binding Settings.ShowZoneNames}" AutomationProperties.Name="Zonennamen anzeigen" />
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource SectionCard}" Padding="20,14,20,6">
                                        <StackPanel>
                                            <TextBlock Text="Feinabstimmung" Style="{StaticResource GroupTitle}" Margin="0,0,0,4" />
                                            <Border Style="{StaticResource SettingRow}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal"><TextBlock Text="Anzeigeverzögerung" Style="{StaticResource SettingLabel}" />
                                                        <Button x:Name="OverlayDelayInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zu Anzeigeverzögerung"
                                                                ToolTip="Wartezeit in Millisekunden, bis die Zonen erscheinen. Bei 0 sofort. Mit z. B. 300 bleiben kurze Verschiebungen ruhig – die Zonen kommen erst, wenn du länger ziehst; wird vorher losgelassen, bleibt der Bildschirm ruhig. Erlaubt sind 0 bis 1000." /></StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                                        <TextBox x:Name="OverlayShowDelayText" Style="{StaticResource NumberField}" Text="{Binding Settings.OverlayShowDelayMilliseconds}" AutomationProperties.Name="Anzeigeverzögerung der Zonen in Millisekunden" />
                                                        <TextBlock Text="ms" Style="{StaticResource UnitLabel}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <Border Style="{StaticResource SettingRow}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal"><TextBlock Text="Fenster nach dem Einrasten in den Vordergrund holen" Style="{StaticResource SettingLabel}" />
                                                        <Button x:Name="ActivateAfterSnapInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zu Fenster nach dem Einrasten in den Vordergrund holen"
                                                                ToolTip="Ein per Zuordnung, Auffangzone oder Tastenkürzel gesetztes Fenster wird sonst nicht aktiviert, damit dir nichts den Fokus wegnimmt. Eingeschaltet erhält es nach jedem Setzen den Fokus. Aus: das Fenster behält seinen Rang in der Fensterreihenfolge." /></StackPanel>
                                                    <CheckBox x:Name="ActivateAfterSnapSwitch" Grid.Column="1" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" IsChecked="{Binding Settings.ActivateWindowAfterSnap}" AutomationProperties.Name="Fenster nach dem Einrasten aktivieren" />
                                                </Grid>
                                            </Border>
                                            <Border Style="{StaticResource SettingRowLast}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal"><TextBlock Text="Grösse beim Herausziehen wiederherstellen" Style="{StaticResource SettingLabel}" />
                                                        <Button x:Name="RestoreSizeInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zu Grösse beim Herausziehen wiederherstellen"
                                                                ToolTip="Wird ein eingerastetes Fenster aus seiner Zone gezogen und nirgends abgelegt, bekommt es die Grösse zurück, die es vor dem Einrasten hatte. Die neue Position bleibt. Gilt nur für Fenster, die dieses Programm selbst eingerastet hat. Aus: ein herausgezogenes Fenster behält die Zonengrösse." /></StackPanel>
                                                    <CheckBox x:Name="RestoreSizeSwitch" Grid.Column="1" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" IsChecked="{Binding Settings.RestoreSizeWhenLeavingZone}" AutomationProperties.Name="Fenstergrösse beim Verlassen einer Zone wiederherstellen" />
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </TabItem>

                            <!-- Darstellung -->
                            <TabItem Header="Darstellung" Style="{StaticResource SubTabItem}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource SectionCard}" Padding="20,6" VerticalAlignment="Top">
                                        <StackPanel>
                                            <Border Style="{StaticResource SettingRow}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal"><TextBlock Text="Farbe der Zonen" Style="{StaticResource SettingLabel}" />
                                                        <Button x:Name="OverlayColourInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zur Overlayfarbe"
                                                                ToolTip="Die Farbe der Zonenflächen beim Ziehen, als RGB-Wert im Format #RRGGBB oder über das Farbfeld gewählt. Das neutrale Windows-Grau #707070 wirkt ruhig; eine eigene Farbe bleibt möglich. Die Vorschau rechts zeigt die Wirkung sofort." /></StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                        <Button x:Name="OverlayColorPickerButton" Width="36" Height="36" MinHeight="36" Padding="0" Click="OverlayColorPicker_Click" AutomationProperties.Name="Overlayfarbe auswählen" ToolTip="Farbe wählen">
                                                            <Border x:Name="OverlayColorPreview" Width="26" Height="26" CornerRadius="4" Background="{Binding Settings.OverlayColor}" AutomationProperties.Name="Vorschau der Overlayfarbe" />
                                                        </Button>
                                                        <TextBox x:Name="OverlayColorText" Width="150" Margin="8,0,0,0" FontFamily="Cascadia Mono" Text="{Binding Settings.OverlayColor, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Hexwert der Overlayfarbe" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <Border Style="{StaticResource SettingRow}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal"><TextBlock Text="Deckkraft" Style="{StaticResource SettingLabel}" />
                                                        <Button x:Name="OverlayOpacityInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zur Overlaydeckkraft"
                                                                ToolTip="Wie kräftig die Zonenflächen beim Ziehen gefüllt sind. Eine kleine Deckkraft hält das Overlay dezent; die Zielzone wird über die Hervorhebung unten zusätzlich verstärkt. Zulässig sind 8 bis 75 Prozent in ganzen Schritten." /></StackPanel>
                                                    <Grid Grid.Column="1">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                        <Slider x:Name="OverlayOpacitySlider" Minimum="8" Maximum="75" Value="{Binding Settings.OverlayOpacityPercent}" TickFrequency="1" SmallChange="1" LargeChange="10" IsSnapToTickEnabled="True" VerticalAlignment="Center" AutomationProperties.Name="Deckkraft der Zonen" />
                                                        <TextBox x:Name="OverlayOpacityPercentText" Grid.Column="1" Style="{StaticResource NumberField}" Width="70" Margin="8,0,0,0" Text="{Binding Settings.OverlayOpacityPercent, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:0}}" AutomationProperties.Name="Deckkraft in Prozent" />
                                                        <TextBlock Grid.Column="2" Text="%" Style="{StaticResource UnitLabel}" />
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                            <Border Style="{StaticResource SettingRow}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal"><TextBlock Text="Beschriftung" Style="{StaticResource SettingLabel}" />
                                                        <Button x:Name="OverlayLabelStyleInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zu Beschriftung"
                                                                ToolTip="Was auf jeder Zone steht. «Nummer und Name» zeigt «1 · Links»; die Nummer ist zugleich die Taste des Tastenkürzels. «Nur Nummer» hält das Overlay knapp, «Nur Name» lässt die Nummer weg. Ohne «Zonennamen anzeigen» erscheint gar keine Beschriftung." /></StackPanel>
                                                    <ComboBox x:Name="OverlayLabelStyleSelector" Grid.Column="1" ItemsSource="{Binding Settings.OverlayLabelStyles}" SelectedItem="{Binding Settings.OverlayLabelStyle}" ItemTemplate="{StaticResource EnumItemTemplate}" AutomationProperties.Name="Beschriftung der Zonen im Overlay" />
                                                </Grid>
                                            </Border>
                                            <TextBlock Text="Overlay-Stil" Style="{StaticResource GroupTitle}" Margin="0,16,0,4" />
                                            <Border Style="{StaticResource SettingRow}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal"><TextBlock Text="Rahmenbreite" Style="{StaticResource SettingLabel}" />
                                                        <Button x:Name="OverlayBorderInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zu Rahmenbreite"
                                                                ToolTip="Die Konturlinie jeder Zone im Overlay in Pixel. Auf hochauflösenden Monitoren mit 100 Prozent Skalierung ist ein Pixel schnell zu dünn; dann helfen zwei oder drei. Die hervorgehobene Zone ist immer einen Pixel dicker. Zulässig sind 1 bis 6." /></StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                        <TextBox x:Name="OverlayBorderText" Style="{StaticResource NumberField}" Width="80" Text="{Binding Settings.OverlayBorderThickness}" AutomationProperties.Name="Rahmenbreite der Zonen in Pixel" />
                                                        <TextBlock Text="px" Style="{StaticResource UnitLabel}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <Border Style="{StaticResource SettingRow}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal"><TextBlock Text="Eckenradius" Style="{StaticResource SettingLabel}" />
                                                        <Button x:Name="OverlayRadiusInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zu Eckenradius"
                                                                ToolTip="Wie stark die Ecken der Zonenflächen abgerundet sind. 0 zeichnet rechteckige Zonen, grössere Werte weichere Kacheln. Zulässig sind 0 bis 24 Pixel." /></StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                        <TextBox x:Name="OverlayRadiusText" Style="{StaticResource NumberField}" Width="80" Text="{Binding Settings.OverlayCornerRadius}" AutomationProperties.Name="Eckenradius der Zonen in Pixel" />
                                                        <TextBlock Text="px" Style="{StaticResource UnitLabel}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <Border Style="{StaticResource SettingRow}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal"><TextBlock Text="Hervorhebung" Style="{StaticResource SettingLabel}" />
                                                        <Button x:Name="HighlightInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zur Hervorhebung"
                                                                ToolTip="Farbe und Deckkraft der Zielzone, also der Zone unter dem Mauszeiger. Sie kann eine eigene Farbe bekommen, etwa ein kräftiges Blau, während die übrigen Zonen grau bleiben; leer bedeutet dieselbe Farbe wie die übrigen Zonen. Die Voreinstellung 36 Prozent liegt etwas über der Deckkraft der übrigen Zonen. Zulässig sind 10 bis 90 Prozent." /></StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                        <Button x:Name="HighlightColorPickerButton" Width="36" Height="36" MinHeight="36" Padding="0" Click="HighlightColorPicker_Click" AutomationProperties.Name="Farbe der Hervorhebung auswählen" ToolTip="Farbe wählen">
                                                            <Border x:Name="HighlightColorPreview" Width="26" Height="26" CornerRadius="4" Background="{DynamicResource AccentBrush}" />
                                                        </Button>
                                                        <TextBox x:Name="HighlightColorText" Width="110" Margin="8,0,0,0" FontFamily="Cascadia Mono" Text="{Binding Settings.HighlightColor, UpdateSourceTrigger=PropertyChanged}" controls:Chrome.Placeholder="wie Zonen" AutomationProperties.Name="Hexwert der Hervorhebungsfarbe" />
                                                        <TextBox x:Name="HighlightOpacityPercentText" Style="{StaticResource NumberField}" Width="70" Margin="8,0,0,0" Text="{Binding Settings.HighlightOpacityPercent, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:0}}" AutomationProperties.Name="Deckkraft der Hervorhebung in Prozent" />
                                                        <TextBlock Text="%" Style="{StaticResource UnitLabel}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <Border Style="{StaticResource SettingRowLast}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal"><TextBlock Text="Schriftgrösse der Beschriftung" Style="{StaticResource SettingLabel}" />
                                                        <Button x:Name="OverlayFontInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zu Schriftgrösse der Beschriftung"
                                                                ToolTip="Die Schriftgrösse der Beschriftungsfläche in Punkt. Auf grossen oder weit entfernten Monitoren darf sie deutlich grösser sein als die Voreinstellung 13. Zulässig sind 10 bis 24." /></StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                        <TextBox x:Name="OverlayFontSizeText" Style="{StaticResource NumberField}" Width="80" Text="{Binding Settings.OverlayLabelFontSize}" AutomationProperties.Name="Schriftgrösse der Zonenbeschriftung" />
                                                        <TextBlock Text="pt" Style="{StaticResource UnitLabel}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Style="{StaticResource SectionCard}" Padding="16" VerticalAlignment="Top">
                                        <StackPanel>
                                            <TextBlock Text="Vorschau" Style="{StaticResource GroupTitle}" Margin="0,0,0,10" />
                                            <controls:ZonePreview x:Name="OverlayPreview" OverlayMode="True" AspectRatio="1.7778" FrameRadius="8" FramePadding="5" LabelFontSize="10"
                                                                  OverlayColor="{Binding Settings.OverlayColor}" OverlayOpacityPercent="{Binding Settings.OverlayOpacityPercent}"
                                                                  HighlightColor="{Binding Settings.HighlightColor}" HighlightOpacityPercent="{Binding Settings.HighlightOpacityPercent}"
                                                                  OverlayBorderThickness="{Binding Settings.OverlayBorderThickness}" OverlayCornerRadius="{Binding Settings.OverlayCornerRadius}"
                                                                  LabelStyle="{Binding Settings.OverlayLabelStyle}" ShowLabels="{Binding Settings.ShowZoneNames}" />
                                            <TextBlock Text="So sieht das Overlay beim Ziehen aus. Ändert sich live." Style="{StaticResource HelpText}" Margin="0,10,0,0" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </TabItem>

                            <!-- Abstände -->
                            <TabItem Header="Abstände" Style="{StaticResource SubTabItem}">
                                <Border Style="{StaticResource SectionCard}" Padding="20,6">
                                    <StackPanel>
                                        <Border Style="{StaticResource SettingRow}">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal"><TextBlock Text="Abstand zum Bildschirmrand" Style="{StaticResource SettingLabel}" />
                                                    <Button x:Name="OuterMarginsInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zu äusseren Abständen"
                                                            ToolTip="Wie weit die Zonen vom Bildschirmrand entfernt bleiben, in Pixel und je Seite: Links · Oben · Rechts · Unten. Gilt für die Vorschau beim Ziehen und für das Fenster, das dort landet – beides zeigt dieselbe Fläche. Beispiel: 8 lässt rundum einen schmalen Rand frei. Zulässig sind 0 bis 400." /></StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <TextBox x:Name="OuterMarginLeftText" Style="{StaticResource NumberField}" Width="70" Text="{Binding Settings.OuterMarginLeft, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Overlay-Abstand links in Pixel" ToolTip="Links" />
                                                    <TextBox x:Name="OuterMarginTopText" Style="{StaticResource NumberField}" Width="70" Margin="6,0,0,0" Text="{Binding Settings.OuterMarginTop, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Overlay-Abstand oben in Pixel" ToolTip="Oben" />
                                                    <TextBox x:Name="OuterMarginRightText" Style="{StaticResource NumberField}" Width="70" Margin="6,0,0,0" Text="{Binding Settings.OuterMarginRight, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Overlay-Abstand rechts in Pixel" ToolTip="Rechts" />
                                                    <TextBox x:Name="OuterMarginBottomText" Style="{StaticResource NumberField}" Width="70" Margin="6,0,0,0" Text="{Binding Settings.OuterMarginBottom, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Overlay-Abstand unten in Pixel" ToolTip="Unten" />
                                                    <TextBlock Text="px" Style="{StaticResource UnitLabel}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource SettingRow}">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="320" /></Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal"><TextBlock Text="Abstand zwischen Zonen" Style="{StaticResource SettingLabel}" />
                                                    <Button x:Name="ZoneGapInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zum Zonenabstand"
                                                            ToolTip="Der zusätzliche Abstand zwischen benachbarten Zonen. Er gilt für Overlay und Fenster gleich: ein Fenster landet genau auf der Fläche, die das Overlay zeigt. Die Zonen selbst bleiben in Prozent des Monitors definiert; der Abstand wird davon abgezogen. 100 Prozent entsprechen 80 Pixel; bei 0 behält das Overlay seinen visuellen Mindestabstand." /></StackPanel>
                                                <Grid Grid.Column="1">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <Slider x:Name="ZoneGapSlider" Minimum="0" Maximum="100" Value="{Binding Settings.ZoneGapPercent}" TickFrequency="1" SmallChange="1" LargeChange="10" IsSnapToTickEnabled="True" VerticalAlignment="Center" AutomationProperties.Name="Abstand zwischen Zonen" />
                                                    <TextBox x:Name="ZoneGapPercentText" Grid.Column="1" Style="{StaticResource NumberField}" Width="70" Margin="8,0,0,0" Text="{Binding Settings.ZoneGapPercent, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:0}}" AutomationProperties.Name="Zonenabstand in Prozent" />
                                                    <TextBlock Grid.Column="2" Text="%" Style="{StaticResource UnitLabel}" />
                                                    <TextBlock Grid.Column="3" Text="{Binding Settings.ZoneGap, StringFormat={}≙ {0} px}" Style="{StaticResource HelpText}" Margin="10,0,0,0" VerticalAlignment="Center" MinWidth="60" />
                                                </Grid>
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource SettingRowLast}">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="320" /></Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal"><TextBlock Text="Andocken im Editor" Style="{StaticResource SettingLabel}" />
                                                    <Button x:Name="MagnetDistanceInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zum Andocken im Editor"
                                                            ToolTip="Ab welchem Abstand eine gezogene Kante im Editor an Monitor- oder Zonenkanten andockt; blaue Hilfslinien zeigen es. Beispiel: mit 25 Prozent rastet eine Kante ein, sobald sie zehn Pixel von einer anderen entfernt ist. 0 schaltet es aus; Alt pausiert es beim Ziehen. 100 Prozent entsprechen 40 Pixel." /></StackPanel>
                                                <Grid Grid.Column="1">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <Slider x:Name="MagnetThresholdSlider" Minimum="0" Maximum="100" Value="{Binding Settings.MagnetThresholdPercent}" TickFrequency="1" SmallChange="1" LargeChange="10" IsSnapToTickEnabled="True" VerticalAlignment="Center" AutomationProperties.Name="Andocken im Editor" />
                                                    <TextBox x:Name="MagnetThresholdPercentText" Grid.Column="1" Style="{StaticResource NumberField}" Width="70" Margin="8,0,0,0" Text="{Binding Settings.MagnetThresholdPercent, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:0}}" AutomationProperties.Name="Andocken im Editor in Prozent" />
                                                    <TextBlock Grid.Column="2" Text="%" Style="{StaticResource UnitLabel}" />
                                                    <TextBlock Grid.Column="3" Text="{Binding Settings.MagnetThresholdPixels, StringFormat={}≙ {0} px}" Style="{StaticResource HelpText}" Margin="10,0,0,0" VerticalAlignment="Center" MinWidth="60" />
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </TabItem>

                            <!-- Fenster merken -->
                            <TabItem Header="Fenster merken" Style="{StaticResource SubTabItem}">
                                <StackPanel>
                                    <Border Style="{StaticResource SectionCard}" Padding="20,6">
                                        <StackPanel>
                                            <Border Style="{StaticResource SettingRow}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal"><TextBlock Text="Fensterpositionen merken" Style="{StaticResource SettingLabel}" />
                                                            <Button x:Name="RememberWindowPositionsInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zum Merken von Fensterpositionen"
                                                                    ToolTip="Jedes Fenster, das du einmal in eine Zone gesetzt hast, kehrt beim nächsten Öffnen dorthin zurück – auch nach einem Auflösungswechsel, dann wird die Lage anteilig umgerechnet. Erkannt wird ein Fenster an Programm, Fensterklasse und Fensterart, nicht am Titel; mehrere Fenster desselben Programms teilen sich deshalb einen Eintrag. In Ruhe gelassene Fenster werden nie gemerkt." /></StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                            <TextBlock Text="{Binding RememberedWindowSummary}" Style="{StaticResource HelpText}" Margin="0" AutomationProperties.Name="Anzahl gemerkter Fensterpositionen" />
                                                            <Button x:Name="ForgetWindowPositionsButton" Content="alle verwerfen" Style="{StaticResource LinkButton}" Margin="8,0,0,0" Click="ForgetWindowPositions_Click"
                                                                    IsEnabled="{Binding HasRememberedWindows}" AutomationProperties.Name="Gemerkte Fensterpositionen verwerfen"
                                                                    ToolTip="Löscht sämtliche gemerkten Positionen. Danach erscheint jedes Fenster wieder dort, wo Windows selbst es platziert. Rückgängig über den Hinweis unten." />
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <CheckBox x:Name="RememberWindowPositionsCheckBox" Grid.Column="1" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" IsChecked="{Binding Settings.RememberWindowPositions}" AutomationProperties.Name="Fensterpositionen merken" />
                                                </Grid>
                                            </Border>
                                            <Border Style="{StaticResource SettingRowLast}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal"><TextBlock Text="Vollbild in der Zone halten" Style="{StaticResource SettingLabel}" />
                                                        <Button x:Name="ZoneFullscreenInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zu Vollbild in der Zone halten"
                                                                ToolTip="Schaltest du z. B. ein YouTube-Video auf Vollbild, füllt es nur die Zone, in der sein Fenster lag – der Rest des Bildschirms bleibt frei. Der Player merkt davon nichts und legt seine Bedienelemente auf die kleinere Fläche aus. Gilt nur für Fenster, die vorher in einer Zone lagen; ein frei abgelegtes Fenster geht weiterhin auf den ganzen Monitor. Spiele im Exklusivvollbild erreicht es nicht: deren Bildschirmmodus vergibt der Grafiktreiber." /></StackPanel>
                                                    <CheckBox x:Name="ZoneFullscreenCheckBox" Grid.Column="1" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" IsChecked="{Binding Settings.ZoneFullscreen}" AutomationProperties.Name="Vollbild in der Zone halten" />
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource SectionCard}" Padding="20,14,20,6">
                                        <StackPanel>
                                            <TextBlock Text="Feinabstimmung Platzieren" Style="{StaticResource GroupTitle}" Margin="0,0,0,4" />
                                            <Border Style="{StaticResource SettingRow}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal"><TextBlock Text="Fenster mit fester Grösse" Style="{StaticResource SettingLabel}" />
                                                        <Button x:Name="FixedSizeInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zu Fenster mit fester Grösse"
                                                                ToolTip="Ein Fenster, dessen Grösse sich nicht ändern lässt – etwa ein Dialog –, kann eine Zone nicht füllen. Zentrieren legt es mittig in die Zone, oben links richtet es an der Ecke aus, nicht anfassen lässt es liegen und meldet das in der Statuszeile." /></StackPanel>
                                                    <ComboBox Grid.Column="1" ItemsSource="{Binding Settings.FixedSizeWindowPlacements}" SelectedItem="{Binding Settings.FixedSizeWindowPlacement}" ItemTemplate="{StaticResource EnumItemTemplate}" AutomationProperties.Name="Behandlung von Fenstern mit fester Grösse" />
                                                </Grid>
                                            </Border>
                                            <Border Style="{StaticResource SettingRow}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal"><TextBlock Text="Toleranz beim Nachmessen" Style="{StaticResource SettingLabel}" />
                                                        <Button x:Name="PlacementToleranceInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zu Toleranz beim Nachmessen"
                                                                ToolTip="Nach jedem Setzen wird das Fenster nachgemessen. Weicht es um mehr als diese Pixel von der Zielfläche ab, folgt ein zweiter Anlauf und danach eine Meldung. Manche Programme runden auf ganze Zeichen oder Rasterzellen; dann hilft ein grösserer Wert. Zulässig sind 0 bis 10, Voreinstellung 2." /></StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"><TextBox Style="{StaticResource NumberField}" Text="{Binding Settings.PlacementTolerancePixels}" AutomationProperties.Name="Toleranz beim Nachmessen in Pixel" /><TextBlock Text="px" Style="{StaticResource UnitLabel}" /></StackPanel>
                                                </Grid>
                                            </Border>
                                            <Border Style="{StaticResource SettingRow}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal"><TextBlock Text="Toleranz für «eingerastet»" Style="{StaticResource SettingLabel}" />
                                                        <Button x:Name="SnappedToleranceInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zu Toleranz für «eingerastet»"
                                                                ToolTip="So nah müssen alle vier Kanten eines Fensters an den Zonenkanten liegen, damit es als eingerastet gilt und von Auffangzone und Layoutwechsel in Ruhe gelassen wird. Der unsichtbare Fensterrand von Windows macht bis zu 16 Pixel aus; 40 lässt Spielraum. Zulässig sind 8 bis 80." /></StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"><TextBox Style="{StaticResource NumberField}" Text="{Binding Settings.SnappedTolerancePixels}" AutomationProperties.Name="Toleranz für eingerastete Fenster in Pixel" /><TextBlock Text="px" Style="{StaticResource UnitLabel}" /></StackPanel>
                                                </Grid>
                                            </Border>
                                            <Border Style="{StaticResource SettingRow}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal"><TextBlock Text="Neue Fenster in der Auffangzone auffangen" Style="{StaticResource SettingLabel}" />
                                                        <Button x:Name="CatchNewWindowsInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zu Neue Fenster in der Auffangzone auffangen"
                                                                ToolTip="Ein neu erscheinendes Fenster ohne Zuordnung und ohne gemerkte Position landet in der Auffangzone, sofern eine festgelegt ist. Aus: es bleibt dort, wo Windows es hinsetzt; die Auffangzone dient dann nur noch dem Einsammeln beim Layoutwechsel." /></StackPanel>
                                                    <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" IsChecked="{Binding Settings.CatchNewWindowsInMainZone}" AutomationProperties.Name="Neue Fenster in der Auffangzone auffangen" />
                                                </Grid>
                                            </Border>
                                            <Border Style="{StaticResource SettingRow}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal"><TextBlock Text="Gemerkte Zone vor gemerkter Lage" Style="{StaticResource SettingLabel}" />
                                                        <Button x:Name="PreferZoneInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zu Gemerkte Zone vor gemerkter Lage"
                                                                ToolTip="Eingeschaltet kehrt ein gemerktes Fenster in seine Zone zurück, auch wenn sich deren Fläche inzwischen geändert hat. Aus: die gemerkte Lage in Pixeln zählt, ein Fenster kehrt pixelgenau an seine letzte Stelle zurück; die Zone dient nur noch zur Monitorsuche." /></StackPanel>
                                                    <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" IsChecked="{Binding Settings.PreferRememberedZone}" AutomationProperties.Name="Gemerkte Zone bevorzugen" />
                                                </Grid>
                                            </Border>
                                            <Border Style="{StaticResource SettingRow}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal"><TextBlock Text="Maximierte Fenster maximiert wiederherstellen" Style="{StaticResource SettingLabel}" />
                                                        <Button x:Name="RestoreMaximizedInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zu Maximierte Fenster maximiert wiederherstellen"
                                                                ToolTip="War ein Fenster beim Merken maximiert, wird es beim nächsten Öffnen wieder maximiert, sofern es gerade im Vordergrund ist. Aus: gemerkt maximierte Fenster erscheinen in Normalgrösse an ihrer Normalposition." /></StackPanel>
                                                    <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" IsChecked="{Binding Settings.RestoreMaximizedWindows}" AutomationProperties.Name="Maximierte Fenster wiederherstellen" />
                                                </Grid>
                                            </Border>
                                            <Border Style="{StaticResource SettingRow}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal"><TextBlock Text="Katalog gemerkter Positionen" Style="{StaticResource SettingLabel}" />
                                                        <Button x:Name="CatalogLimitInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zu Katalog gemerkter Positionen"
                                                                ToolTip="So viele Fensterpositionen hält das Programm höchstens; die ältesten fallen zuerst weg. Wer sehr viele verschiedene Programme benutzt, erhöht den Wert; die Datei bleibt auch bei 2000 Einträgen klein. Zulässig sind 50 bis 2000, Voreinstellung 500." /></StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"><TextBox Style="{StaticResource NumberField}" Text="{Binding Settings.RememberedWindowLimit}" AutomationProperties.Name="Höchstzahl gemerkter Fensterpositionen" /><TextBlock Text="Einträge" Style="{StaticResource UnitLabel}" /></StackPanel>
                                                </Grid>
                                            </Border>
                                            <Border Style="{StaticResource SettingRow}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal"><TextBlock Text="Wartezeit vor dem Beurteilen neuer Fenster" Style="{StaticResource SettingLabel}" />
                                                        <Button x:Name="SettleDelayInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zu Wartezeit vor dem Beurteilen neuer Fenster"
                                                                ToolTip="Manche Programme bauen ihr Fenster erst einige hundert Millisekunden nach dem Erscheinen fertig auf und ändern dabei Grösse und Titel. Eine Wartezeit lässt das Programm erst danach entscheiden, ob es das Fenster zurücklegt oder auffängt. Zulässig sind 0 bis 2000 Millisekunden, Voreinstellung 0." /></StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"><TextBox Style="{StaticResource NumberField}" Text="{Binding Settings.NewWindowSettleDelayMilliseconds}" AutomationProperties.Name="Wartezeit vor dem Beurteilen neuer Fenster in Millisekunden" /><TextBlock Text="ms" Style="{StaticResource UnitLabel}" /></StackPanel>
                                                </Grid>
                                            </Border>
                                            <Border Style="{StaticResource SettingRowLast}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal"><TextBlock Text="Abstand zwischen Regelversuchen" Style="{StaticResource SettingLabel}" />
                                                        <Button x:Name="RuleRetryInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zu Abstand zwischen Regelversuchen"
                                                                ToolTip="Lehnt Windows das Setzen ab, wiederholt eine Zuordnung den Versuch so oft, wie in ihren Feinheiten eingestellt, und wartet dazwischen diese Zeit. Programme, die ihr Fenster spät freigeben, brauchen längere Abstände. Zulässig sind 50 bis 2000 Millisekunden, Voreinstellung 250." /></StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"><TextBox Style="{StaticResource NumberField}" Text="{Binding Settings.RuleRetryDelayMilliseconds}" AutomationProperties.Name="Abstand zwischen Regelversuchen in Millisekunden" /><TextBlock Text="ms" Style="{StaticResource UnitLabel}" /></StackPanel>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource SectionCard}" Padding="20,14,20,6">
                                        <StackPanel>
                                            <TextBlock Text="Schutz und Zeiten" Style="{StaticResource GroupTitle}" Margin="0,0,0,4" />
                                            <Border Style="{StaticResource SettingRow}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal"><TextBlock Text="Schutzschalter des Verschiebe-Hooks" Style="{StaticResource SettingLabel}" />
                                                        <Button x:Name="MoveHookLimitInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zu Schutzschalter des Verschiebe-Hooks"
                                                                ToolTip="Meldet Windows innerhalb von zehn Sekunden mehr Verschiebe-Ereignisse als hier erlaubt, hält das Programm das Einrasten an und zeigt das in der Statuszeile. Jeder Ziehvorgang liefert zwei Ereignisse; 400 erreicht niemand von Hand. Wer Fenster per Skript bewegt, setzt die Grenze höher. Zulässig sind 100 bis 5000." /></StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"><TextBox Style="{StaticResource NumberField}" Text="{Binding Settings.MoveHookEventLimit}" AutomationProperties.Name="Ereignisgrenze des Schutzschalters in zehn Sekunden" /><TextBlock Text="Ereignisse" Style="{StaticResource UnitLabel}" /></StackPanel>
                                                </Grid>
                                            </Border>
                                            <Border Style="{StaticResource SettingRow}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal"><TextBlock Text="Wachhund für hängende Ziehvorgänge" Style="{StaticResource SettingLabel}" />
                                                        <Button x:Name="WatchdogInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zu Wachhund für hängende Ziehvorgänge"
                                                                ToolTip="Bleibt das Endereignis eines Ziehvorgangs aus, zieht das Programm die Zonen nach dieser Zeit ein, was auch immer Windows meldet. Wer Fenster sehr lange gedrückt hält, erhöht den Wert. Zulässig sind 5 bis 600 Sekunden, Voreinstellung 120." /></StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"><TextBox Style="{StaticResource NumberField}" Text="{Binding Settings.DragWatchdogSeconds}" AutomationProperties.Name="Wachhund für Ziehvorgänge in Sekunden" /><TextBlock Text="s" Style="{StaticResource UnitLabel}" /></StackPanel>
                                                </Grid>
                                            </Border>
                                            <Border Style="{StaticResource SettingRowLast}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal"><TextBlock Text="Versuche beim Zonen-Vollbild" Style="{StaticResource SettingLabel}" />
                                                        <Button x:Name="ZoneFullscreenCorrectionsInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zu Versuche beim Zonen-Vollbild"
                                                                ToolTip="So oft wird ein Fenster je Vollbildsitzung in seine Zone zurückgeholt, bevor das Programm es aufgibt und ihm den ganzen Monitor lässt. Mehrere Versuche sind nötig, weil manche Player ihr Fenster nach dem Umschalten noch einmal selbst setzen; die Grenze verhindert einen Dauerkampf. Zulässig sind 1 bis 20, Voreinstellung 5." /></StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"><TextBox Style="{StaticResource NumberField}" Text="{Binding Settings.ZoneFullscreenMaxCorrections}" AutomationProperties.Name="Versuche beim Zonen-Vollbild je Sitzung" /><TextBlock Text="Versuche" Style="{StaticResource UnitLabel}" /></StackPanel>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </TabItem>

                            <!-- Tastenkürzel -->
                            <TabItem Header="Tastenkürzel" Style="{StaticResource SubTabItem}">
                                <Border Style="{StaticResource SectionCard}" Padding="20,6,20,16">
                                    <StackPanel>
                                        <Border Style="{StaticResource SettingRow}">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal"><TextBlock Text="Zonenkürzel aktiv" Style="{StaticResource SettingLabel}" />
                                                    <Button x:Name="ZoneHotkeysEnabledInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zu Zonenkürzel aktiv"
                                                            ToolTip="Schaltet die Kürzel für Zone weiter, zurück, nach Nummer und vorherige Position gemeinsam ein oder aus. Sie wirken auf das Fenster im Vordergrund und nur, solange das Einrasten aktiv ist. Sinnvoll auszuschalten, wenn ein anderes Programm dieselben Kombinationen braucht. Aus: nur der Not-Aus bleibt registriert." /></StackPanel>
                                                <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" IsChecked="{Binding Settings.ZoneHotkeysEnabled}" AutomationProperties.Name="Zonenkürzel aktivieren" />
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource SettingRowLast}">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal"><TextBlock Text="Zusatztasten" Style="{StaticResource SettingLabel}" />
                                                        <Button x:Name="ZoneHotkeyModifiersInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zu Zusatztasten"
                                                                ToolTip="Die Tasten, die du zu Pfeil, Ziffer oder Rücktaste gedrückt hältst. Windows belegt viele Kombinationen mit der Win-Taste selbst; Ctrl + Shift ist deshalb die Voreinstellung. Ctrl + Alt ist nicht zu empfehlen: Windows liefert AltGr intern als Ctrl + Alt, sodass die Zifferkürzel die AltGr-Zeichen derselben Tasten verschlucken. Belegt ein anderes Programm ein Kürzel, meldet die Statuszeile das beim Start. Der Not-Aus bleibt immer bei Ctrl + Alt + Shift + F12." /></StackPanel>
                                                    <ComboBox Grid.Column="1" ItemsSource="{Binding Settings.ZoneHotkeyModifierChoices}" SelectedItem="{Binding Settings.ZoneHotkeyModifiers}" ItemTemplate="{StaticResource EnumItemTemplate}" AutomationProperties.Name="Zusatztasten der Zonenkürzel" />
                                                </Grid>
                                                <Border Style="{StaticResource WarningBox}" Margin="0,10,0,0" Visibility="{Binding Settings.ZoneHotkeyModifiersBlockAltGr, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" FontSize="14" AutomationProperties.Name="Warnung zu Ctrl + Alt"
                                                               Text="Ctrl + Alt blockiert AltGr: Windows erzeugt aus AltGr intern Ctrl + Alt, deshalb verschlucken die Kürzel Ctrl + Alt + 1 bis 9 die AltGr-Zeichen derselben Tasten — auf einer Schweizer Tastatur @, # und |, auf einer deutschen {, [ und ]. Wähle Ctrl + Shift, Alt + Shift oder Ctrl + Win, wenn du diese Zeichen tippst." />
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                        <Grid Margin="0,16,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition Height="36" /><RowDefinition Height="36" /><RowDefinition Height="36" /><RowDefinition Height="36" /><RowDefinition Height="36" /></Grid.RowDefinitions>
                                            <Border Grid.Row="0" Style="{StaticResource MonoChip}" HorizontalAlignment="Left"><TextBlock FontFamily="Cascadia Mono" FontSize="14" Text="{Binding Settings.ZoneHotkeyModifierLabel, StringFormat={}{0} + ← / →}" /></Border>
                                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Fenster eine Zone zurück oder weiter, über Monitorgrenzen hinweg." FontSize="15" VerticalAlignment="Center" TextWrapping="Wrap" />
                                            <Border Grid.Row="1" Style="{StaticResource MonoChip}" HorizontalAlignment="Left"><TextBlock FontFamily="Cascadia Mono" FontSize="14" Text="{Binding Settings.ZoneHotkeyModifierLabel, StringFormat={}{0} + 1 … 9}" /></Border>
                                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Fenster in die Zone mit dieser Nummer auf seinem Monitor." FontSize="15" VerticalAlignment="Center" TextWrapping="Wrap" />
                                            <Border Grid.Row="2" Style="{StaticResource MonoChip}" HorizontalAlignment="Left"><TextBlock FontFamily="Cascadia Mono" FontSize="14" Text="{Binding Settings.ZoneHotkeyModifierLabel, StringFormat={}{0} + ⌫}" /></Border>
                                            <TextBlock Grid.Row="2" Grid.Column="2" Text="Fenster zurück an die Stelle vor dem letzten Einrasten." FontSize="15" VerticalAlignment="Center" TextWrapping="Wrap" />
                                            <Border Grid.Row="3" Style="{StaticResource MonoChip}" HorizontalAlignment="Left"><TextBlock FontFamily="Cascadia Mono" FontSize="14" Text="Ctrl + Alt + Shift + F12" /></Border>
                                            <TextBlock Grid.Row="3" Grid.Column="2" Text="Not-Aus: Einrasten anhalten und wieder starten." FontSize="15" VerticalAlignment="Center" TextWrapping="Wrap" />
                                            <Border Grid.Row="4" Style="{StaticResource MonoChip}" HorizontalAlignment="Left"><TextBlock FontFamily="Cascadia Mono" FontSize="14" Text="Strg + Z / Y" /></Border>
                                            <TextBlock Grid.Row="4" Grid.Column="2" Text="Im Layouteditor: zurücknehmen und wiederherstellen." FontSize="15" VerticalAlignment="Center" TextWrapping="Wrap" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </TabItem>
                        </TabControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ========================= Programm ========================= -->
            <TabItem x:Name="ProgramTab" Header="Programm">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="SettingsContent" Margin="38,30" MinWidth="860" MaxWidth="900" HorizontalAlignment="Left">
                        <TextBlock Text="Programm" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="Erscheinungsbild, Autostart, Updates, Rechte und Sicherung. Änderungen werden sofort gespeichert."
                                   Style="{StaticResource HelpText}" Margin="0,8,0,22" />
                        <Border Style="{StaticResource SectionCard}" Padding="20,6">
                            <StackPanel>
                                <Border Style="{StaticResource SettingRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="Erscheinungsbild" Style="{StaticResource SettingLabel}" />
                                            <Button x:Name="ThemeInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zum Theme"
                                                    ToolTip="Folgt Windows oder ist fest hell oder dunkel. «Windows-System» übernimmt automatisch den App-Modus von Windows und wechselt mit ihm; «Hell» oder «Dunkel» überschreibt diese Wahl nur für Zone Manager." /></StackPanel>
                                        <ComboBox x:Name="ThemeSelector" Grid.Column="1" ItemsSource="{Binding Settings.ThemeModes}" SelectedItem="{Binding Settings.ThemeMode}" ItemTemplate="{StaticResource EnumItemTemplate}" SelectionChanged="Theme_SelectionChanged" AutomationProperties.Name="Erscheinungsbild" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="Mit Windows starten" Style="{StaticResource SettingLabel}" />
                                            <Button x:Name="StartWithWindowsInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zum Autostart"
                                                    ToolTip="Startet das Programm nach der Windows-Anmeldung automatisch, ohne UAC-Abfrage: dafür legt es eine Anmeldeaufgabe der Windows-Aufgabenplanung nur für den aktuellen Benutzer an, die das Programm bereits erhöht startet. Ein Windows-Dienst und ein Treiber werden nicht gebraucht. Lässt sich die Aufgabe nicht anlegen, weicht das Programm auf den Registry-Eintrag aus; dann erscheint die Abfrage bei jeder Anmeldung wieder." /></StackPanel>
                                        <CheckBox x:Name="StartWithWindowsCheckBox" Grid.Column="1" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" IsChecked="{Binding Settings.StartWithWindows}" AutomationProperties.Name="Mit Windows starten" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="Updates" Style="{StaticResource SettingLabel}" />
                                                <Button x:Name="UpdateInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zu Updates"
                                                        ToolTip="Die Suche fragt die Veröffentlichungen des Projekts ab und sendet dabei nichts ausser der Anfrage selbst – keine Version, keine Rechnerkennung, keine Zählung. Sie ist deshalb voreingestellt aus und läuft sonst nur, wenn du sie selbst anstösst. Heruntergeladen wird ausschliesslich aus der Release-Ablage des Projekts über HTTPS und per SHA-256 geprüft; ein Verweis auf eine andere Adresse wird abgelehnt." /></StackPanel>
                                            <TextBlock x:Name="UpdateStatusText" Text="{Binding UpdateSummary}" Style="{StaticResource HelpText}" Margin="0,4,0,0" AutomationProperties.Name="Ergebnis der Updatesuche" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                            <TextBlock Text="beim Start" Style="{StaticResource HelpText}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <CheckBox x:Name="CheckForUpdatesOnStartCheckBox" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Settings.CheckForUpdatesOnStart}" AutomationProperties.Name="Beim Start nach Updates suchen" />
                                            <Button x:Name="CheckForUpdatesButton" Content="Jetzt suchen" Click="CheckForUpdates_Click" Margin="12,0,0,0" IsEnabled="{Binding CanCheckForUpdates}" AutomationProperties.Name="Nach Updates suchen" />
                                            <Button x:Name="InstallUpdateButton" Content="Installieren und neu starten" Style="{StaticResource PrimaryButton}" Click="InstallUpdate_Click" Margin="8,0,0,0"
                                                    IsEnabled="{Binding CanInstallUpdate}" Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    AutomationProperties.Name="Update installieren und neu starten"
                                                    ToolTip="Lädt die neue Programmdatei, legt sie an die Stelle der laufenden und startet das Programm neu. Die bisherige Datei bleibt bis zum nächsten Start als Sicherung daneben liegen." />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="Administratorrechte" Style="{StaticResource SettingLabel}" />
                                                <Button x:Name="ElevationInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zu den Rechten"
                                                        ToolTip="Windows teilt laufende Programme in Vertrauensstufen ein und lässt ein Programm nur Fenster verschieben, die nicht höher berechtigt sind. Für Fenster wie Taskmanager, Registrierungs-Editor oder «als Administrator» gestartete Programme braucht Zone Manager selbst Administratorrechte. «Nur wenn nötig» startet ohne Abfrage und fragt höchstens einmal je Sitzung – und nur, wenn so ein Fenster tatsächlich im Weg war; ein Fehler im Programm kann sich so nicht zu Administratorrechten ausweiten. «Immer beim Start» fragt einmal beim Start, danach nie mehr. Die Umstellung wirkt beim nächsten Start." /></StackPanel>
                                            <TextBlock x:Name="ElevationHintText" Style="{StaticResource HelpText}" Margin="0,4,0,0" AutomationProperties.Name="Hinweis zur Wirksamkeit"
                                                       Text="Die Umstellung wirkt beim nächsten Start. Ist der Autostart eingeschaltet, wird die Anmeldeaufgabe mit umgestellt." />
                                        </StackPanel>
                                        <ComboBox x:Name="ElevationModeSelector" Grid.Column="1" VerticalAlignment="Top" ItemsSource="{Binding Settings.ElevationModes}" SelectedItem="{Binding Settings.ElevationMode}" ItemTemplate="{StaticResource EnumItemTemplate}" AutomationProperties.Name="Wann Administratorrechte angefordert werden" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="Installation" Style="{StaticResource SettingLabel}" />
                                                <Button x:Name="InstallInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zur Installation"
                                                        ToolTip="Ohne Installation läuft das Programm aus dem Ordner, in dem die Datei liegt – das genügt, ist aber im Downloadordner unaufgeräumt. Installiert heisst: die Programmdatei liegt unter «Programme», es gibt eine Verknüpfung im Startmenü und einen Eintrag in «Apps und Features», über den es sich wie jedes andere Programm entfernen lässt. Die Einstellungen unter %APPDATA%\SnapZones bleiben dabei erhalten." /></StackPanel>
                                            <TextBlock x:Name="InstallationStatusText" Text="{Binding InstallationStatus}" Style="{StaticResource HelpText}" Margin="0,4,0,0" AutomationProperties.Name="Installationsstatus" />
                                        </StackPanel>
                                        <Button x:Name="InstallButton" Grid.Column="1" Content="Nach «Programme» installieren" Click="Install_Click" VerticalAlignment="Top" IsEnabled="{Binding CanInstall}" AutomationProperties.Name="Nach Programme installieren" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="Sicherung" Style="{StaticResource SettingLabel}" />
                                            <Button x:Name="BackupInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zur Sicherung"
                                                    ToolTip="Eine JSON-Datei mit allen Layouts, Zuordnungen und Einstellungen. Exportieren schreibt sie, etwa um sie auf einen zweiten Rechner mitzunehmen. Importieren prüft die Datei vollständig, zeigt den Ersetzungsumfang und sichert den bisherigen Stand unmittelbar vor der bestätigten Übernahme." /></StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button x:Name="ExportConfigurationButton" Content="Exportieren" Click="ExportConfiguration_Click" AutomationProperties.Name="Vollständig exportieren" />
                                            <Button x:Name="ImportConfigurationButton" Content="Importieren" Click="ImportConfiguration_Click" Margin="8,0,0,0" AutomationProperties.Name="Vollständig importieren" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingRowLast}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="Frühere Stände" Style="{StaticResource SettingLabel}" />
                                            <Button x:Name="BackupsInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zu früheren Ständen"
                                                    ToolTip="Zone Manager behält automatisch die letzten fünf Stände deiner Einstellungen. Hast du etwas verstellt, holst du hier einen früheren Stand zurück – der aktuelle wird dabei selbst als Stand gesichert, und der Hinweis unten bietet Rückgängig." />
                                            <TextBlock Text="automatisch, die letzten fünf" Style="{StaticResource HelpText}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <ItemsControl x:Name="BackupList" ItemsSource="{Binding Backups}" Margin="0,10,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource FieldGroup}" Padding="12,8" Margin="0,0,0,6">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding WhenText}" FontFamily="Cascadia Mono" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" MinWidth="120" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Summary}" Style="{StaticResource HelpText}" Margin="12,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                            <Button Grid.Column="2" Content="Wiederherstellen" Style="{StaticResource CompactButton}" Click="RestoreBackup_Click" IsEnabled="{Binding CanRestore}"
                                                                    AutomationProperties.Name="{Binding WhenText, StringFormat=Stand {0} wiederherstellen}" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="Noch keine Sicherung vorhanden – sie entsteht beim ersten Speichern einer Änderung." Style="{StaticResource HelpText}" Margin="0,8,0,0"
                                                   Visibility="{Binding Backups.Count, Converter={StaticResource ZeroToVisibilityConverter}}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                        <Grid Margin="0,0,0,12">
                            <Rectangle Stroke="{DynamicResource ControlBorderBrush}" StrokeDashArray="4 3" StrokeThickness="1" RadiusX="8" RadiusY="8" />
                            <Grid Margin="20,16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Erweitert: Fensterhelfer ohne Administratorrechte" Style="{StaticResource SettingLabel}" />
                                        <Button x:Name="CertificateInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zum Fensterhelfer"
                                                ToolTip="Freiwillig. Lässt Fenster von Programmen mit Administratorrechten einrasten, ohne dass Zone Manager selbst Rechte bekommt. Braucht ein eigenes Zertifikat auf diesem Rechner – Vor- und Nachteile stehen im Assistenten." />
                                    </StackPanel>
                                    <TextBlock x:Name="CertificateStatusText" Text="{Binding CertificateStatus}" Style="{StaticResource HelpText}" Margin="0,4,0,0" AutomationProperties.Name="Zustand des Zertifikats" />
                                    <TextBlock x:Name="HelperStatusText" Text="{Binding HelperStatus}" Style="{StaticResource HelpText}" Margin="0,2,0,0" AutomationProperties.Name="Zustand des Fensterhelfers" />
                                </StackPanel>
                                <TextBlock x:Name="CertificateStateText" Grid.Column="1" Text="{Binding CertificateStateLabel}" Foreground="{DynamicResource MutedBrush}" FontSize="14" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Margin="0,0,14,0" AutomationProperties.Name="Zustand des Zertifikats in zwei Worten" />
                                <Button x:Name="HelperWizardButton" Grid.Column="2" Content="Assistent …" Click="HelperWizard_Click" VerticalAlignment="Center" AutomationProperties.Name="Assistent für den Fensterhelfer öffnen" />
                            </Grid>
                        </Grid>
                        <Button x:Name="ResetSettingsButton" Content="Alle Einstellungen zurücksetzen" Style="{StaticResource LinkButton}" Click="ResetSettings_Click" HorizontalAlignment="Left" Margin="0,6,0,0"
                                AutomationProperties.Name="Einstellungen auf Voreinstellung zurücksetzen"
                                ToolTip="Stellt Abstände, Darstellung, Verhalten und alle Feinabstimmungen auf die Voreinstellung zurück. Erscheinungsbild, Autostart, Rechte und die Updatesuche bleiben, ebenso Layouts, Zuordnungen und die Liste «In Ruhe lassen». Der Hinweis unten bietet Rückgängig." />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Rueckgaengig-Toast: unten mittig ueber der Statuszeile, InkBrush-Grund mit CanvasBrush-Text. -->
        <Border x:Name="ToastHost" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,56" Padding="16,10,12,10"
                Background="{DynamicResource InkBrush}" CornerRadius="8" Visibility="{Binding IsToastVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                MouseEnter="Toast_MouseEnter" MouseLeave="Toast_MouseLeave" AutomationProperties.Name="Hinweis mit Rückgängig">
            <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.35" /></Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="ToastText" Text="{Binding ToastText}" Foreground="{DynamicResource CanvasBrush}" FontSize="15" VerticalAlignment="Center" MaxWidth="520" TextTrimming="CharacterEllipsis" />
                <Button x:Name="ToastUndoButton" Content="Rückgängig" Click="ToastUndo_Click" Margin="14,0,0,0" MinHeight="32" Padding="12,2" FontWeight="SemiBold"
                        Background="Transparent" Foreground="{DynamicResource CanvasBrush}" BorderBrush="{DynamicResource CanvasBrush}"
                        Visibility="{Binding CanUndoToast, Converter={StaticResource BooleanToVisibilityConverter}}" AutomationProperties.Name="Letzte Löschung rückgängig machen" />
                <Button x:Name="ToastCloseButton" Content="✕" Click="ToastClose_Click" Margin="6,0,0,0" MinHeight="32" Width="32" Padding="0"
                        Background="Transparent" Foreground="{DynamicResource CanvasBrush}" BorderThickness="0" AutomationProperties.Name="Hinweis schliessen" />
            </StackPanel>
        </Border>

        <!-- Statuszeile: letzte Aktion mit Uhrzeit; ein angehaltenes Einrasten erscheint als Warnung mit Schaltflaeche. -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border x:Name="PausedBox" Style="{StaticResource WarningBox}" Padding="10,3" Margin="0,0,14,0" VerticalAlignment="Center"
                        Visibility="{Binding IsSnappingPaused, Converter={StaticResource BooleanToVisibilityConverter}}" AutomationProperties.Name="Zustand der Snap-Funktion">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="SnappingStateText" Text="{Binding SnappingStateLabel}" Foreground="{DynamicResource WarningBrush}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" ToolTip="{Binding PauseReason}" />
                        <Button x:Name="ResumeSnappingButton" Content="Einrasten wieder aktivieren" Style="{StaticResource CompactButton}" Click="ResumeSnapping_Click" Margin="12,0,0,0"
                                ToolTip="{Binding PauseReason}" AutomationProperties.Name="Einrasten wieder aktivieren" />
                    </StackPanel>
                </Border>
                <TextBlock x:Name="StatusMessageText" Grid.Column="1" Text="{Binding StatusMessage}" FontSize="14"
                           Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusMessage}"
                           AutomationProperties.Name="Statusmeldung" />
                <TextBlock x:Name="AuthorLabel" Grid.Column="2" Text="Zone Manager von Sascha Krähenbühl"
                           FontSize="13" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="18,0,0,0"
                           AutomationProperties.Name="Urheber des Programms" />
            </Grid>
        </Border>
    </Grid>
</Window>

<Window x:Class="SnapZones.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SnapZones.App.Controls"
        xmlns:viewModels="clr-namespace:SnapZones.App.ViewModels"
        Title="Zone Manager"
        Width="1480" Height="900" MinWidth="1180" MinHeight="720"
        FontSize="16"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Icon>
        <BitmapImage UriSource="/ZoneManager;component/Assets/ZoneManager.ico" DecodePixelWidth="64" />
    </Window.Icon>
    <Window.Resources>
        <viewModels:EnumDisplayConverter x:Key="EnumDisplayConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <viewModels:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
        <viewModels:ZeroToVisibilityConverter x:Key="ZeroToVisibilityConverter" />
        <viewModels:NonZeroToVisibilityConverter x:Key="NonZeroToVisibilityConverter" />
        <viewModels:NotNullToVisibilityConverter x:Key="NotNullToVisibilityConverter" />
        <viewModels:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <controls:ProgramIconConverter x:Key="ProgramIconConverter" />
        <controls:ProgramInitialsConverter x:Key="ProgramInitialsConverter" />
        <viewModels:EqualityConverter x:Key="EqualityConverter" />
        <DataTemplate x:Key="EnumItemTemplate">
            <TextBlock Text="{Binding Converter={StaticResource EnumDisplayConverter}}" />
        </DataTemplate>
        <DataTemplate x:Key="LayoutMonitorItemTemplate">
            <TextBlock Text="{Binding UserFacingName}" />
        </DataTemplate>
        <DataTemplate x:Key="TargetLayoutItemTemplate">
            <TextBlock>
                <Run Text="{Binding UserFacingMonitorName, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Name, Mode=OneWay}" />
            </TextBlock>
        </DataTemplate>
        <!-- Programm-Symbol 36 x 36: echtes Symbol der .exe, sonst zwei Buchstaben auf AccentSoftBrush. -->
        <DataTemplate x:Key="ProgramIconTemplate">
            <Border Width="36" Height="36" CornerRadius="8" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Center">
                <Grid>
                    <TextBlock Text="{Binding Converter={StaticResource ProgramInitialsConverter}}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentStatusBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Image Source="{Binding Converter={StaticResource ProgramIconConverter}}" Width="24" Height="24"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{DynamicResource CanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Kopfzeile: das Logo fuehrt auf die Startseite «Zonen & Layouts»; rechts nur die Versionsnummer. -->
        <Border Grid.Row="0" MinHeight="72" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="14" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="10" /><ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="HeaderLogoButton" Click="ShowStartPage_Click" AutomationProperties.Name="Zu Zonen und Layouts"
                        ToolTip="Zu «Zonen &amp; Layouts»" VerticalAlignment="Center" MinHeight="0" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button"><ContentPresenter /></ControlTemplate>
                    </Button.Template>
                    <Image Width="36" Height="36" Source="/ZoneManager;component/Assets/ZoneManager.Header.png"
                           RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" />
                </Button>
                <TextBlock Grid.Column="2" Text="Zone Manager" FontFamily="Segoe UI Variable Display"
                           FontSize="23" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock x:Name="VersionLabel" Grid.Column="4" Foreground="{DynamicResource SubtleInkBrush}"
                           FontSize="14" VerticalAlignment="Center" Margin="0,7,0,0"
                           AutomationProperties.Name="Programmversion" />
            </Grid>
        </Border>

        <TabControl x:Name="NavigationTabs" Grid.Row="1" Margin="0" TabStripPlacement="Left">
            <controls:Chrome.SidebarHeader>
                <StackPanel>
                    <Grid>
                        <TextBox x:Name="SearchText" MinHeight="36" FontSize="14" Padding="30,0,10,0"
                                 controls:Chrome.Placeholder="Einstellung suchen …"
                                 Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="SearchText_KeyDown" AutomationProperties.Name="Einstellung suchen" />
                        <TextBlock Text="⌕" FontSize="14" Foreground="{DynamicResource SubtleInkBrush}" Margin="10,0,0,0"
                                   HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" />
                    </Grid>
                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="4" Margin="0,6,0,0"
                            Visibility="{Binding HasSearchQuery, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <ItemsControl x:Name="SearchResultsList" ItemsSource="{Binding SearchResults}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Click="SearchResult_Click" Style="{StaticResource LinkButton}" HorizontalAlignment="Stretch" Padding="6"
                                                AutomationProperties.Name="{Binding Label}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Row" Background="Transparent" CornerRadius="4" Padding="6,5">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Label}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                            <TextBlock Text="{Binding Path}" FontSize="12" Foreground="{DynamicResource SubtleInkBrush}" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverBrush}" /></Trigger>
                                                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverBrush}" /></Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Nichts gefunden." FontSize="13" Foreground="{DynamicResource SubtleInkBrush}" Margin="10,6"
                                       Visibility="{Binding HasNoSearchResults, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </controls:Chrome.SidebarHeader>

            <!-- ========================= Zonen & Layouts ========================= -->
            <TabItem x:Name="LayoutsTab" Header="Zonen &amp; Layouts" controls:Chrome.Group="EINRICHTEN" controls:Chrome.Badge="{Binding LayoutCountText}">
                <Grid Margin="22,28">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

                    <!-- Kopfzeile der Seite: Monitor, Layout-Tabs mit Reihenfolgepfeilen, «+ Neu», Vollbild-Editor. -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <ComboBox x:Name="LayoutMonitorSelector" ItemsSource="{Binding Monitors}" SelectedItem="{Binding SelectedMonitor, Mode=TwoWay}"
                                  ItemTemplate="{StaticResource LayoutMonitorItemTemplate}" SelectionChanged="Monitor_SelectionChanged" AutomationProperties.Name="Monitor wählen" />
                        <Border Grid.Column="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,8" VerticalAlignment="Bottom">
                            <StackPanel Orientation="Horizontal">
                                <ItemsControl x:Name="LayoutTabs" ItemsSource="{Binding Layouts}" AllowDrop="True"
                                              PreviewMouseLeftButtonDown="LayoutTabs_PreviewMouseLeftButtonDown"
                                              PreviewMouseMove="LayoutTabs_PreviewMouseMove" Drop="LayoutTabs_Drop" DragOver="LayoutTabs_DragOver">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Click="LayoutTab_Click" MouseRightButtonUp="LayoutTab_RightClick"
                                                    AutomationProperties.Name="{Binding Name, StringFormat=Layout {0} bearbeiten}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource ReorderTabItem}">
                                                        <Setter Property="controls:Chrome.IsCurrent">
                                                            <Setter.Value>
                                                                <MultiBinding Converter="{StaticResource EqualityConverter}">
                                                                    <Binding Path="Id" />
                                                                    <Binding Path="DataContext.SelectedLayout.Id" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                                </MultiBinding>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Button.Style>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                                    <TextBlock Text="● aktiv" FontSize="11" Foreground="{DynamicResource SuccessBrush}" Margin="8,0,0,0" VerticalAlignment="Center"
                                                               Visibility="{Binding IsActive, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    <StackPanel Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                                                        <StackPanel.Visibility>
                                                            <MultiBinding Converter="{StaticResource EqualityConverter}" ConverterParameter="Visibility">
                                                                <Binding Path="Id" />
                                                                <Binding Path="DataContext.SelectedLayout.Id" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                            </MultiBinding>
                                                        </StackPanel.Visibility>
                                                        <Button Content="‹" Style="{StaticResource ReorderArrowButton}" Click="MoveLayoutLeft_Click"
                                                                IsEnabled="{Binding DataContext.CanMoveLayoutLeft, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                ToolTip="Nach links schieben" AutomationProperties.Name="Layout nach links schieben" />
                                                        <Button Content="›" Style="{StaticResource ReorderArrowButton}" Click="MoveLayoutRight_Click"
                                                                IsEnabled="{Binding DataContext.CanMoveLayoutRight, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                ToolTip="Nach rechts schieben" AutomationProperties.Name="Layout nach rechts schieben" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button x:Name="AddLayoutButton" Content="+ Neu ⌵" Style="{StaticResource ReorderTabItem}" Click="AddLayoutMenu_Click" AutomationProperties.Name="Neues Layout erstellen">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Leeres Layout" Click="AddEmptyLayout_Click" />
                                            <MenuItem Header="Aus Vorlage …" Click="AddLayoutFromTemplate_Click" />
                                            <MenuItem Header="Aktuelles duplizieren" Click="DuplicateLayout_Click" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </StackPanel>
                        </Border>
                        <Button x:Name="DrawOnMonitorButton" Grid.Column="3" Content="Auf dem Monitor zeichnen ⤢" Style="{StaticResource PrimaryButton}" Click="DrawOnMonitor_Click"
                                Margin="14,0,0,0" VerticalAlignment="Bottom"
                                AutomationProperties.Name="Zonen in echter Grösse auf dem Monitor zeichnen"
                                ToolTip="Öffnet dieses Layout in echter Grösse auf dem Monitor. Alles, was du dort ziehst, ist sofort gespeichert; Esc oder «Fertig» schliesst." />
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" x:Name="LayoutEditorArea">
                            <Border Style="{StaticResource SectionCard}" Margin="0" Padding="12" Background="{DynamicResource SurfaceRaisedBrush}">
                                <DockPanel LastChildFill="True">
                                    <TextBlock x:Name="ValidationText" DockPanel.Dock="Bottom" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" FontSize="14"
                                               Visibility="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource NotNullToVisibilityConverter}}" />
                                    <Grid>
                                        <controls:LayoutCanvas x:Name="EditorCanvas" MinHeight="390" ZoneSelected="EditorCanvas_ZoneSelected"
                                                               ZoneChanged="EditorCanvas_ZoneChanged" DragStarted="EditorCanvas_DragStarted" DragEnded="EditorCanvas_DragEnded"
                                                               ZoneRenameRequested="EditorCanvas_ZoneRenameRequested" ZoneContextMenuRequested="EditorCanvas_ZoneContextMenuRequested"
                                                               ZoneDeleteRequested="EditorCanvas_ZoneDeleteRequested" AutomationProperties.Name="Layout-Editor" />

                                        <!-- Rueckgaengig liegt auf der Flaeche, nicht in der Fussleiste: links der Text der letzten Aktion. -->
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0">
                                            <TextBlock x:Name="UndoLabelText" Text="{Binding Editor.UndoLabel}" Foreground="{DynamicResource MutedBrush}" FontSize="13"
                                                       VerticalAlignment="Center" Margin="0,0,10,0" TextTrimming="CharacterEllipsis" MaxWidth="260"
                                                       AutomationProperties.Name="Letzte Änderung am Layout" />
                                            <Border Background="{DynamicResource SurfaceRaisedBrush}" Opacity="0.85" BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1" CornerRadius="6" Padding="2">
                                                <StackPanel Orientation="Horizontal">
                                                    <Button x:Name="UndoZoneChangeButton" Content="↶" Width="28" Height="26" MinHeight="26" Padding="0" FontSize="15"
                                                            Background="Transparent" BorderThickness="0" Click="UndoZoneChange_Click" IsEnabled="{Binding Editor.CanUndo}"
                                                            AutomationProperties.Name="Letzte Änderung am Layout zurücknehmen" ToolTip="Rückgängig (Strg + Z)" />
                                                    <Button x:Name="RedoZoneChangeButton" Content="↷" Width="28" Height="26" MinHeight="26" Padding="0" FontSize="15"
                                                            Background="Transparent" BorderThickness="0" Click="RedoZoneChange_Click" IsEnabled="{Binding Editor.CanRedo}"
                                                            AutomationProperties.Name="Zurückgenommene Änderung wiederherstellen" ToolTip="Wiederherstellen (Strg + Y)" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <Canvas x:Name="RenameOverlay" IsHitTestVisible="True" Visibility="Collapsed">
                                            <TextBox x:Name="RenameTextBox" MinHeight="28" Padding="8,0" FontSize="14" KeyDown="RenameTextBox_KeyDown" LostKeyboardFocus="RenameTextBox_LostFocus"
                                                     AutomationProperties.Name="Zone umbenennen" />
                                        </Canvas>
                                    </Grid>
                                </DockPanel>
                            </Border>
                        </Grid>

                        <!-- Das Werte-Panel ist immer sichtbar; ohne gewaehlte Zone steht dort ein Platzhalter. -->
                        <Border x:Name="ZoneValuesHost" Grid.Column="1" Style="{StaticResource SectionCard}" Margin="12,0,0,0" Padding="16" Width="300">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <controls:ZoneValuesPanel x:Name="ZoneValues" ValuesApplied="ZoneValues_ValuesApplied"
                                                          FullscreenZoneSetupRequested="ZoneValues_FullscreenZoneSetupRequested" />
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <DockPanel Grid.Row="2" Margin="0,14,0,0" LastChildFill="True">
                        <Button x:Name="AddZoneButton" DockPanel.Dock="Left" Content="+ Zone" Style="{StaticResource PrimaryButton}" Click="AddZone_Click"
                                AutomationProperties.Name="Neue Zone hinzufügen" ToolTip="Fügt in der grössten freien Fläche eine neue Zone hinzu." />
                        <Button x:Name="DeleteZoneButton" DockPanel.Dock="Left" Content="Zone löschen" Style="{StaticResource DangerButton}" Click="DeleteZone_Click" Margin="8,0,0,0"
                                AutomationProperties.Name="Ausgewählte Zone löschen" ToolTip="Löscht die ausgewählte Zone. Rückgängig ist über den Hinweis unten oder mit Strg + Z möglich." />
                        <Button x:Name="TemplateMenuButton" DockPanel.Dock="Left" Content="Vorlage ⌵" Click="TemplateMenu_Click" Margin="8,0,0,0"
                                AutomationProperties.Name="Vorlage wählen" ToolTip="Die Vorschläge berücksichtigen Seitenverhältnis, Auflösung, Windows-Skalierung und – falls Windows sie liefert – die physische Monitorgrösse." />
                        <TextBlock Text="Doppelklick = umbenennen · Rechtsklick = Startzone · Alt = Andocken aus" Style="{StaticResource HelpText}" Margin="16,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </DockPanel>

                    <Popup x:Name="TemplatePopup" PlacementTarget="{Binding ElementName=TemplateMenuButton}" Placement="Top" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,6" MaxWidth="900">
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedMonitor.ResolutionText, StringFormat=Vorschläge für {0}}" Style="{StaticResource GroupTitle}" Margin="0,0,0,8" />
                                <ItemsControl x:Name="TemplateSuggestions" ItemsSource="{Binding SelectedMonitor.LayoutSuggestions}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Click="Template_Click" Width="164" MinHeight="112" Margin="0,0,10,8" Padding="8,6"
                                                    ToolTip="{Binding Description}" AutomationProperties.Name="{Binding AccessibilityName}"
                                                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                                                <Grid>
                                                    <Grid.RowDefinitions><RowDefinition Height="52" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                                    <controls:LayoutTemplatePreview Suggestion="{Binding}" Margin="4,0,4,4" />
                                                    <TextBlock Grid.Row="1" Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" />
                                                    <TextBlock Grid.Row="2" Text="{Binding Description}" Foreground="{DynamicResource SubtleInkBrush}" FontSize="11.5" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" HorizontalAlignment="Center" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Popup>
                    <Popup x:Name="LayoutRenamePopup" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,4,0,0">
                            <StackPanel Width="260">
                                <TextBlock Text="Layoutname" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="LayoutNameText" KeyDown="LayoutNameText_KeyDown" AutomationProperties.Name="Layoutname" />
                                <TextBlock Text="Enter übernimmt · Esc bricht ab" Style="{StaticResource HelpText}" />
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
            </TabItem>

            <!-- ========================= Monitore ========================= -->
            <TabItem x:Name="MonitorsTab" Header="Monitore" controls:Chrome.Badge="{Binding MonitorCountText}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="22,28">
                        <!-- Tab-Zeile wie bei den Layouts: je Monitor ein Tab, der aktive traegt die Reihenfolgepfeile. -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,8" VerticalAlignment="Bottom">
                                <ItemsControl x:Name="MonitorTabs" ItemsSource="{Binding Monitors}" AllowDrop="True"
                                              PreviewMouseLeftButtonDown="MonitorTabs_PreviewMouseLeftButtonDown"
                                              PreviewMouseMove="MonitorTabs_PreviewMouseMove" Drop="MonitorTabs_Drop" DragOver="MonitorTabs_DragOver">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Click="MonitorTab_Click" AutomationProperties.Name="{Binding UserFacingName, StringFormat=Monitor {0} anzeigen}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource ReorderTabItem}">
                                                        <Setter Property="controls:Chrome.IsCurrent">
                                                            <Setter.Value>
                                                                <MultiBinding Converter="{StaticResource EqualityConverter}">
                                                                    <Binding Path="Live.Identity.StableId" />
                                                                    <Binding Path="DataContext.SelectedMonitor.Live.Identity.StableId" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                                </MultiBinding>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsConnected}" Value="False">
                                                                <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <StackPanel Orientation="Horizontal">
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding UserFacingName}" />
                                                        <TextBlock Style="{StaticResource ListSubtitle}" Margin="0,1,0,0">
                                                            <Run Text="{Binding ResolutionText, Mode=OneWay}" /><Run Text="{Binding ConnectionSuffix, Mode=OneWay}" />
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                                                        <StackPanel.Visibility>
                                                            <MultiBinding Converter="{StaticResource EqualityConverter}" ConverterParameter="Visibility">
                                                                <Binding Path="Live.Identity.StableId" />
                                                                <Binding Path="DataContext.SelectedMonitor.Live.Identity.StableId" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                            </MultiBinding>
                                                        </StackPanel.Visibility>
                                                        <Button Content="‹" Style="{StaticResource ReorderArrowButton}" Click="MoveMonitorLeft_Click"
                                                                IsEnabled="{Binding DataContext.CanMoveMonitorLeft, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                ToolTip="Nach links schieben" AutomationProperties.Name="Monitor nach links schieben" />
                                                        <Button Content="›" Style="{StaticResource ReorderArrowButton}" Click="MoveMonitorRight_Click"
                                                                IsEnabled="{Binding DataContext.CanMoveMonitorRight, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                ToolTip="Nach rechts schieben" AutomationProperties.Name="Monitor nach rechts schieben" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                            <TextBlock Grid.Column="1" Text="{Binding MonitorConnectionSummary}" Foreground="{DynamicResource MutedBrush}" FontSize="14"
                                       VerticalAlignment="Bottom" Margin="14,0,0,10" AutomationProperties.Name="Zahl der angeschlossenen Monitore" />
                        </Grid>

                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedMonitor.ConnectionNote}" Style="{StaticResource HelpText}" Margin="0,0,0,8"
                                           Visibility="{Binding SelectedMonitor.ConnectionNote, Converter={StaticResource NotNullToVisibilityConverter}}" />
                                <controls:ZonePreview x:Name="MonitorPreview" Zones="{Binding SelectedMonitor.Layout.Zones}" StartZoneId="{Binding SelectedMonitor.Layout.StartZoneId}"
                                                      AspectRatio="{Binding SelectedMonitor.AspectRatio}" FrameRadius="12" FramePadding="8" LabelFontSize="14"
                                                      Margin="60,0,60,0" MaxHeight="360" />
                                <Button x:Name="EditActiveLayoutLink" Style="{StaticResource LinkButton}" HorizontalAlignment="Right" Margin="0,6,60,0" Click="EditActiveLayout_Click"
                                        Content="{Binding SelectedMonitor.Layout.Name, StringFormat=Layout «{0}» · bearbeiten, Mode=OneWay}"
                                        AutomationProperties.Name="Aktives Layout bearbeiten" />
                                <Grid Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Monitorname" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="MonitorNameText" Text="{Binding SelectedMonitor.CustomName, Mode=OneWay}" VerticalContentAlignment="Center"
                                                 LostFocus="MonitorName_LostFocus" KeyDown="MonitorName_KeyDown" AutomationProperties.Name="Eigener Monitorname" />
                                        <TextBlock Style="{StaticResource HelpText}"><Run Text="Leer = automatischer Name «Monitor " /><Run Text="{Binding SelectedMonitor.DisplayNumber, Mode=OneWay}" /><Run Text="»." /></TextBlock>
                                    </StackPanel>
                                    <Button x:Name="IdentifyMonitorsButton" Grid.Column="2" Content="Auf Monitor zeigen" Click="IdentifyMonitors_Click" VerticalAlignment="Top" Margin="0,21,0,0"
                                            AutomationProperties.Name="Monitore identifizieren"
                                            ToolTip="Zeigt den verwendeten Namen drei Sekunden lang auf jedem Monitor an." />
                                </Grid>
                                <Border Style="{StaticResource FieldGroup}" Margin="0,18,0,0">
                                    <Expander x:Name="DetectedValuesExpander" IsExpanded="True">
                                        <Expander.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Erkannte Werte" Style="{StaticResource GroupTitle}" />
                                                <TextBlock Text="von Windows gemeldet, nur lesbar" Style="{StaticResource HelpText}" Margin="10,0,0,0" />
                                            </StackPanel>
                                        </Expander.Header>
                                        <StackPanel>
                                            <UniformGrid Columns="4">
                                                <StackPanel><TextBlock Text="Skalierung" Style="{StaticResource HelpText}" Margin="0" /><TextBlock x:Name="ScalingFactorText" Text="–" FontFamily="Cascadia Mono" FontSize="22" FontWeight="SemiBold" /></StackPanel>
                                                <StackPanel><TextBlock Text="Auflösung" Style="{StaticResource HelpText}" Margin="0" /><TextBlock x:Name="ScalingResolutionText" Text="–" FontFamily="Cascadia Mono" FontSize="22" FontWeight="SemiBold" /></StackPanel>
                                                <StackPanel><TextBlock Text="Arbeitsfläche" Style="{StaticResource HelpText}" Margin="0" /><TextBlock x:Name="ScalingWorkAreaText" Text="–" FontFamily="Cascadia Mono" FontSize="22" FontWeight="SemiBold" /></StackPanel>
                                                <StackPanel><TextBlock Text="Diagonale" Style="{StaticResource HelpText}" Margin="0" /><TextBlock x:Name="ScalingPhysicalSizeText" Text="–" FontFamily="Cascadia Mono" FontSize="22" FontWeight="SemiBold" /></StackPanel>
                                            </UniformGrid>
                                            <TextBlock x:Name="WindowsScaleText" Style="{StaticResource HelpText}" Margin="0,10,0,0" />
                                        </StackPanel>
                                    </Expander>
                                </Border>
                                <Border Style="{StaticResource FieldGroup}" Margin="0">
                                    <Expander>
                                        <Expander.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Windows-Einstellungen öffnen" Style="{StaticResource GroupTitle}" />
                                                <TextBlock Text="Anzeige · Textgrösse · Taskleiste" Style="{StaticResource HelpText}" Margin="10,0,0,0" />
                                            </StackPanel>
                                        </Expander.Header>
                                        <StackPanel>
                                            <TextBlock Text="Ändern lassen sich diese Werte nur in Windows selbst – dafür gibt es keine unterstützte Programmierschnittstelle. Die Textgrösse gilt immer für alle Monitore zusammen; Höhe und Symbolgrösse der Taskleiste sind in Windows 11 nicht frei einstellbar."
                                                       Style="{StaticResource HelpText}" Margin="0,0,0,12" />
                                            <WrapPanel>
                                                <Button Content="Anzeigeeinstellungen öffnen" Tag="ms-settings:display" Click="OpenSystemSetting_Click" Margin="0,0,8,8" />
                                                <Button Content="Textgrösse öffnen" Tag="ms-settings:easeofaccess-textsize" Click="OpenSystemSetting_Click" Margin="0,0,8,8" />
                                                <Button Content="Taskleisteneinstellungen öffnen" Tag="ms-settings:taskbar" Click="OpenSystemSetting_Click" Margin="0,0,0,8" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </Expander>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ========================= Fenster zuordnen ========================= -->
            <TabItem x:Name="RulesTab" Header="Fenster zuordnen" controls:Chrome.Badge="{Binding RuleCountText}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="22,28">
                        <!-- Leerer Zustand: gestrichelte Karte mit einer aus Rechtecken gezeichneten Skizze. -->
                        <Grid x:Name="AppRuleEmptyState" Visibility="{Binding RuleCount, Converter={StaticResource ZeroToVisibilityConverter}}">
                            <Rectangle Stroke="{DynamicResource ControlBorderBrush}" StrokeDashArray="4 3" StrokeThickness="1" RadiusX="8" RadiusY="8" />
                            <StackPanel Margin="32" HorizontalAlignment="Center">
                                <Grid Width="180" Height="104" HorizontalAlignment="Center" Margin="0,0,0,18">
                                    <Border Background="{DynamicResource MonitorFrameBrush}" CornerRadius="6" />
                                    <Grid Margin="6">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                        <Rectangle Grid.RowSpan="2" Fill="{DynamicResource ZoneFillBrush}" Opacity="0.35" Stroke="{DynamicResource ZoneBorderBrush}" Margin="0,0,2,0" />
                                        <Rectangle Grid.Column="1" Stroke="{DynamicResource DropTargetBrush}" StrokeDashArray="3 2" StrokeThickness="1.5" Margin="2,0,0,2" />
                                        <Rectangle Grid.Column="1" Grid.Row="1" Fill="{DynamicResource ZoneFillBrush}" Opacity="0.35" Stroke="{DynamicResource ZoneBorderBrush}" Margin="2,2,0,0" />
                                    </Grid>
                                    <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="3"
                                            Width="70" Height="40" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="26,0,0,14">
                                        <TextBlock Text="Explorer →" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                                <TextBlock Text="Noch kein Fenster zugeordnet" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center" />
                                <TextBlock Text="Beispiel: «Wenn der Explorer geöffnet wird, setze ihn in die Zone Referenz.» Du ziehst dazu einfach ein laufendes Fenster auf eine Zone – oder wählst eine .exe-Datei."
                                           Style="{StaticResource HelpText}" TextAlignment="Center" MaxWidth="560" Margin="0,8,0,16" />
                                <Button x:Name="AppRuleAddFirstButton" Content="+ Erstes Fenster zuordnen" Style="{StaticResource PrimaryButton}" Click="AppRuleAdd_Click" HorizontalAlignment="Center"
                                        AutomationProperties.Name="Erstes Fenster zuordnen" />
                                <TextBlock Text="Tipp: Im Dialog ziehst du ein laufendes Fenster direkt auf die Zone, in der es künftig landen soll."
                                           FontSize="13" Foreground="{DynamicResource SubtleInkBrush}" TextAlignment="Center" Margin="0,14,0,0" />
                            </StackPanel>
                        </Grid>

                        <ItemsControl x:Name="AppRuleList" ItemsSource="{Binding AppRules.RuleItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <Border Margin="0,0,0,8">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource ListRow}">
                                                    <Setter Property="Margin" Value="0,0,0,8" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPaused}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource WarningBorderBrush}" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <ContentPresenter Content="{Binding ProcessPath}" ContentTemplate="{StaticResource ProgramIconTemplate}" />
                                                <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                                                    <TextBlock TextTrimming="CharacterEllipsis">
                                                        <Run Text="{Binding DisplayName, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  →  " Foreground="{DynamicResource SubtleInkBrush}" /><Run Text="{Binding TargetLabel, Mode=OneWay}" FontWeight="SemiBold">
                                                            <Run.Style>
                                                                <Style TargetType="Run">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsPaused}" Value="True"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}" /></DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Run.Style>
                                                        </Run>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource ListSubtitle}" />
                                                </StackPanel>
                                                <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsEnabled, Mode=OneWay}" Click="AppRuleEnabled_Click" Margin="0,0,16,0"
                                                          AutomationProperties.Name="{Binding DisplayName, StringFormat=Zuordnung {0} ein- oder ausschalten}" />
                                                <Button Grid.Column="3" Content="✎" Style="{StaticResource ListIconButton}" Click="AppRuleToggleDetail_Click"
                                                        ToolTip="Zuordnung bearbeiten"
                                                        AutomationProperties.Name="{Binding DisplayName, StringFormat=Zuordnung {0} bearbeiten}"
                                                        Visibility="{Binding IsPaused, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                                <Button Grid.Column="3" Content="!" Style="{StaticResource ListIconButtonWarning}" Click="AppRuleToggleDetail_Click"
                                                        ToolTip="Ziel fehlt – beheben"
                                                        AutomationProperties.Name="{Binding DisplayName, StringFormat=Ziel der Zuordnung {0} fehlt – beheben}"
                                                        Visibility="{Binding IsPaused, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource SectionCard}" Margin="52,0,0,8" BorderBrush="{DynamicResource ControlBorderBrush}"
                                                Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                DataContext="{Binding DataContext.AppRules, RelativeSource={RelativeSource AncestorType=Window}}">
                                            <StackPanel>
                                                <Border Style="{StaticResource WarningBox}" Margin="0,0,0,14" Visibility="{Binding IsTargetMissing, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" FontSize="14">
                                                        <Run Text="Ziel fehlt." FontWeight="SemiBold" /><Run Text=" " /><Run Text="{Binding MissingTargetExplanation, Mode=OneWay}" />
                                                    </TextBlock>
                                                </Border>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="Programm" Style="{StaticResource FieldLabel}" />
                                                        <Grid>
                                                            <TextBox x:Name="AppRuleProcessPathText" Text="{Binding ProcessPath, UpdateSourceTrigger=PropertyChanged}" Padding="12,0,80,0"
                                                                     AutomationProperties.Name="Prozesspfad oder Dateiname" controls:Chrome.Placeholder="Dateiname, z. B. Explorer.exe" />
                                                            <Button x:Name="AppRuleBrowseButton" Content="ändern" Style="{StaticResource LinkButton}" HorizontalAlignment="Right" Margin="0,0,12,0" Click="AppRuleBrowse_Click"
                                                                    AutomationProperties.Name="Prozess auswählen" ToolTip="Wähle ein laufendes Programm oder eine Programmdatei." />
                                                        </Grid>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Wann" Style="{StaticResource FieldLabel}" />
                                                        <ComboBox x:Name="AppRuleEventSelector" ItemsSource="{Binding Events}" SelectedItem="{Binding SelectedEvent, Mode=TwoWay}"
                                                                  ItemTemplate="{StaticResource EnumItemTemplate}" AutomationProperties.Name="Ereignis der Zuordnung" ToolTip="{Binding SelectedEventDescription}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Row="1" Margin="0,14,0,0">
                                                        <TextBlock Text="Ziellayout" Style="{StaticResource FieldLabel}" />
                                                        <ComboBox x:Name="AppRuleTargetLayoutSelector" ItemsSource="{Binding TargetLayouts}" SelectedItem="{Binding SelectedTargetLayout, Mode=TwoWay}"
                                                                  ItemTemplate="{StaticResource TargetLayoutItemTemplate}" AutomationProperties.Name="Ziellayout" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,14,0,0">
                                                        <TextBlock Text="Zielzone" Style="{StaticResource FieldLabel}" />
                                                        <ComboBox x:Name="AppRuleTargetZoneSelector" ItemsSource="{Binding TargetZones}" SelectedItem="{Binding SelectedTargetZone, Mode=TwoWay}"
                                                                  DisplayMemberPath="Name" AutomationProperties.Name="Zielzone" controls:Chrome.Placeholder="Zone wählen …">
                                                            <ComboBox.Style>
                                                                <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsTargetMissing}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" /></DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ComboBox.Style>
                                                        </ComboBox>
                                                    </StackPanel>
                                                </Grid>
                                                <TextBlock x:Name="AppRuleTargetStatusText" Text="{Binding TargetStatus}" Style="{StaticResource HelpText}" AutomationProperties.Name="Status des Ziels" />
                                                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,14,0,0" Padding="0,10,0,0">
                                                    <Expander>
                                                        <Expander.Header>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="Fenster eingrenzen" Style="{StaticResource GroupTitle}" />
                                                                <TextBlock Text="Titel · Fensterklasse" Style="{StaticResource HelpText}" Margin="10,0,0,0" />
                                                            </StackPanel>
                                                        </Expander.Header>
                                                        <StackPanel>
                                                            <TextBlock Text="Alle drei Merkmale sind gleichrangige Filter. Leer bedeutet: keine Einschränkung. Mindestens eines der drei muss stehen."
                                                                       Style="{StaticResource HelpText}" Margin="0,0,0,10" />
                                                            <Grid>
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                                <StackPanel>
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="Titel enthält" Style="{StaticResource FieldLabel}" Margin="0" VerticalAlignment="Center" />
                                                                        <Button x:Name="AppRuleTitleInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zum Titelmuster"
                                                                                ToolTip="Verglichen wird der Text in der Titelleiste des Fensters. Es genügt ein Teilstück, Gross- und Kleinschreibung spielen keine Rolle. Beispiel: «Posteingang» trifft das Outlook-Fenster «Posteingang – Buchhaltung», nicht aber ein offenes E-Mail-Fenster. Nützlich, wenn ein Programm mehrere Fensterarten hat und nur eine davon positioniert werden soll. Leer = jeder Titel." />
                                                                    </StackPanel>
                                                                    <TextBox x:Name="AppRuleWindowTitleText" Text="{Binding WindowTitlePattern, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0"
                                                                             controls:Chrome.Placeholder="z. B. «Posteingang»" AutomationProperties.Name="Optionales Fenstertitelmuster" />
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="2">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="Fensterklasse (selten nötig)" Style="{StaticResource FieldLabel}" Margin="0" VerticalAlignment="Center" />
                                                                        <Button x:Name="AppRuleWindowClassInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zur Fensterklasse"
                                                                                ToolTip="Die Fensterklasse ist ein interner Windows-Name, den ein Programm jedem seiner Fenstertypen gibt – zum Beispiel «Chrome_WidgetWin_1» für Chrome-Fenster oder «CabinetWClass» für den Explorer. Anders als der Titel ändert sie sich nicht mit dem Inhalt. Verwende sie, wenn ein Programm Hauptfenster, Dialoge und Popups mischt und nur eine Sorte gemeint ist. Ist dir die Klasse nicht bekannt, lass das Feld leer – es wird selten gebraucht." />
                                                                    </StackPanel>
                                                                    <TextBox x:Name="AppRuleWindowClassText" Text="{Binding WindowClass, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0"
                                                                             controls:Chrome.Placeholder="z. B. «CabinetWClass»" AutomationProperties.Name="Optionale Fensterklasse" />
                                                                </StackPanel>
                                                            </Grid>
                                                            <TextBlock x:Name="AppRuleCriteriaStatusText" Text="{Binding CriteriaStatus}" Style="{StaticResource HelpText}" Foreground="{DynamicResource WarningBrush}"
                                                                       AutomationProperties.Name="Hinweis zu den Erkennungsmerkmalen"
                                                                       Visibility="{Binding CriteriaStatus, Converter={StaticResource NotNullToVisibilityConverter}}" />
                                                        </StackPanel>
                                                    </Expander>
                                                </Border>
                                                <Expander Margin="0,6,0,0">
                                                    <Expander.Header>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="Feinheiten" Style="{StaticResource GroupTitle}" />
                                                            <TextBlock Style="{StaticResource HelpText}" Margin="10,0,0,0">
                                                                <Run Text="Verzögerung" /><Run Text="{Binding DelayMilliseconds, Mode=OneWay}" /><Run Text="ms ·" /><Run Text="{Binding RetryCount, Mode=OneWay}" /><Run Text="Wiederholungen · Priorität" /><Run Text="{Binding Priority, Mode=OneWay}" />
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Expander.Header>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="Verzögerung" Style="{StaticResource FieldLabel}" Margin="0" VerticalAlignment="Center" />
                                                                <Button x:Name="AppRuleDelayInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zur Verzögerung"
                                                                        ToolTip="Wartezeit in Millisekunden zwischen Ereignis und Positionierung. Viele Programme zeichnen ihr Fenster erst nach kurzer Zeit fertig; 200 bis 800 ms helfen dann. Erlaubt sind 0 bis 30000." />
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                                <TextBox x:Name="AppRuleDelayText" Style="{StaticResource NumberField}" Text="{Binding DelayMilliseconds, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Verzögerung in Millisekunden" />
                                                                <TextBlock Text="ms" Style="{StaticResource UnitLabel}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="Wiederholungen" Style="{StaticResource FieldLabel}" Margin="0" VerticalAlignment="Center" />
                                                                <Button x:Name="AppRuleRetryInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zu Wiederholungen"
                                                                        ToolTip="Wie oft die Positionierung wiederholt wird, falls das Programm sein Fenster danach nochmals selbst verschiebt. Erlaubt sind 0 bis 3." />
                                                            </StackPanel>
                                                            <TextBox x:Name="AppRuleRetryText" Style="{StaticResource NumberField}" Text="{Binding RetryCount, UpdateSourceTrigger=LostFocus}" Margin="0,6,0,0" HorizontalAlignment="Left" AutomationProperties.Name="Wiederholungen von null bis drei" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="4">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="Priorität" Style="{StaticResource FieldLabel}" Margin="0" VerticalAlignment="Center" />
                                                                <Button x:Name="AppRulePriorityInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zur Priorität"
                                                                        ToolTip="Treffen mehrere Zuordnungen auf dasselbe Fenster zu, gewinnt die mit der höheren Priorität. Erlaubt sind 0 bis 100, Standard ist 50." />
                                                            </StackPanel>
                                                            <TextBox x:Name="AppRulePriorityText" Style="{StaticResource NumberField}" Text="{Binding Priority, UpdateSourceTrigger=LostFocus}" Margin="0,6,0,0" HorizontalAlignment="Left" AutomationProperties.Name="Priorität von null bis hundert" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Expander>
                                                <Grid Margin="0,16,0,0">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <Button Content="Fertig" Style="{StaticResource PrimaryButton}" Click="AppRuleDone_Click" AutomationProperties.Name="Detail schliessen" />
                                                    <Button x:Name="AppRuleDeleteButton" Grid.Column="1" Content="Zuordnung entfernen" Style="{StaticResource DangerButton}" Margin="10,0,0,0" Click="AppRuleDelete_Click"
                                                            AutomationProperties.Name="Zuordnung entfernen" />
                                                    <TextBlock Grid.Column="2" Text="Wird sofort gespeichert · Entfernen lässt sich rückgängig machen" Style="{StaticResource HelpText}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Am Listenende: dieselbe gestrichelte Zeile wie auf «In Ruhe lassen». -->
                        <Button x:Name="AppRuleAddButton" Style="{StaticResource CardButton}" Click="AppRuleAdd_Click" Padding="20,14" Background="Transparent"
                                Visibility="{Binding RuleCount, Converter={StaticResource NonZeroToVisibilityConverter}}" AutomationProperties.Name="Fenster zuordnen">
                            <Grid>
                                <Rectangle Stroke="{DynamicResource ControlBorderBrush}" StrokeDashArray="4 3" StrokeThickness="1" RadiusX="8" RadiusY="8" Margin="-20,-14" />
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="36" Height="36" CornerRadius="8" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1">
                                        <TextBlock Text="+" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
                                    </Border>
                                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Fenster zuordnen" FontWeight="SemiBold" />
                                        <TextBlock Text="Ein laufendes Fenster auf eine Zone ziehen oder eine .exe-Datei angeben" Style="{StaticResource ListSubtitle}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ========================= In Ruhe lassen ========================= -->
            <TabItem x:Name="ExclusionsTab" Header="In Ruhe lassen" controls:Chrome.Badge="{Binding ExclusionCountText}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="22,28">
                        <Grid x:Name="AppExclusionEmptyState" Visibility="{Binding ExclusionCount, Converter={StaticResource ZeroToVisibilityConverter}}" Margin="0,0,0,8">
                            <Rectangle Stroke="{DynamicResource ControlBorderBrush}" StrokeDashArray="4 3" StrokeThickness="1" RadiusX="8" RadiusY="8" />
                            <StackPanel Margin="32" HorizontalAlignment="Center">
                                <TextBlock Text="Alle Fenster dürfen einrasten" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center" />
                                <TextBlock Text="Wenn ein Programm lieber frei bleiben soll – etwa der Taschenrechner oder ein Videoplayer –, trag es hier ein. Es bekommt dann keine Zonen mehr angezeigt."
                                           Style="{StaticResource HelpText}" TextAlignment="Center" MaxWidth="560" Margin="0,8,0,16" />
                                <Button x:Name="AppExclusionAddFirstButton" Content="+ Programm in Ruhe lassen" Style="{StaticResource PrimaryButton}" Click="AppExclusionAdd_Click" HorizontalAlignment="Center"
                                        AutomationProperties.Name="Programm in Ruhe lassen" />
                            </StackPanel>
                        </Grid>
                        <ItemsControl x:Name="AppExclusionList" ItemsSource="{Binding AppExclusions.ExclusionItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <Border Style="{StaticResource ListRow}">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <ContentPresenter Content="{Binding ProcessPath}" ContentTemplate="{StaticResource ProgramIconTemplate}" />
                                                <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource ListSubtitle}" />
                                                </StackPanel>
                                                <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsEnabled, Mode=OneWay}" Click="AppExclusionEnabled_Click" Margin="0,0,16,0"
                                                          AutomationProperties.Name="{Binding DisplayName, StringFormat=Eintrag {0} ein- oder ausschalten}" />
                                                <Button Grid.Column="3" Content="✎" Style="{StaticResource ListIconButton}" Click="AppExclusionToggleDetail_Click"
                                                        ToolTip="Eingrenzen: nur bestimmte Fenster"
                                                        AutomationProperties.Name="{Binding DisplayName, StringFormat=Eintrag {0} eingrenzen}" />
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource SectionCard}" Margin="52,0,0,8" BorderBrush="{DynamicResource ControlBorderBrush}"
                                                Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                DataContext="{Binding DataContext.AppExclusions, RelativeSource={RelativeSource AncestorType=Window}}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding ScopeHint}" Style="{StaticResource HelpText}" Margin="0,0,0,14" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="Titel enthält" Style="{StaticResource FieldLabel}" Margin="0" VerticalAlignment="Center" />
                                                            <Button x:Name="AppExclusionTitleInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zum Titelmuster"
                                                                    ToolTip="Verglichen wird der Text in der Titelleiste des Fensters. Es genügt ein Teilstück, Gross- und Kleinschreibung spielen keine Rolle. Nützlich, wenn ein Programm mehrere Fensterarten hat und nur eine davon frei bleiben soll – etwa ein Vorschaufenster, während das Hauptfenster weiterhin einrastet. «*» und «?» dienen als Platzhalter. Leer = alle Fenster des Programms." />
                                                        </StackPanel>
                                                        <TextBox x:Name="AppExclusionWindowTitleText" Text="{Binding WindowTitlePattern, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0"
                                                                 controls:Chrome.Placeholder="z. B. «Vorschau»" AutomationProperties.Name="Optionales Fenstertitelmuster" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="Fensterklasse (selten nötig)" Style="{StaticResource FieldLabel}" Margin="0" VerticalAlignment="Center" />
                                                            <Button x:Name="AppExclusionWindowClassInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zur Fensterklasse"
                                                                    ToolTip="Die Fensterklasse ist ein interner Windows-Name, den ein Programm jedem seiner Fenstertypen gibt – zum Beispiel «CabinetWClass» für den Explorer. Anders als der Titel ändert sie sich nicht mit dem Inhalt. Verwende sie, wenn ein Programm Hauptfenster, Dialoge und Popups mischt und nur eine Sorte frei bleiben soll. Ist dir die Klasse nicht bekannt, lass das Feld leer." />
                                                        </StackPanel>
                                                        <TextBox x:Name="AppExclusionWindowClassText" Text="{Binding WindowClass, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0"
                                                                 controls:Chrome.Placeholder="z. B. «CabinetWClass»" AutomationProperties.Name="Optionale Fensterklasse" />
                                                    </StackPanel>
                                                </Grid>
                                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                                    <TextBlock Text="Programm" Style="{StaticResource FieldLabel}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                    <TextBox x:Name="AppExclusionProcessPathText" Text="{Binding ProcessPath, UpdateSourceTrigger=PropertyChanged}" MinWidth="320"
                                                             controls:Chrome.Placeholder="Dateiname, z. B. Taschenrechner.exe" AutomationProperties.Name="Prozesspfad oder Dateiname" />
                                                </StackPanel>
                                                <TextBlock x:Name="AppExclusionCriteriaStatusText" Text="{Binding CriteriaStatus}" Style="{StaticResource HelpText}" Foreground="{DynamicResource WarningBrush}"
                                                           AutomationProperties.Name="Status des Eintrags" Visibility="{Binding CriteriaStatus, Converter={StaticResource NotNullToVisibilityConverter}}" />
                                                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                                    <Button Content="Fertig" Style="{StaticResource PrimaryButton}" Click="AppExclusionDone_Click" AutomationProperties.Name="Detail schliessen" />
                                                    <Button x:Name="AppExclusionDeleteButton" Content="Wieder einrasten lassen" Style="{StaticResource DangerButton}" Margin="10,0,0,0" Click="AppExclusionDelete_Click"
                                                            AutomationProperties.Name="Eintrag entfernen, Fenster rastet wieder ein" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button x:Name="AppExclusionAddButton" Style="{StaticResource CardButton}" Click="AppExclusionAdd_Click" Padding="20,14" Background="Transparent"
                                Visibility="{Binding ExclusionCount, Converter={StaticResource NonZeroToVisibilityConverter}}" AutomationProperties.Name="Programm in Ruhe lassen">
                            <Grid>
                                <Rectangle Stroke="{DynamicResource ControlBorderBrush}" StrokeDashArray="4 3" StrokeThickness="1" RadiusX="8" RadiusY="8" Margin="-20,-14" />
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="36" Height="36" CornerRadius="8" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1">
                                        <TextBlock Text="+" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
                                    </Border>
                                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Programm in Ruhe lassen" FontWeight="SemiBold" />
                                        <TextBlock Text="Ein laufendes Fenster wählen oder eine .exe-Datei angeben" Style="{StaticResource ListSubtitle}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ========================= Ziehen & Einrasten ========================= -->
            <TabItem x:Name="DragTab" Header="Ziehen &amp; Einrasten" controls:Chrome.Group="VERHALTEN">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="22,28">
                        <Border Style="{StaticResource SectionCard}" Padding="20,6">
                            <StackPanel>
                                <Border Style="{StaticResource SettingRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Zonen anzeigen auf" Style="{StaticResource SettingLabel}" />
                                                <Button x:Name="OverlayScopeInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zu Zonen anzeigen auf"
                                                        ToolTip="Wo die Zonen erscheinen, wenn du ein Fenster an der Titelleiste ziehst. «Alle Monitore»: überall gleichzeitig. «Monitor beim Ziehbeginn»: nur dort, wo du das Fenster angefasst hast – ziehst du auf einen anderen Bildschirm, siehst du dort keine Zonen. «Monitor unter dem Mauszeiger»: die Zonen wandern mit deiner Maus auf den anderen Bildschirm." />
                                            </StackPanel>
                                            <TextBlock Text="Auf welchen Monitoren die Zonen erscheinen" Style="{StaticResource HelpText}" />
                                        </StackPanel>
                                        <ComboBox x:Name="OverlayScopeSelector" Grid.Column="1" VerticalAlignment="Top" ItemsSource="{Binding Settings.OverlayScopes}" SelectedItem="{Binding Settings.OverlayScope}" ItemTemplate="{StaticResource EnumItemTemplate}" AutomationProperties.Name="Wo die Zonen beim Ziehen erscheinen" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Zonen einblenden" Style="{StaticResource SettingLabel}" />
                                                <Button x:Name="TriggerModeInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zu Zonen einblenden"
                                                        ToolTip="«Sofort beim Ziehen»: die Zonen erscheinen bei jedem Ziehen an der Titelleiste. «Mit Umschalttaste»: sie erscheinen nur, wenn du beim Ziehen zusätzlich Shift gedrückt hältst – praktisch, wenn du Fenster oft nur kurz verschiebst und keine Zonen aufblitzen sollen." />
                                            </StackPanel>
                                            <TextBlock Text="Wann die Zonen beim Ziehen sichtbar werden" Style="{StaticResource HelpText}" />
                                        </StackPanel>
                                        <ComboBox x:Name="TriggerModeSelector" Grid.Column="1" VerticalAlignment="Top" ItemsSource="{Binding Settings.TriggerModes}" SelectedItem="{Binding Settings.TriggerMode}" ItemTemplate="{StaticResource EnumItemTemplate}" AutomationProperties.Name="Wann die Zonen erscheinen" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Zonennamen anzeigen" Style="{StaticResource SettingLabel}" />
                                                <Button x:Name="ShowZoneNamesInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zu Zonennamen anzeigen"
                                                        ToolTip="Zeigt beim Ziehen auf jeder Zone ihre Nummer und ihren Namen auf einer kleinen dunklen Fläche, etwa «1 · Links». Die Nummer ist zugleich die Taste des Tastenkürzels. Aus: Kontur und Zielfläche bleiben sichtbar, nur die Beschriftung fehlt." />
                                            </StackPanel>
                                            <TextBlock Text="Jede Zone trägt beim Ziehen ihren Namen" Style="{StaticResource HelpText}" />
                                        </StackPanel>
                                        <CheckBox x:Name="ShowZoneNamesSwitch" Grid.Column="1" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,0,0" IsChecked="{Binding Settings.ShowZoneNames}" AutomationProperties.Name="Zonennamen anzeigen" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Fenster nach dem Einrasten in den Vordergrund holen" Style="{StaticResource SettingLabel}" />
                                                <Button x:Name="ActivateAfterSnapInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zu Fenster nach dem Einrasten in den Vordergrund holen"
                                                        ToolTip="Ein per Zuordnung, Startzone oder Tastenkürzel gesetztes Fenster wird sonst nicht aktiviert, damit dir nichts den Fokus wegnimmt. Eingeschaltet erhält es nach jedem Setzen den Fokus. Aus: das Fenster behält seinen Rang in der Fensterreihenfolge." />
                                            </StackPanel>
                                            <TextBlock Text="Das gesetzte Fenster liegt danach zuoberst" Style="{StaticResource HelpText}" />
                                        </StackPanel>
                                        <CheckBox x:Name="ActivateAfterSnapSwitch" Grid.Column="1" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,0,0" IsChecked="{Binding Settings.ActivateWindowAfterSnap}" AutomationProperties.Name="Fenster nach dem Einrasten aktivieren" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingRowLast}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Grösse beim Herausziehen wiederherstellen" Style="{StaticResource SettingLabel}" />
                                                <Button x:Name="RestoreSizeInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zu Grösse beim Herausziehen wiederherstellen"
                                                        ToolTip="Wird ein eingerastetes Fenster aus seiner Zone gezogen und nirgends abgelegt, bekommt es die Grösse zurück, die es vor dem Einrasten hatte. Die neue Position bleibt. Gilt nur für Fenster, die dieses Programm selbst eingerastet hat. Aus: ein herausgezogenes Fenster behält die Zonengrösse." />
                                            </StackPanel>
                                            <TextBlock Text="Ein herausgezogenes Fenster wird wieder so gross wie vorher" Style="{StaticResource HelpText}" />
                                        </StackPanel>
                                        <CheckBox x:Name="RestoreSizeSwitch" Grid.Column="1" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,0,0" IsChecked="{Binding Settings.RestoreSizeWhenLeavingZone}" AutomationProperties.Name="Fenstergrösse beim Verlassen einer Zone wiederherstellen" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <controls:TuningExpander x:Name="DragTuning" Section="Feinabstimmung">
                            <Border Style="{StaticResource SectionCard}" Padding="20,6">
                                <StackPanel>
                                    <Border Style="{StaticResource SettingRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="Anzeigeverzögerung" Style="{StaticResource SettingLabel}" />
                                                <Button x:Name="OverlayDelayInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zu Anzeigeverzögerung"
                                                        ToolTip="Wartezeit in Millisekunden, bis die Zonen erscheinen. Bei 0 sofort. Mit z. B. 300 bleiben kurze Verschiebungen ruhig – die Zonen kommen erst, wenn du länger ziehst; wird vorher losgelassen, bleibt der Bildschirm ruhig. Erlaubt sind 0 bis 1000, Voreinstellung 0." /></StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBox x:Name="OverlayShowDelayText" Style="{StaticResource NumberField}" Text="{Binding Settings.OverlayShowDelayMilliseconds}" AutomationProperties.Name="Anzeigeverzögerung der Zonen in Millisekunden" />
                                                <TextBlock Text="ms" Style="{StaticResource UnitLabel}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SettingRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="Toleranz für «eingerastet»" Style="{StaticResource SettingLabel}" />
                                                <Button x:Name="SnappedToleranceInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zu Toleranz für eingerastet"
                                                        ToolTip="So nah müssen alle vier Kanten eines Fensters an den Zonenkanten liegen, damit es als eingerastet gilt und von Startzone und Layoutwechsel in Ruhe gelassen wird. Der unsichtbare Fensterrand von Windows macht bis zu 16 Pixel aus; 40 lässt Spielraum. Zulässig sind 8 bis 80." /></StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"><TextBox Style="{StaticResource NumberField}" Text="{Binding Settings.SnappedTolerancePixels}" AutomationProperties.Name="Toleranz für eingerastete Fenster in Pixel" /><TextBlock Text="px" Style="{StaticResource UnitLabel}" /></StackPanel>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SettingRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="Schutzschalter des Verschiebe-Hooks" Style="{StaticResource SettingLabel}" />
                                                <Button x:Name="MoveHookLimitInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zum Schutzschalter des Verschiebe-Hooks"
                                                        ToolTip="Meldet Windows innerhalb von zehn Sekunden mehr Verschiebe-Ereignisse als hier erlaubt, hält das Programm das Einrasten an und zeigt das in der Statuszeile. Jeder Ziehvorgang liefert zwei Ereignisse; 2000 erreicht niemand von Hand. Wer Fenster per Skript bewegt, setzt die Grenze höher. Zulässig sind 200 bis 20000." /></StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"><TextBox Style="{StaticResource NumberField}" Text="{Binding Settings.MoveHookEventLimit}" AutomationProperties.Name="Ereignisgrenze des Schutzschalters" /><TextBlock Text="Ereignisse" Style="{StaticResource UnitLabel}" /></StackPanel>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SettingRowLast}">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="Wachhund für hängende Ziehvorgänge" Style="{StaticResource SettingLabel}" />
                                                <Button x:Name="WatchdogInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zum Wachhund für hängende Ziehvorgänge"
                                                        ToolTip="Bleibt das Endereignis eines Ziehvorgangs aus, zieht das Programm die Zonen nach dieser Zeit ein, was auch immer Windows meldet. Wer Fenster sehr lange gedrückt hält, erhöht den Wert. Zulässig sind 2 bis 60 Sekunden, Voreinstellung 10." /></StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"><TextBox Style="{StaticResource NumberField}" Text="{Binding Settings.DragWatchdogSeconds}" AutomationProperties.Name="Wachhund für Ziehvorgänge in Sekunden" /><TextBlock Text="s" Style="{StaticResource UnitLabel}" /></StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </controls:TuningExpander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ========================= Aussehen der Zonen ========================= -->
            <TabItem x:Name="AppearanceTab" Header="Aussehen der Zonen">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="22,28">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="320" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <Border Style="{StaticResource SectionCard}" Padding="20,6">
                                <StackPanel>
                                    <Border Style="{StaticResource SettingRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal"><TextBlock Text="Farbe der Zonen" Style="{StaticResource SettingLabel}" />
                                                    <Button x:Name="OverlayColourInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zur Farbe der Zonen"
                                                            ToolTip="Die Farbe der Zonenflächen beim Ziehen, als RGB-Wert im Format #RRGGBB oder über das Farbfeld gewählt. Das neutrale Windows-Grau #707070 wirkt ruhig; eine eigene Farbe bleibt möglich. Die Vorschau rechts zeigt die Wirkung sofort." /></StackPanel>
                                                <TextBlock Text="Die Fläche, die du beim Ziehen siehst" Style="{StaticResource HelpText}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                                <Button x:Name="OverlayColorPickerButton" Width="36" Height="36" MinHeight="36" Padding="0" Click="OverlayColorPicker_Click" AutomationProperties.Name="Farbe der Zonen auswählen" ToolTip="Farbe wählen">
                                                    <Border x:Name="OverlayColorPreview" Width="26" Height="26" CornerRadius="4" Background="{Binding Settings.OverlayColor}" AutomationProperties.Name="Vorschau der Zonenfarbe" />
                                                </Button>
                                                <TextBox x:Name="OverlayColorText" Width="150" Margin="8,0,0,0" FontFamily="Cascadia Mono" Text="{Binding Settings.OverlayColor, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Hexwert der Zonenfarbe" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SettingRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal"><TextBlock Text="Deckkraft" Style="{StaticResource SettingLabel}" />
                                                    <Button x:Name="OverlayOpacityInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zur Deckkraft"
                                                            ToolTip="Wie kräftig die Zonenflächen beim Ziehen gefüllt sind. Eine kleine Deckkraft hält die Anzeige dezent; die Zielzone wird über die Hervorhebung zusätzlich verstärkt. Zulässig sind 8 bis 75 Prozent, Voreinstellung 24." /></StackPanel>
                                                <TextBlock Text="Wie kräftig die Flächen gefüllt sind" Style="{StaticResource HelpText}" />
                                            </StackPanel>
                                            <Grid Grid.Column="1" VerticalAlignment="Top" Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <Slider x:Name="OverlayOpacitySlider" Minimum="8" Maximum="75" Value="{Binding Settings.OverlayOpacityPercent}" TickFrequency="1" SmallChange="1" LargeChange="10" IsSnapToTickEnabled="True" VerticalAlignment="Center" AutomationProperties.Name="Deckkraft der Zonen" />
                                                <TextBox x:Name="OverlayOpacityPercentText" Grid.Column="1" Style="{StaticResource NumberField}" Width="70" Margin="8,0,0,0" Text="{Binding Settings.OverlayOpacityPercent, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:0}}" AutomationProperties.Name="Deckkraft in Prozent" />
                                                <TextBlock Grid.Column="2" Text="%" Style="{StaticResource UnitLabel}" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SettingRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal"><TextBlock Text="Beschriftung" Style="{StaticResource SettingLabel}" />
                                                    <Button x:Name="OverlayLabelStyleInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zur Beschriftung"
                                                            ToolTip="Was auf jeder Zone steht. «Nummer und Name» zeigt «1 · Links»; die Nummer ist zugleich die Taste des Tastenkürzels. «Nur Nummer» hält die Anzeige knapp, «Nur Name» lässt die Nummer weg, «Keine» lässt die Beschriftung ganz weg." /></StackPanel>
                                                <TextBlock Text="Was auf jeder Zone steht" Style="{StaticResource HelpText}" />
                                            </StackPanel>
                                            <ComboBox x:Name="OverlayLabelStyleSelector" Grid.Column="1" VerticalAlignment="Top" ItemsSource="{Binding Settings.OverlayLabelStyles}" SelectedItem="{Binding Settings.OverlayLabelStyle}" ItemTemplate="{StaticResource EnumItemTemplate}" AutomationProperties.Name="Beschriftung der Zonen" />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SettingRowLast}">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal"><TextBlock Text="Schriftgrösse der Beschriftung" Style="{StaticResource SettingLabel}" />
                                                    <Button x:Name="OverlayFontInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zur Schriftgrösse der Beschriftung"
                                                            ToolTip="Die Schriftgrösse der Beschriftung in Punkt. Auf grossen oder weit entfernten Monitoren darf sie deutlich grösser sein als die Voreinstellung 16. Zulässig sind 8 bis 48." /></StackPanel>
                                                <TextBlock Text="Wie gross Nummer und Name auf der Zone stehen" Style="{StaticResource HelpText}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                                <TextBox x:Name="OverlayFontSizeText" Style="{StaticResource NumberField}" Width="80" Text="{Binding Settings.OverlayLabelFontSize}" AutomationProperties.Name="Schriftgrösse der Zonenbeschriftung" />
                                                <TextBlock Text="pt" Style="{StaticResource UnitLabel}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <controls:TuningExpander x:Name="AppearanceTuning" Section="Feinabstimmung">
                                <Border Style="{StaticResource SectionCard}" Padding="20,6">
                                    <StackPanel>
                                        <Border Style="{StaticResource SettingRow}">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal"><TextBlock Text="Rahmenbreite" Style="{StaticResource SettingLabel}" />
                                                    <Button x:Name="OverlayBorderInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zur Rahmenbreite"
                                                            ToolTip="Die Konturlinie jeder Zone in Pixel. Auf hochauflösenden Monitoren mit 100 Prozent Skalierung ist ein Pixel schnell zu dünn; dann helfen zwei oder drei. Die hervorgehobene Zone ist immer einen Pixel dicker. Zulässig sind 1 bis 6, Voreinstellung 2." /></StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <TextBox x:Name="OverlayBorderText" Style="{StaticResource NumberField}" Width="80" Text="{Binding Settings.OverlayBorderThickness}" AutomationProperties.Name="Rahmenbreite der Zonen in Pixel" />
                                                    <TextBlock Text="px" Style="{StaticResource UnitLabel}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource SettingRow}">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal"><TextBlock Text="Eckenradius" Style="{StaticResource SettingLabel}" />
                                                    <Button x:Name="OverlayRadiusInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zum Eckenradius"
                                                            ToolTip="Wie stark die Ecken der Zonenflächen abgerundet sind. 0 zeichnet rechteckige Zonen, grössere Werte weichere Kacheln. Zulässig sind 0 bis 24 Pixel, Voreinstellung 6." /></StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <TextBox x:Name="OverlayRadiusText" Style="{StaticResource NumberField}" Width="80" Text="{Binding Settings.OverlayCornerRadius}" AutomationProperties.Name="Eckenradius der Zonen in Pixel" />
                                                    <TextBlock Text="px" Style="{StaticResource UnitLabel}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource SettingRowLast}">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal"><TextBlock Text="Hervorhebung der Zielzone" Style="{StaticResource SettingLabel}" />
                                                    <Button x:Name="HighlightInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zur Hervorhebung der Zielzone"
                                                            ToolTip="Farbe und Deckkraft der Zielzone, also der Zone unter dem Mauszeiger. Sie bekommt voreingestellt ein kräftiges Blau, während die übrigen Zonen grau bleiben; leer bedeutet dieselbe Farbe wie die übrigen Zonen. Zulässig sind 10 bis 90 Prozent, Voreinstellung 36." /></StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <Button x:Name="HighlightColorPickerButton" Width="36" Height="36" MinHeight="36" Padding="0" Click="HighlightColorPicker_Click" AutomationProperties.Name="Farbe der Hervorhebung auswählen" ToolTip="Farbe wählen">
                                                        <Border x:Name="HighlightColorPreview" Width="26" Height="26" CornerRadius="4" Background="{DynamicResource AccentBrush}" />
                                                    </Button>
                                                    <TextBox x:Name="HighlightColorText" Width="110" Margin="8,0,0,0" FontFamily="Cascadia Mono" Text="{Binding Settings.HighlightColor, UpdateSourceTrigger=PropertyChanged}" controls:Chrome.Placeholder="wie Zonen" AutomationProperties.Name="Hexwert der Hervorhebungsfarbe" />
                                                    <TextBox x:Name="HighlightOpacityPercentText" Style="{StaticResource NumberField}" Width="70" Margin="8,0,0,0" Text="{Binding Settings.HighlightOpacityPercent, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:0}}" AutomationProperties.Name="Deckkraft der Hervorhebung in Prozent" />
                                                    <TextBlock Text="%" Style="{StaticResource UnitLabel}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </controls:TuningExpander>
                        </StackPanel>

                        <!-- Die Vorschau haftet oben und reagiert live auf jeden Wert der Seite. -->
                        <Border Grid.Column="2" Style="{StaticResource SectionCard}" Padding="16" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="Vorschau" Style="{StaticResource GroupTitle}" Margin="0,0,0,10" />
                                <controls:ZonePreview x:Name="OverlayPreview" OverlayMode="True" AspectRatio="1.7778" FrameRadius="8" FramePadding="5" LabelFontSize="10"
                                                      OverlayColor="{Binding Settings.OverlayColor}" OverlayOpacityPercent="{Binding Settings.OverlayOpacityPercent}"
                                                      HighlightColor="{Binding Settings.HighlightColor}" HighlightOpacityPercent="{Binding Settings.HighlightOpacityPercent}"
                                                      OverlayBorderThickness="{Binding Settings.OverlayBorderThickness}" OverlayCornerRadius="{Binding Settings.OverlayCornerRadius}"
                                                      LabelStyle="{Binding Settings.OverlayLabelStyle}" ShowLabels="{Binding Settings.ShowZoneNames}" />
                                <TextBlock Text="Die blaue Zone ist die Zielzone – dort würde das Fenster landen." Style="{StaticResource HelpText}" Margin="0,10,0,0" />
                                <Button x:Name="PreviewZonesButton" Content="Zonen kurz einblenden" Click="PreviewZones_Click" Margin="0,12,0,0" HorizontalAlignment="Stretch"
                                        AutomationProperties.Name="Zonen zwei Sekunden auf dem Bildschirm einblenden"
                                        ToolTip="Blendet die Zonen des aktiven Layouts zwei Sekunden lang echt auf dem Bildschirm ein." />
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ========================= Abstände & Raster ========================= -->
            <TabItem x:Name="SpacingTab" Header="Abstände &amp; Raster">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="22,28">
                        <Border Style="{StaticResource NoticeBand}">
                            <TextBlock Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" FontSize="14" LineHeight="20"
                                       AutomationProperties.Name="Hinweis zur Wirkung der Abstände"
                                       Text="Platzierte Fenster folgen immer pixelgenau dem Layout aus «Zonen &amp; Layouts». Die Werte hier gelten nur für die Zonen, die beim Ziehen angezeigt werden. Willst du Luft zwischen den Fenstern, zeichne sie im Layout ein." />
                        </Border>
                        <Border Style="{StaticResource SectionCard}" Padding="20,14,20,6">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Abstände beim Anzeigen" Style="{StaticResource GroupTitle}" />
                                    <Button x:Name="OverlaySpacingInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zu Abständen beim Anzeigen"
                                            ToolTip="Diese beiden Werte verkleinern die Zonenflächen, die beim Ziehen erscheinen. Auf die Stelle, an der ein Fenster danach landet, haben sie keinen Einfluss – dafür zählt allein das Layout." />
                                </StackPanel>
                                <TextBlock Text="Nur für die Zonen, die du beim Ziehen siehst" Style="{StaticResource HelpText}" Margin="0,2,0,6" />
                                <Border Style="{StaticResource SettingRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="Rand zum Bildschirm" Style="{StaticResource SettingLabel}" />
                                            <Button x:Name="OuterMarginsInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zum Rand zum Bildschirm"
                                                    ToolTip="Wie weit die angezeigten Zonen vom Bildschirmrand entfernt bleiben, in Pixel und je Seite: Links · Oben · Rechts · Unten. Ein Fenster landet trotzdem genau auf der Zone aus dem Layout. Zulässig sind 0 bis 400." /></StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBox x:Name="OuterMarginLeftText" Style="{StaticResource NumberField}" Width="60" Text="{Binding Settings.OuterMarginLeft, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Rand links in Pixel" ToolTip="Links" />
                                            <TextBox x:Name="OuterMarginTopText" Style="{StaticResource NumberField}" Width="60" Margin="6,0,0,0" Text="{Binding Settings.OuterMarginTop, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Rand oben in Pixel" ToolTip="Oben" />
                                            <TextBox x:Name="OuterMarginRightText" Style="{StaticResource NumberField}" Width="60" Margin="6,0,0,0" Text="{Binding Settings.OuterMarginRight, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Rand rechts in Pixel" ToolTip="Rechts" />
                                            <TextBox x:Name="OuterMarginBottomText" Style="{StaticResource NumberField}" Width="60" Margin="6,0,0,0" Text="{Binding Settings.OuterMarginBottom, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Rand unten in Pixel" ToolTip="Unten" />
                                            <TextBlock Text="px" Style="{StaticResource UnitLabel}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingRowLast}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="Lücke zwischen den Zonen" Style="{StaticResource SettingLabel}" />
                                            <Button x:Name="ZoneGapInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zur Lücke zwischen den Zonen"
                                                    ToolTip="Der zusätzliche Abstand zwischen benachbarten Zonenflächen beim Anzeigen. Auf die Stelle, an der ein Fenster landet, hat er keinen Einfluss: zwei benachbarte Zonen ergeben immer bündige Fenster. 100 Prozent entsprechen 80 Pixel." /></StackPanel>
                                        <Grid Grid.Column="1">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <Slider x:Name="ZoneGapSlider" Minimum="0" Maximum="100" Value="{Binding Settings.ZoneGapPercent}" TickFrequency="1" SmallChange="1" LargeChange="10" IsSnapToTickEnabled="True" VerticalAlignment="Center" AutomationProperties.Name="Lücke zwischen den Zonen" />
                                            <TextBox x:Name="ZoneGapPercentText" Grid.Column="1" Style="{StaticResource NumberField}" Width="60" Margin="8,0,0,0" Text="{Binding Settings.ZoneGapPercent, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:0}}" AutomationProperties.Name="Lücke in Prozent" />
                                            <TextBlock Grid.Column="2" Text="%" Style="{StaticResource UnitLabel}" />
                                            <TextBlock Grid.Column="3" Text="{Binding Settings.ZoneGap, StringFormat={}≙ {0} px}" Style="{StaticResource HelpText}" Margin="10,0,0,0" VerticalAlignment="Center" MinWidth="60" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SectionCard}" Padding="20,6">
                            <Border Style="{StaticResource SettingRowLast}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="Andocken im Editor" Style="{StaticResource SettingLabel}" />
                                            <Button x:Name="MagnetDistanceInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zum Andocken im Editor"
                                                    ToolTip="Ab welchem Abstand eine gezogene Kante im Editor an Monitor- oder Zonenkanten andockt; blaue Hilfslinien zeigen es. Beispiel: mit 25 Prozent rastet eine Kante ein, sobald sie zehn Pixel von einer anderen entfernt ist. 0 schaltet es aus; Alt pausiert es beim Ziehen. 100 Prozent entsprechen 40 Pixel." /></StackPanel>
                                        <TextBlock Text="Kanten fangen sich beim Zeichnen gegenseitig ein" Style="{StaticResource HelpText}" />
                                    </StackPanel>
                                    <Grid Grid.Column="1" VerticalAlignment="Top" Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <Slider x:Name="MagnetThresholdSlider" Minimum="0" Maximum="100" Value="{Binding Settings.MagnetThresholdPercent}" TickFrequency="1" SmallChange="1" LargeChange="10" IsSnapToTickEnabled="True" VerticalAlignment="Center" AutomationProperties.Name="Andocken im Editor" />
                                        <TextBox x:Name="MagnetThresholdPercentText" Grid.Column="1" Style="{StaticResource NumberField}" Width="60" Margin="8,0,0,0" Text="{Binding Settings.MagnetThresholdPercent, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:0}}" AutomationProperties.Name="Andocken im Editor in Prozent" />
                                        <TextBlock Grid.Column="2" Text="%" Style="{StaticResource UnitLabel}" />
                                        <TextBlock Grid.Column="3" Text="{Binding Settings.MagnetThresholdPixels, StringFormat={}≙ {0} px}" Style="{StaticResource HelpText}" Margin="10,0,0,0" VerticalAlignment="Center" MinWidth="60" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </Border>

                        <controls:TuningExpander x:Name="SpacingTuning" Section="Feinabstimmung">
                            <Border Style="{StaticResource SectionCard}" Padding="20,6">
                                <Border Style="{StaticResource SettingRowLast}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="Toleranz beim Nachmessen" Style="{StaticResource SettingLabel}" />
                                            <Button x:Name="PlacementToleranceInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zur Toleranz beim Nachmessen"
                                                    ToolTip="Nach jedem Setzen wird das Fenster nachgemessen. Weicht es um mehr als diese Pixel von der Zielfläche ab, folgt ein zweiter Anlauf und danach eine Meldung. Manche Programme runden auf ganze Zeichen oder Rasterzellen; dann hilft ein grösserer Wert. Zulässig sind 0 bis 10, Voreinstellung 2." /></StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"><TextBox Style="{StaticResource NumberField}" Text="{Binding Settings.PlacementTolerancePixels}" AutomationProperties.Name="Toleranz beim Nachmessen in Pixel" /><TextBlock Text="px" Style="{StaticResource UnitLabel}" /></StackPanel>
                                    </Grid>
                                </Border>
                            </Border>
                        </controls:TuningExpander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ========================= Fenster merken ========================= -->
            <TabItem x:Name="MemoryTab" Header="Fenster merken" controls:Chrome.Badge="{Binding RememberedWindowCountText}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="22,28">
                        <Border Style="{StaticResource SectionCard}" Padding="20,6">
                            <StackPanel>
                                <Border Style="{StaticResource SettingRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="Fensterpositionen merken" Style="{StaticResource SettingLabel}" />
                                                <Button x:Name="RememberWindowPositionsInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zum Merken von Fensterpositionen"
                                                        ToolTip="Jedes Fenster, das du einmal in eine Zone gesetzt hast, kehrt beim nächsten Öffnen dorthin zurück – auch nach einem Auflösungswechsel, dann wird die Lage anteilig umgerechnet. Erkannt wird ein Fenster an Programm, Fensterklasse und Fensterart, nicht am Titel; mehrere Fenster desselben Programms teilen sich deshalb einen Eintrag. In Ruhe gelassene Fenster werden nie gemerkt." /></StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBlock Text="{Binding RememberedWindowSummary}" Style="{StaticResource HelpText}" Margin="0" AutomationProperties.Name="Anzahl gemerkter Fensterpositionen" />
                                                <Button x:Name="ForgetWindowPositionsButton" Content="alle verwerfen" Style="{StaticResource LinkButton}" Margin="8,0,0,0" Click="ForgetWindowPositions_Click"
                                                        IsEnabled="{Binding HasRememberedWindows}" AutomationProperties.Name="Gemerkte Fensterpositionen verwerfen"
                                                        ToolTip="Löscht sämtliche gemerkten Positionen. Danach erscheint jedes Fenster wieder dort, wo Windows selbst es platziert. Rückgängig über den Hinweis unten." />
                                            </StackPanel>
                                        </StackPanel>
                                        <CheckBox x:Name="RememberWindowPositionsCheckBox" Grid.Column="1" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,0,0" IsChecked="{Binding Settings.RememberWindowPositions}" AutomationProperties.Name="Fensterpositionen merken" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="Neue Fenster in der Startzone öffnen" Style="{StaticResource SettingLabel}" />
                                                <Button x:Name="CatchNewWindowsInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zu Neue Fenster in der Startzone öffnen"
                                                        ToolTip="Ein neu erscheinendes Fenster ohne Zuordnung und ohne gemerkte Position landet in der Startzone, sofern eine festgelegt ist. Aus: es bleibt dort, wo Windows es hinsetzt; die Startzone dient dann nur noch dem Einsammeln beim Layoutwechsel." /></StackPanel>
                                            <TextBlock Text="Für Fenster, die Zone Manager noch nicht kennt" Style="{StaticResource HelpText}" />
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,0,0" IsChecked="{Binding Settings.CatchNewWindowsInStartZone}" AutomationProperties.Name="Neue Fenster in der Startzone öffnen" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="Maximierte Fenster maximiert wiederherstellen" Style="{StaticResource SettingLabel}" />
                                                <Button x:Name="RestoreMaximizedInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zu Maximierte Fenster maximiert wiederherstellen"
                                                        ToolTip="War ein Fenster beim Merken maximiert, wird es beim nächsten Öffnen wieder maximiert, sofern es gerade im Vordergrund ist. Aus: gemerkt maximierte Fenster erscheinen in Normalgrösse an ihrer Normalposition." /></StackPanel>
                                            <TextBlock Text="Ein maximiert gemerktes Fenster kommt maximiert zurück" Style="{StaticResource HelpText}" />
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,0,0" IsChecked="{Binding Settings.RestoreMaximizedWindows}" AutomationProperties.Name="Maximierte Fenster wiederherstellen" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="Fenster mit fester Grösse" Style="{StaticResource SettingLabel}" />
                                                <Button x:Name="FixedSizeInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zu Fenster mit fester Grösse"
                                                        ToolTip="Ein Fenster, dessen Grösse sich nicht ändern lässt – etwa ein Dialog –, kann eine Zone nicht füllen. Zentrieren legt es mittig in die Zone, oben links richtet es an der Ecke aus, nicht anfassen lässt es liegen und meldet das in der Statuszeile." /></StackPanel>
                                            <TextBlock Text="Kleine Fenster, die sich nicht verkleinern lassen" Style="{StaticResource HelpText}" />
                                        </StackPanel>
                                        <ComboBox Grid.Column="1" VerticalAlignment="Top" ItemsSource="{Binding Settings.FixedSizeWindowPlacements}" SelectedItem="{Binding Settings.FixedSizeWindowPlacement}" ItemTemplate="{StaticResource EnumItemTemplate}" AutomationProperties.Name="Behandlung von Fenstern mit fester Grösse" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingRowLast}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="Gemerkte Zone vor gemerkter Lage" Style="{StaticResource SettingLabel}" />
                                                <Button x:Name="PreferZoneInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zu Gemerkte Zone vor gemerkter Lage"
                                                        ToolTip="Eingeschaltet kehrt ein gemerktes Fenster in seine Zone zurück, auch wenn sich deren Fläche inzwischen geändert hat. Aus: die gemerkte Lage in Pixeln zählt, ein Fenster kehrt pixelgenau an seine letzte Stelle zurück; die Zone dient nur noch zur Monitorsuche." /></StackPanel>
                                            <TextBlock Text="Hat sich die Zone verschoben, folgt das Fenster ihr" Style="{StaticResource HelpText}" />
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,0,0" IsChecked="{Binding Settings.PreferRememberedZone}" AutomationProperties.Name="Gemerkte Zone bevorzugen" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <controls:TuningExpander x:Name="MemoryTuning" Section="Feinabstimmung">
                            <Border Style="{StaticResource SectionCard}" Padding="20,6">
                                <StackPanel>
                                    <Border Style="{StaticResource SettingRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="Katalog gemerkter Positionen" Style="{StaticResource SettingLabel}" />
                                                <Button x:Name="CatalogLimitInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zum Katalog gemerkter Positionen"
                                                        ToolTip="So viele Fensterpositionen hält das Programm höchstens; die ältesten fallen zuerst weg. Wer sehr viele verschiedene Programme benutzt, erhöht den Wert; die Datei bleibt auch bei 2000 Einträgen klein. Zulässig sind 50 bis 2000, Voreinstellung 500." /></StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"><TextBox Style="{StaticResource NumberField}" Text="{Binding Settings.RememberedWindowLimit}" AutomationProperties.Name="Höchstzahl gemerkter Fensterpositionen" /><TextBlock Text="Einträge" Style="{StaticResource UnitLabel}" /></StackPanel>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SettingRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="Wartezeit vor dem Beurteilen neuer Fenster" Style="{StaticResource SettingLabel}" />
                                                <Button x:Name="SettleDelayInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zur Wartezeit vor dem Beurteilen neuer Fenster"
                                                        ToolTip="Manche Programme bauen ihr Fenster erst einige hundert Millisekunden nach dem Erscheinen fertig auf und ändern dabei Grösse und Titel. Eine Wartezeit lässt das Programm erst danach entscheiden, ob es das Fenster zurücklegt oder in die Startzone setzt. Zulässig sind 0 bis 2000 Millisekunden, Voreinstellung 0." /></StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"><TextBox Style="{StaticResource NumberField}" Text="{Binding Settings.NewWindowSettleDelayMilliseconds}" AutomationProperties.Name="Wartezeit vor dem Beurteilen neuer Fenster in Millisekunden" /><TextBlock Text="ms" Style="{StaticResource UnitLabel}" /></StackPanel>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SettingRowLast}">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="Abstand zwischen Regelversuchen" Style="{StaticResource SettingLabel}" />
                                                <Button x:Name="RuleRetryInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zum Abstand zwischen Regelversuchen"
                                                        ToolTip="Lehnt Windows das Setzen ab, wiederholt eine Zuordnung den Versuch so oft, wie in ihren Feinheiten eingestellt, und wartet dazwischen diese Zeit. Programme, die ihr Fenster spät freigeben, brauchen längere Abstände. Zulässig sind 50 bis 2000 Millisekunden, Voreinstellung 250." /></StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"><TextBox Style="{StaticResource NumberField}" Text="{Binding Settings.RuleRetryDelayMilliseconds}" AutomationProperties.Name="Abstand zwischen Regelversuchen in Millisekunden" /><TextBlock Text="ms" Style="{StaticResource UnitLabel}" /></StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </controls:TuningExpander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ========================= Vollbild & Videos ========================= -->
            <TabItem x:Name="FullscreenTab" Header="Vollbild &amp; Videos">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="22,28">
                        <Border Style="{StaticResource SectionCard}" Padding="20,6">
                            <StackPanel>
                                <Border Style="{StaticResource SettingRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="Vollbildzone verwenden" Style="{StaticResource SettingLabel}" />
                                                <Button x:Name="UseFullscreenZonesInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zu Vollbildzone verwenden"
                                                        ToolTip="Eine Zone, die du in «Zonen &amp; Layouts» als Vollbildzone gekennzeichnet hast, gilt für das Fenster darin als eigener Bildschirm. Schaltet das Programm sein Vollbild ein, füllt es trotzdem nur die Zone. Dafür braucht Windows den Vollbildzonen-Treiber; ohne ihn bleibt dieser Schalter wirkungslos. Spiele im echten Exklusivvollbild sind davon nicht betroffen." /></StackPanel>
                                            <TextBlock Text="Ein Video im Vollbild bleibt in seiner Zone" Style="{StaticResource HelpText}" />
                                        </StackPanel>
                                        <CheckBox x:Name="UseFullscreenZonesSwitch" Grid.Column="1" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,0,0" IsChecked="{Binding Settings.UseFullscreenZones}" AutomationProperties.Name="Vollbildzone verwenden" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Vollbildzonen-Treiber" Style="{StaticResource SettingLabel}" />
                                                <controls:StatusChip State="{Binding DisplayDriverChipState}" Text="{Binding DisplayDriverChipText}" />
                                                <Button x:Name="DisplayDriverInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zum Vollbildzonen-Treiber"
                                                        ToolTip="Damit eine Zone als eigener Bildschirm gelten kann, braucht Windows einen zusätzlichen Anzeigetreiber – den «Virtual Display Driver», freie Software, signiert von der SignPath Foundation. Zone Manager hängt den zusätzlichen Bildschirm nur an, solange ein Fenster in einer Vollbildzone liegt. Einrichten und Entfernen fragen einmal nach Administratorrechten. Ohne Treiber bleibt alles andere unverändert." /></StackPanel>
                                            <TextBlock Text="{Binding DisplayDriverHint}" Style="{StaticResource HelpText}" AutomationProperties.Name="Zustand des Vollbildzonen-Treibers" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                            <Button x:Name="InstallDisplayDriverButton" Content="Installieren …" Click="InstallDisplayDriver_Click" IsEnabled="{Binding CanInstallDisplayDriver}"
                                                    Visibility="{Binding IsDisplayDriverInstalled, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                                    AutomationProperties.Name="Vollbildzonen-Treiber installieren" />
                                            <Button x:Name="CheckDisplayDriverButton" Content="Prüfen" Click="CheckDisplayDriver_Click"
                                                    Visibility="{Binding IsDisplayDriverInstalled, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    AutomationProperties.Name="Vollbildzonen-Treiber prüfen" ToolTip="Sieht nach, welche Treiberversion läuft und ob der zusätzliche Bildschirm bereitsteht." />
                                            <Button x:Name="RemoveDisplayDriverButton" Content="Deinstallieren" Style="{StaticResource DangerButton}" Click="RemoveDisplayDriver_Click" Margin="8,0,0,0"
                                                    IsEnabled="{Binding CanRemoveDisplayDriver}"
                                                    Visibility="{Binding IsDisplayDriverInstalled, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    AutomationProperties.Name="Vollbildzonen-Treiber deinstallieren" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingRowLast}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="Programme ohne Vollbildzone" Style="{StaticResource SettingLabel}" />
                                                <Button x:Name="FullscreenExclusionInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zu Programme ohne Vollbildzone"
                                                        ToolTip="Diese Programme bekommen ihr Vollbild immer auf dem ganzen Monitor, auch wenn ihr Fenster in einer Vollbildzone liegt. Sinnvoll für Spiele und für Programme, die mit einem zusätzlichen Bildschirm nicht zurechtkommen." /></StackPanel>
                                            <ItemsControl x:Name="FullscreenExclusionList" ItemsSource="{Binding Settings.FullscreenZoneExcludedPrograms}" Margin="0,8,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Style="{StaticResource FieldGroup}" Padding="10,6" Margin="0,0,0,6">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ProgramIconTemplate}" />
                                                                <TextBlock Grid.Column="1" Text="{Binding}" VerticalAlignment="Center" Margin="12,0" TextTrimming="CharacterEllipsis" />
                                                                <Button Grid.Column="2" Content="Eintrag entfernen" Style="{StaticResource DangerButton}" MinHeight="30" Padding="12,2" FontSize="14"
                                                                        Click="FullscreenExclusionRemove_Click" AutomationProperties.Name="{Binding StringFormat=Eintrag {0} entfernen}" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="Keines eingetragen" Style="{StaticResource HelpText}"
                                                       Visibility="{Binding Settings.FullscreenZoneExcludedPrograms.Count, Converter={StaticResource ZeroToVisibilityConverter}}" />
                                        </StackPanel>
                                        <Button x:Name="FullscreenExclusionAddButton" Grid.Column="1" Content="+ Programm eintragen" Click="FullscreenExclusionAdd_Click"
                                                HorizontalAlignment="Right" VerticalAlignment="Top" AutomationProperties.Name="Programm ohne Vollbildzone eintragen" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Erklaerkarte: was «Vollbild» mit und ohne Vollbildzone bedeutet. -->
                        <Border Style="{StaticResource SectionCard}" Padding="20,16">
                            <StackPanel>
                                <TextBlock Text="Was «Vollbild» heisst – mit und ohne Vollbildzone" Style="{StaticResource GroupTitle}" />
                                <TextBlock Style="{StaticResource HelpText}" Margin="0,8,0,0"
                                           Text="Schaltet ein Programm auf Vollbild, verlangt es von Windows den ganzen Bildschirm. Zone Manager kann es dann nicht mehr in einer Zone halten – das Video deckt alles zu, was daneben lag. Eine Vollbildzone dreht das um: die Zone bekommt einen eigenen, unsichtbaren Bildschirm in ihrer Grösse. Das Programm bekommt seinen ganzen Bildschirm, und der ist genau so gross wie die Zone." />
                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource FieldGroup}" Margin="0">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="ohne Vollbildzone" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                                                <controls:StatusChip State="Warning" Text="füllt alles" />
                                            </StackPanel>
                                            <Grid Height="104" Margin="0,10,0,0">
                                                <Border Background="{DynamicResource MonitorFrameBrush}" CornerRadius="6" />
                                                <Border Margin="6" Background="{DynamicResource DropTargetBrush}" Opacity="0.5" CornerRadius="3" />
                                                <TextBlock Text="Video" FontSize="13" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Grid>
                                            <TextBlock Text="Das Video nimmt den ganzen Monitor ein; alles daneben ist verdeckt." Style="{StaticResource HelpText}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Style="{StaticResource FieldGroup}" Margin="0">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="mit Vollbildzone" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                                                <controls:StatusChip State="Good" Text="bleibt in der Zone" />
                                            </StackPanel>
                                            <Grid Height="104" Margin="0,10,0,0">
                                                <Border Background="{DynamicResource MonitorFrameBrush}" CornerRadius="6" />
                                                <Grid Margin="6">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                                    <Rectangle Grid.RowSpan="2" Fill="{DynamicResource ZoneFillBrush}" Opacity="0.35" Stroke="{DynamicResource ZoneBorderBrush}" Margin="0,0,2,0" />
                                                    <Border Grid.Column="1" Background="{DynamicResource DropTargetBrush}" Opacity="0.5" CornerRadius="3" Margin="2,0,0,2" />
                                                    <Rectangle Grid.Column="1" Grid.Row="1" Fill="{DynamicResource ZoneFillBrush}" Opacity="0.35" Stroke="{DynamicResource ZoneBorderBrush}" Margin="2,2,0,0" />
                                                </Grid>
                                                <TextBlock Text="Video" FontSize="12" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,20,34,0" />
                                            </Grid>
                                            <TextBlock Text="Das Video füllt genau seine Zone; daneben bleibt alles sichtbar." Style="{StaticResource HelpText}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <TextBlock Style="{StaticResource HelpText}" Margin="0,14,0,0"
                                           Text="Welche Zone eine Vollbildzone ist, legst du in «Zonen &amp; Layouts» fest – Kästchen «Vollbildzone» in den Werten der Zone. Spiele im echten Exklusivvollbild bleiben davon unberührt." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ========================= Tastenkürzel ========================= -->
            <TabItem x:Name="KeysTab" Header="Tastenkürzel">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="22,28">
                        <Border Style="{StaticResource SectionCard}" Padding="20,6">
                            <StackPanel>
                                <Border Style="{StaticResource SettingRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="Zonenkürzel aktiv" Style="{StaticResource SettingLabel}" />
                                                <Button x:Name="ZoneHotkeysEnabledInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zu Zonenkürzel aktiv"
                                                        ToolTip="Schaltet die Kürzel für Zone weiter, zurück, nach Nummer und vorherige Position gemeinsam ein oder aus. Sie wirken auf das Fenster im Vordergrund und nur, solange das Einrasten aktiv ist. Sinnvoll auszuschalten, wenn ein anderes Programm dieselben Kombinationen braucht. Aus: nur der Not-Aus bleibt registriert." /></StackPanel>
                                            <TextBlock Text="Fenster lassen sich mit der Tastatur in Zonen setzen" Style="{StaticResource HelpText}" />
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,0,0" IsChecked="{Binding Settings.ZoneHotkeysEnabled}" AutomationProperties.Name="Zonenkürzel aktivieren" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingRow}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal"><TextBlock Text="Zusatztasten" Style="{StaticResource SettingLabel}" />
                                                    <Button x:Name="ZoneHotkeyModifiersInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zu Zusatztasten"
                                                            ToolTip="Die Tasten, die du zu Pfeil, Ziffer oder Rücktaste gedrückt hältst. Windows belegt viele Kombinationen mit der Win-Taste selbst; Ctrl + Shift ist deshalb die Voreinstellung. Ctrl + Alt ist nicht zu empfehlen: Windows liefert AltGr intern als Ctrl + Alt, sodass die Zifferkürzel die AltGr-Zeichen derselben Tasten verschlucken. Belegt ein anderes Programm ein Kürzel, meldet die Statuszeile das beim Start." /></StackPanel>
                                                <TextBlock Text="Gilt für alle Kürzel unten" Style="{StaticResource HelpText}" />
                                            </StackPanel>
                                            <ComboBox Grid.Column="1" VerticalAlignment="Top" ItemsSource="{Binding Settings.ZoneHotkeyModifierChoices}" SelectedItem="{Binding Settings.ZoneHotkeyModifiers}" ItemTemplate="{StaticResource EnumItemTemplate}" AutomationProperties.Name="Zusatztasten der Zonenkürzel" />
                                        </Grid>
                                        <Border Style="{StaticResource WarningBox}" Margin="0,10,0,0" Visibility="{Binding Settings.ZoneHotkeyModifiersBlockAltGr, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" FontSize="14" AutomationProperties.Name="Warnung zu Ctrl + Alt"
                                                       Text="Ctrl + Alt blockiert AltGr: Windows erzeugt aus AltGr intern Ctrl + Alt, deshalb verschlucken die Kürzel Ctrl + Alt + 1 bis 9 die AltGr-Zeichen derselben Tasten — auf einer Schweizer Tastatur @, # und |, auf einer deutschen {, [ und ]. Wähle Ctrl + Shift, Alt + Shift oder Ctrl + Win, wenn du diese Zeichen tippst." />
                                        </Border>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SettingRowLast}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="Not-Aus" Style="{StaticResource SettingLabel}" />
                                                <Button x:Name="EmergencyHotkeyInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zum Not-Aus"
                                                        ToolTip="Dieses Kürzel hält das Einrasten sofort an und lässt es genauso wieder anlaufen. Es bleibt registriert, auch wenn die Zonenkürzel ausgeschaltet sind – so kommst du immer aus einer Situation heraus, in der das Programm im Weg ist. «Aus» gibt die Tastenkombination frei; dann hilft nur noch der Infobereich." /></StackPanel>
                                            <TextBlock Text="Hält das Einrasten an, ohne das Programm zu beenden" Style="{StaticResource HelpText}" />
                                        </StackPanel>
                                        <ComboBox x:Name="EmergencyHotkeySelector" Grid.Column="1" VerticalAlignment="Top" ItemsSource="{Binding Settings.EmergencyHotkeys}" SelectedItem="{Binding Settings.EmergencyHotkey}" ItemTemplate="{StaticResource EnumItemTemplate}" AutomationProperties.Name="Tastenkombination des Not-Aus" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionCard}" Padding="20,16">
                            <StackPanel>
                                <TextBlock Text="Was die Kürzel tun" Style="{StaticResource GroupTitle}" Margin="0,0,0,12" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="36" /><RowDefinition Height="36" /><RowDefinition Height="36" /><RowDefinition Height="36" /><RowDefinition Height="36" /></Grid.RowDefinitions>
                                    <Border Grid.Row="0" Style="{StaticResource MonoChip}" HorizontalAlignment="Left"><TextBlock FontFamily="Cascadia Mono" FontSize="14" Text="{Binding Settings.ZoneHotkeyModifierLabel, StringFormat={}{0} + ← / →}" /></Border>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Fenster eine Zone zurück oder weiter, über Monitorgrenzen hinweg." FontSize="15" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <Border Grid.Row="1" Style="{StaticResource MonoChip}" HorizontalAlignment="Left"><TextBlock FontFamily="Cascadia Mono" FontSize="14" Text="{Binding Settings.ZoneHotkeyModifierLabel, StringFormat={}{0} + 1 … 9}" /></Border>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Fenster in die Zone mit dieser Nummer auf seinem Monitor." FontSize="15" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <Border Grid.Row="2" Style="{StaticResource MonoChip}" HorizontalAlignment="Left"><TextBlock FontFamily="Cascadia Mono" FontSize="14" Text="{Binding Settings.ZoneHotkeyModifierLabel, StringFormat={}{0} + ⌫}" /></Border>
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="Fenster zurück an die Stelle vor dem letzten Einrasten." FontSize="15" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <Border Grid.Row="3" Style="{StaticResource MonoChip}" HorizontalAlignment="Left"><TextBlock FontFamily="Cascadia Mono" FontSize="14" Text="{Binding Settings.EmergencyHotkeyLabel}" /></Border>
                                    <TextBlock Grid.Row="3" Grid.Column="2" Text="Not-Aus: Einrasten anhalten und wieder starten." FontSize="15" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <Border Grid.Row="4" Style="{StaticResource MonoChip}" HorizontalAlignment="Left"><TextBlock FontFamily="Cascadia Mono" FontSize="14" Text="Strg + Z / Y" /></Border>
                                    <TextBlock Grid.Row="4" Grid.Column="2" Text="Im Layouteditor: zurücknehmen und wiederherstellen." FontSize="15" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ========================= Aussehen & Start ========================= -->
            <TabItem x:Name="StartupTab" Header="Aussehen &amp; Start" controls:Chrome.Group="PROGRAMM">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="22,28">
                        <Border Style="{StaticResource SectionCard}" Padding="20,6">
                            <StackPanel>
                                <Border Style="{StaticResource SettingRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="Erscheinungsbild" Style="{StaticResource SettingLabel}" />
                                                <Button x:Name="ThemeInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zum Erscheinungsbild"
                                                        ToolTip="Folgt Windows oder ist fest hell oder dunkel. «Windows-System» übernimmt automatisch den App-Modus von Windows und wechselt mit ihm; «Hell» oder «Dunkel» überschreibt diese Wahl nur für Zone Manager." /></StackPanel>
                                            <TextBlock Text="Hell oder dunkel, oder so wie Windows" Style="{StaticResource HelpText}" />
                                        </StackPanel>
                                        <ComboBox x:Name="ThemeSelector" Grid.Column="1" VerticalAlignment="Top" ItemsSource="{Binding Settings.ThemeModes}" SelectedItem="{Binding Settings.ThemeMode}" ItemTemplate="{StaticResource EnumItemTemplate}" SelectionChanged="Theme_SelectionChanged" AutomationProperties.Name="Erscheinungsbild" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Mit Windows starten" Style="{StaticResource SettingLabel}" />
                                                <controls:StatusChip State="{Binding StartupChipState}" Text="{Binding StartupChipText}" />
                                                <Button x:Name="StartWithWindowsInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zu Mit Windows starten"
                                                        ToolTip="Startet das Programm nach der Windows-Anmeldung automatisch, ohne Rückfrage: dafür legt es eine Anmeldeaufgabe der Windows-Aufgabenplanung nur für den aktuellen Benutzer an, die das Programm bereits erhöht startet. Ein Windows-Dienst und ein Treiber werden nicht gebraucht. Lässt sich die Aufgabe nicht anlegen, weicht das Programm auf den Registry-Eintrag aus; dann erscheint die Abfrage bei jeder Anmeldung wieder." /></StackPanel>
                                            <TextBlock Text="{Binding StartupHint}" Style="{StaticResource HelpText}" AutomationProperties.Name="Wirkung des Autostarts" />
                                        </StackPanel>
                                        <CheckBox x:Name="StartWithWindowsCheckBox" Grid.Column="1" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,0,0" IsChecked="{Binding Settings.StartWithWindows}" AutomationProperties.Name="Mit Windows starten" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="Beim Schliessen in den Infobereich" Style="{StaticResource SettingLabel}" />
                                                <Button x:Name="CloseToTrayInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zu Beim Schliessen in den Infobereich"
                                                        ToolTip="Eingeschaltet legt das ✕ das Fenster nur weg; das Programm läuft im Infobereich weiter und rastet Fenster wie gewohnt ein. Ausgeschaltet beendet das ✕ das Programm ganz. Beenden geht in beiden Fällen über das Menü des Infobereichs." /></StackPanel>
                                            <TextBlock Text="Das ✕ beendet das Programm nicht" Style="{StaticResource HelpText}" />
                                        </StackPanel>
                                        <CheckBox x:Name="CloseToTrayCheckBox" Grid.Column="1" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,0,0" IsChecked="{Binding Settings.CloseToTray}" AutomationProperties.Name="Beim Schliessen in den Infobereich" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="Updates" Style="{StaticResource SettingLabel}" />
                                                <Button x:Name="UpdateInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zu Updates"
                                                        ToolTip="Die Suche fragt die Veröffentlichungen des Projekts ab und sendet dabei nichts ausser der Anfrage selbst – keine Version, keine Rechnerkennung, keine Zählung. Sie ist deshalb voreingestellt aus und läuft sonst nur, wenn du sie selbst anstösst. Heruntergeladen wird ausschliesslich aus der Release-Ablage des Projekts über HTTPS und per SHA-256 geprüft; ein Verweis auf eine andere Adresse wird abgelehnt." /></StackPanel>
                                            <TextBlock x:Name="UpdateStatusText" Text="{Binding UpdateSummary}" Style="{StaticResource HelpText}" AutomationProperties.Name="Ergebnis der Updatesuche" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                            <TextBlock Text="beim Start suchen" Style="{StaticResource HelpText}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <CheckBox x:Name="CheckForUpdatesOnStartCheckBox" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Settings.CheckForUpdatesOnStart}" AutomationProperties.Name="Beim Start nach Updates suchen" />
                                            <Button x:Name="CheckForUpdatesButton" Content="Jetzt suchen" Click="CheckForUpdates_Click" Margin="12,0,0,0" IsEnabled="{Binding CanCheckForUpdates}" AutomationProperties.Name="Nach Updates suchen" />
                                            <Button x:Name="InstallUpdateButton" Content="Installieren und neu starten" Style="{StaticResource PrimaryButton}" Click="InstallUpdate_Click" Margin="8,0,0,0"
                                                    IsEnabled="{Binding CanInstallUpdate}" Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    AutomationProperties.Name="Update installieren und neu starten"
                                                    ToolTip="Lädt die neue Programmdatei, legt sie an die Stelle der laufenden und startet das Programm neu. Die bisherige Datei bleibt bis zum nächsten Start als Sicherung daneben liegen." />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingRowLast}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Update-Quelle" Style="{StaticResource SettingLabel}" />
                                                <controls:StatusChip State="{Binding UpdateSourceChipState}" Text="{Binding UpdateSourceChipText}" />
                                                <Button x:Name="UpdateSourceInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zur Update-Quelle"
                                                        ToolTip="Die neuen Fassungen liegen in einem privaten Bereich bei GitHub. Damit Zone Manager sie herunterladen darf, meldest du dich einmalig mit deinem GitHub-Konto an: das Programm zeigt dir einen kurzen Code, den du im Browser bestätigst. Der Zugangsschlüssel liegt danach im Anmeldeinformations-Speicher von Windows, nie in einer Datei und nie im Protokoll." /></StackPanel>
                                            <TextBlock x:Name="UpdateSourceHintText" Text="{Binding UpdateSourceHint}" Style="{StaticResource HelpText}" AutomationProperties.Name="Zustand der Update-Quelle" />
                                        </StackPanel>
                                        <Button x:Name="UpdateSourceButton" Grid.Column="1" Content="{Binding UpdateSourceActionLabel}" Click="UpdateSource_Click" VerticalAlignment="Top"
                                                AutomationProperties.Name="GitHub-Konto verbinden oder trennen" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ========================= Sicherung & Stände ========================= -->
            <TabItem x:Name="BackupTab" Header="Sicherung &amp; Stände">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="22,28">
                        <Border Style="{StaticResource SectionCard}" Padding="20,16">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Sicherung als Datei" Style="{StaticResource GroupTitle}" />
                                        <Button x:Name="BackupInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zur Sicherung als Datei"
                                                ToolTip="Eine JSON-Datei mit allen Layouts, Zuordnungen und Einstellungen. Exportieren schreibt sie, etwa um sie auf einen zweiten Rechner mitzunehmen. Importieren prüft die Datei vollständig, zeigt den Ersetzungsumfang und sichert den bisherigen Stand unmittelbar vor der bestätigten Übernahme." />
                                    </StackPanel>
                                    <TextBlock x:Name="LastExportedTextBlock" Text="{Binding LastExportedText}" Style="{StaticResource HelpText}" AutomationProperties.Name="Zeitpunkt des letzten Exports" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                    <Button x:Name="ExportConfigurationButton" Content="Exportieren" Style="{StaticResource PrimaryButton}" Click="ExportConfiguration_Click" AutomationProperties.Name="Vollständig exportieren" />
                                    <Button x:Name="ImportConfigurationButton" Content="Importieren" Style="{StaticResource PrimaryButton}" Click="ImportConfiguration_Click" Margin="8,0,0,0" AutomationProperties.Name="Vollständig importieren" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SectionCard}" Padding="20,16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Frühere Stände" Style="{StaticResource GroupTitle}" />
                                    <Button x:Name="BackupsInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zu früheren Ständen"
                                            ToolTip="Zone Manager behält automatisch die letzten fünf Stände deiner Einstellungen. Hast du etwas verstellt, holst du hier einen früheren Stand zurück – der aktuelle wird dabei selbst als Stand gesichert, und der Hinweis unten bietet Rückgängig." />
                                </StackPanel>
                                <TextBlock Text="Automatisch gesichert, die letzten fünf" Style="{StaticResource HelpText}" />
                                <ItemsControl x:Name="BackupList" ItemsSource="{Binding Backups}" Margin="0,12,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource FieldGroup}" Padding="12,8" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding WhenText}" FontFamily="Cascadia Mono" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" MinWidth="120" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Summary}" Style="{StaticResource HelpText}" Margin="12,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                    <Button Grid.Column="2" Content="Wiederherstellen" Style="{StaticResource CompactButton}" Click="RestoreBackup_Click" IsEnabled="{Binding CanRestore}"
                                                            AutomationProperties.Name="{Binding WhenText, StringFormat=Stand {0} wiederherstellen}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Noch keine Sicherung vorhanden – sie entsteht beim ersten Speichern einer Änderung." Style="{StaticResource HelpText}"
                                           Visibility="{Binding Backups.Count, Converter={StaticResource ZeroToVisibilityConverter}}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionCard}" Padding="20,16">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Von vorn anfangen" Style="{StaticResource GroupTitle}" />
                                        <Button x:Name="ResetSettingsInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zu Von vorn anfangen"
                                                ToolTip="Stellt Abstände, Darstellung, Verhalten und alle Feinabstimmungen auf die Voreinstellung zurück. Erscheinungsbild, Autostart, Rechte und die Updatesuche bleiben, ebenso Layouts, Zuordnungen und die Liste «In Ruhe lassen». Der Hinweis unten bietet Rückgängig." />
                                    </StackPanel>
                                    <TextBlock Text="Layouts und Zuordnungen bleiben erhalten" Style="{StaticResource HelpText}" />
                                </StackPanel>
                                <Button x:Name="ResetSettingsButton" Grid.Column="1" Content="Alle Einstellungen zurücksetzen" Style="{StaticResource DangerButton}" Click="ResetSettings_Click" VerticalAlignment="Top"
                                        AutomationProperties.Name="Einstellungen auf Voreinstellung zurücksetzen" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ========================= System & Rechte ========================= -->
            <TabItem x:Name="SystemTab" Header="System &amp; Rechte">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="22,28">
                        <Border Style="{StaticResource SectionCard}" Padding="20,6">
                            <StackPanel>
                                <Border Style="{StaticResource SettingRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Administratorrechte" Style="{StaticResource SettingLabel}" />
                                                <controls:StatusChip State="{Binding ElevationChipState}" Text="{Binding ElevationChipText}" />
                                                <Button x:Name="ElevationInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zu Administratorrechten"
                                                        ToolTip="Windows teilt laufende Programme in Vertrauensstufen ein und lässt ein Programm nur Fenster verschieben, die nicht höher berechtigt sind. Für Fenster wie Taskmanager, Registrierungs-Editor oder «als Administrator» gestartete Programme braucht Zone Manager selbst Administratorrechte. «Nur wenn nötig» startet ohne Abfrage und fragt höchstens einmal je Sitzung – und nur, wenn so ein Fenster tatsächlich im Weg war. «Immer beim Start» fragt einmal beim Start, danach nie mehr. Die Umstellung wirkt beim nächsten Start." /></StackPanel>
                                            <TextBlock x:Name="ElevationHintText" Text="{Binding ElevationHint}" Style="{StaticResource HelpText}" AutomationProperties.Name="Wirkung der Rechtelage" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                            <ComboBox x:Name="ElevationModeSelector" ItemsSource="{Binding Settings.ElevationModes}" SelectedItem="{Binding Settings.ElevationMode}" ItemTemplate="{StaticResource EnumItemTemplate}" AutomationProperties.Name="Wann Administratorrechte angefordert werden" />
                                            <Button x:Name="ReleaseElevationButton" Content="Rechte abgeben" Click="ReleaseElevation_Click" Margin="0,8,0,0" HorizontalAlignment="Right"
                                                    Visibility="{Binding CanReleaseElevation, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    AutomationProperties.Name="Ohne Administratorrechte neu starten"
                                                    ToolTip="Startet Zone Manager sofort ohne erhöhte Rechte neu." />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Fensterhelfer ohne Administratorrechte" Style="{StaticResource SettingLabel}" />
                                                <controls:StatusChip State="{Binding HelperChipState}" Text="{Binding HelperChipText}" />
                                                <Button x:Name="CertificateInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zum Fensterhelfer"
                                                        ToolTip="Freiwillig. Lässt Fenster von Programmen mit Administratorrechten einrasten, ohne dass Zone Manager selbst Rechte bekommt. Dafür wird auf diesem Rechner ein eigenes Zertifikat erzeugt, in die Vertrauensspeicher von Windows gelegt und der Hilfsprozess damit signiert. Vor- und Nachteile stehen im Assistenten; Windows fragt dabei einmal nach Administratorrechten." /></StackPanel>
                                            <TextBlock x:Name="CertificateStatusText" Text="{Binding CertificateStatus}" Style="{StaticResource HelpText}" AutomationProperties.Name="Zustand des Zertifikats" />
                                            <TextBlock x:Name="HelperStatusText" Text="{Binding HelperStatus}" Style="{StaticResource HelpText}" Margin="0,2,0,0" AutomationProperties.Name="Zustand des Fensterhelfers" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                            <Button x:Name="HelperWizardButton" Content="{Binding HelperSetupLabel}" Click="HelperWizard_Click" IsEnabled="{Binding CanToggleCertificate}"
                                                    AutomationProperties.Name="Assistent für den Fensterhelfer öffnen" />
                                            <Button x:Name="RemoveCertificateButton" Content="Entfernen" Style="{StaticResource DangerButton}" Click="RemoveCertificate_Click" Margin="8,0,0,0"
                                                    IsEnabled="{Binding CanToggleCertificate}"
                                                    Visibility="{Binding IsCertificateInstalled, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    AutomationProperties.Name="Fensterhelfer und Zertifikat entfernen" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingRowLast}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Vollbildzonen-Treiber" Style="{StaticResource SettingLabel}" />
                                                <controls:StatusChip State="{Binding DisplayDriverChipState}" Text="{Binding DisplayDriverChipText}" />
                                                <Button x:Name="SystemDisplayDriverInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zum Vollbildzonen-Treiber"
                                                        ToolTip="Damit eine Zone als eigener Bildschirm gelten kann, braucht Windows einen zusätzlichen Anzeigetreiber – den «Virtual Display Driver», freie Software, signiert von der SignPath Foundation. Zone Manager hängt den zusätzlichen Bildschirm nur an, solange ein Fenster in einer Vollbildzone liegt. Einrichten und Entfernen fragen einmal nach Administratorrechten." /></StackPanel>
                                            <TextBlock Text="{Binding DisplayDriverHint}" Style="{StaticResource HelpText}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                            <Button x:Name="SystemInstallDisplayDriverButton" Content="Installieren …" Click="InstallDisplayDriver_Click" IsEnabled="{Binding CanInstallDisplayDriver}"
                                                    Visibility="{Binding IsDisplayDriverInstalled, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                                    AutomationProperties.Name="Vollbildzonen-Treiber installieren" />
                                            <Button x:Name="SystemCheckDisplayDriverButton" Content="Prüfen" Click="CheckDisplayDriver_Click"
                                                    Visibility="{Binding IsDisplayDriverInstalled, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    AutomationProperties.Name="Vollbildzonen-Treiber prüfen" />
                                            <Button x:Name="SystemRemoveDisplayDriverButton" Content="Deinstallieren" Style="{StaticResource DangerButton}" Click="RemoveDisplayDriver_Click" Margin="8,0,0,0"
                                                    IsEnabled="{Binding CanRemoveDisplayDriver}"
                                                    Visibility="{Binding IsDisplayDriverInstalled, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    AutomationProperties.Name="Vollbildzonen-Treiber deinstallieren" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionCard}" Padding="20,16">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Diagnose" Style="{StaticResource GroupTitle}" />
                                        <Button x:Name="DiagnosticsInfoButton" Style="{StaticResource InfoButton}" AutomationProperties.Name="Hilfe zur Diagnose"
                                                ToolTip="Der Lauf sieht Monitore, Layouts, Rechte, Tastenkürzel und den Vollbildzonen-Treiber durch und schreibt jedes Ergebnis in die Protokolldatei. Nützlich, wenn etwas nicht so läuft wie erwartet – die Datei lässt sich anschliessend weitergeben." />
                                    </StackPanel>
                                    <TextBlock Text="Prüft, ob alles läuft, und schreibt das Ergebnis auf" Style="{StaticResource HelpText}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                    <Button x:Name="OpenLogButton" Content="Protokoll öffnen" Click="OpenLogFolder_Click" AutomationProperties.Name="Ordner der Protokolldatei öffnen"
                                            ToolTip="{Binding LogFolderPath}" />
                                    <Button x:Name="RunDiagnosticsButton" Content="Diagnose ausführen" Style="{StaticResource PrimaryButton}" Click="RunDiagnostics_Click" Margin="8,0,0,0"
                                            AutomationProperties.Name="Diagnose ausführen" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ========================= Über Zone Manager ========================= -->
            <TabItem x:Name="AboutTab" Header="Über Zone Manager">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="22,28">
                        <Border Style="{StaticResource SectionCard}" Padding="20,16">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Image Width="56" Height="56" Source="/ZoneManager;component/Assets/ZoneManager.Header.png" VerticalAlignment="Top"
                                       RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" />
                                <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                    <TextBlock Text="Zone Manager" Style="{StaticResource SectionTitle}" />
                                    <TextBlock x:Name="AboutVersionText" FontFamily="Cascadia Mono" FontSize="14" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"
                                               AutomationProperties.Name="Version und Anforderungen" />
                                    <TextBlock Text="Von Sascha Krähenbühl Studios · MIT-Lizenz" Style="{StaticResource HelpText}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                    <Button x:Name="ProjectPageButton" Content="Projektseite" Click="OpenProjectPage_Click" AutomationProperties.Name="Projektseite im Browser öffnen" />
                                    <Button x:Name="LicenseButton" Content="Lizenz" Click="OpenLicense_Click" Margin="8,0,0,0" AutomationProperties.Name="Lizenztext im Browser öffnen" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SectionCard}" Padding="20,6">
                            <StackPanel>
                                <Border Style="{StaticResource SettingRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Protokolldatei" Style="{StaticResource SettingLabel}" />
                                            <TextBlock Text="{Binding LogFileSummary}" Style="{StaticResource HelpText}" ToolTip="{Binding LogFolderPath}" AutomationProperties.Name="Grösse der Protokolldatei" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                            <Button x:Name="AboutOpenLogButton" Content="Ordner öffnen" Click="OpenLogFolder_Click" ToolTip="{Binding LogFolderPath}" AutomationProperties.Name="Ordner der Protokolldatei öffnen" />
                                            <Button x:Name="ClearLogButton" Content="Leeren" Style="{StaticResource DangerButton}" Click="ClearLog_Click" Margin="8,0,0,0" AutomationProperties.Name="Protokolldatei leeren" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingRowLast}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Einstellungsdatei" Style="{StaticResource SettingLabel}" />
                                            <TextBlock Text="Hier liegen Layouts, Zuordnungen und Einstellungen" Style="{StaticResource HelpText}" ToolTip="{Binding SettingsFolderPath}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Ordner öffnen" Click="OpenSettingsFolder_Click" VerticalAlignment="Top" ToolTip="{Binding SettingsFolderPath}"
                                                AutomationProperties.Name="Ordner der Einstellungsdatei öffnen" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Rueckgaengig-Toast: unten mittig ueber der Statuszeile, InkBrush-Grund mit CanvasBrush-Text. -->
        <Border x:Name="ToastHost" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,56" Padding="16,10,12,10"
                Background="{DynamicResource InkBrush}" CornerRadius="8" Visibility="{Binding IsToastVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                MouseEnter="Toast_MouseEnter" MouseLeave="Toast_MouseLeave" AutomationProperties.Name="Hinweis mit Rückgängig">
            <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.35" /></Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="ToastText" Text="{Binding ToastText}" Foreground="{DynamicResource CanvasBrush}" FontSize="15" VerticalAlignment="Center" MaxWidth="520" TextTrimming="CharacterEllipsis" />
                <Button x:Name="ToastUndoButton" Content="Rückgängig" Click="ToastUndo_Click" Margin="14,0,0,0" MinHeight="32" Padding="12,2" FontWeight="SemiBold"
                        Background="Transparent" Foreground="{DynamicResource CanvasBrush}" BorderBrush="{DynamicResource CanvasBrush}"
                        Visibility="{Binding CanUndoToast, Converter={StaticResource BooleanToVisibilityConverter}}" AutomationProperties.Name="Letzte Änderung rückgängig machen" />
                <Button x:Name="ToastCloseButton" Content="✕" Click="ToastClose_Click" Margin="6,0,0,0" MinHeight="32" Width="32" Padding="0"
                        Background="Transparent" Foreground="{DynamicResource CanvasBrush}" BorderThickness="0" AutomationProperties.Name="Hinweis schliessen" />
            </StackPanel>
        </Border>

        <!-- Statuszeile: links die letzte Aktion, rechts der Urheber; ein angehaltenes Einrasten erscheint als Warnung. -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border x:Name="PausedBox" Style="{StaticResource WarningBox}" Padding="10,3" Margin="0,0,14,0" VerticalAlignment="Center"
                        Visibility="{Binding IsSnappingPaused, Converter={StaticResource BooleanToVisibilityConverter}}" AutomationProperties.Name="Zustand der Snap-Funktion">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="SnappingStateText" Text="● angehalten" Foreground="{DynamicResource WarningBrush}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" ToolTip="{Binding PauseReason}" />
                        <Button x:Name="ResumeSnappingButton" Content="Einrasten wieder aktivieren" Style="{StaticResource CompactButton}" Click="ResumeSnapping_Click" Margin="12,0,0,0"
                                ToolTip="{Binding PauseReason}" AutomationProperties.Name="Einrasten wieder aktivieren" />
                    </StackPanel>
                </Border>
                <TextBlock x:Name="StatusMessageText" Grid.Column="1" Text="{Binding StatusMessage}" FontSize="14"
                           Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusMessage}"
                           AutomationProperties.Name="Statusmeldung" />
                <TextBlock x:Name="AuthorLabel" Grid.Column="2" Text="Zone Manager von Sascha Krähenbühl Studios"
                           FontSize="13" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="18,0,0,0"
                           AutomationProperties.Name="Urheber des Programms" />
            </Grid>
        </Border>
    </Grid>
</Window>

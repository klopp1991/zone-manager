<Window x:Class="SnapZones.App.Views.ProcessPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Laufendes Programm wählen"
        Width="720" Height="560" MinWidth="520" MinHeight="380"
        FontSize="16"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Border Background="{DynamicResource CanvasBrush}" Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="Laufendes Programm wählen" Style="{StaticResource SectionTitle}" />
            <TextBlock Grid.Row="1"
                       Text="Aufgelistet sind Programme mit sichtbarem Fenster. Bei Programmen, die mit erhöhten Rechten laufen, kann Windows den Pfad nicht preisgeben; dann wird der Programmname übernommen, was für die Regel genügt."
                       Style="{StaticResource HelpText}" Margin="0,6,0,14" />

            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBox x:Name="SearchText" VerticalContentAlignment="Center" TextChanged="Search_TextChanged"
                         AutomationProperties.Name="Programme durchsuchen"
                         ToolTip="Sucht gleichzeitig in Programmname, Pfad und Fenstertitel." />
                <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,12,0,0">
                    <ListBox x:Name="ProcessList" ScrollViewer.VerticalScrollBarVisibility="Auto"
                             MouseDoubleClick="ProcessList_MouseDoubleClick"
                             SelectionChanged="ProcessList_SelectionChanged"
                             AutomationProperties.Name="Laufende Programme">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2,2">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding WindowTitle}" Foreground="{DynamicResource MutedBrush}" FontSize="14"
                                               TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                    <TextBlock Text="{Binding ProcessPath}" Foreground="{DynamicResource SubtleInkBrush}" FontSize="13"
                                               FontFamily="Cascadia Mono" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button x:Name="ConfirmButton" Content="Übernehmen" Click="Confirm_Click" IsDefault="True" IsEnabled="False"
                        Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" MinWidth="140"
                        AutomationProperties.Name="Ausgewähltes Programm übernehmen" />
                <Button Content="Abbrechen" Click="Cancel_Click" IsCancel="True" Margin="0" MinWidth="140"
                        AutomationProperties.Name="Auswahl abbrechen" />
            </StackPanel>
        </Grid>
    </Border>
</Window>

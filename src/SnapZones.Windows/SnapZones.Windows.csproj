<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <UseWPF>true</UseWPF>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SnapZones.Core\SnapZones.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!--
      Der Anzeigetreiber «Virtual Display Driver» (MIT-Lizenz, signiert von der SignPath Foundation)
      reist in der Programmdatei mit und wird bei der Installation in einen Ordner entpackt, weil die
      INF-Datei fuer die Treiberinstallation auf der Platte liegen muss.
    -->
    <EmbeddedResource Include="Drivers\VirtualDisplayDriver\*" LogicalName="VirtualDisplayDriver/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>

<Window x:Class="ZoneManager.App.Services.LayoutChangedToast"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        Width="300"
        Height="72">
    <Border Background="#F2172033" BorderBrush="#50657086" BorderThickness="1" CornerRadius="6" Padding="16">
        <StackPanel>
            <TextBlock Text="Aktives Layout" Foreground="#BFD7DEE8" FontSize="12" />
            <TextBlock x:Name="LayoutNameText" Foreground="White" FontSize="17" FontWeight="SemiBold" />
        </StackPanel>
    </Border>
</Window>
